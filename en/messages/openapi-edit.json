{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Edit message",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages/{messageId}": {
      "put": {
        "summary": "Edit message",
        "description": "Replaces the text of a text message your channel already sent, on channels that allow editing (WhatsApp Web and Telegram). The recipient sees the new text in place of the old one, with the app's edited mark. No new message is sent. See [Edit message](/en/messages/edit-message).",
        "operationId": "editMessage",
        "tags": [
          "Messages"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "The channel that sent the message",
            "schema": {
              "type": "string",
              "example": "YOUR_CHANNEL_ID"
            }
          },
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "description": "The `messageId` returned by the send. The `contents[].identifier` received in the webhook is also accepted",
            "schema": {
              "type": "string",
              "example": "01A0C92D0C957FE98B73C8BA0CACF741"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditMessageRequest"
              },
              "example": {
                "content": {
                  "type": "TEXT",
                  "body": {
                    "message": "Fixed text"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Edit accepted and forwarded to the channel. It does not guarantee the contact's app already shows the new text: if the channel refuses it later, the contact's text does not change and the API sends no notice of that refusal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "messageId": "01A0C92D0C957FE98B73C8BA0CACF741"
                }
              }
            }
          },
          "400": {
            "description": "Missing or empty body, `content.type` other than `TEXT`, or empty `content.body.message`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendError"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "The `messageId` does not exist or does not belong to this channel.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendError"
                }
              }
            }
          },
          "422": {
            "description": "Edit refused. Handle it by `subCode`: `EDIT_NOT_SUPPORTED` (the channel does not allow editing), `CHANNEL_DISCONNECTED` (the channel is disconnected), `MESSAGE_NOT_EDITABLE` (the message is not text, including a media caption, was not sent by your channel, was not yet accepted by the channel, or failed to send) and `EDIT_WINDOW_EXPIRED` (the time during which the channel accepts edits has passed).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendError"
                },
                "examples": {
                  "notSupported": {
                    "summary": "Channel without editing",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "EDIT_NOT_SUPPORTED"
                    }
                  },
                  "channelDisconnected": {
                    "summary": "Channel disconnected",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "CHANNEL_DISCONNECTED"
                    }
                  },
                  "notEditable": {
                    "summary": "Message not editable",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "MESSAGE_NOT_EDITABLE"
                    }
                  },
                  "windowExpired": {
                    "summary": "Edit window expired",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "EDIT_WINDOW_EXPIRED"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Invalid or missing token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": 401,
              "message": "Unauthorized"
            }
          }
        }
      },
      "Forbidden": {
        "description": "IP not on the workspace allow list (see [IP restriction](/en/security/ip-restriction))",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "ip_not_allowed",
              "message": "203.0.113.10 not allowed: this workspace only accepts API calls from the IPs on its allow list. The workspace Owner can add this IP under Administration > Security > IP Restriction in the panel (changes take up to 10 minutes to apply), or call from an allowed IP. See https://developer.omni.z-api.io/en/security/ip-restriction"
            }
          }
        }
      }
    },
    "schemas": {
      "SendError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time of the refusal, in UTC"
          },
          "code": {
            "type": "string",
            "description": "Error category",
            "example": "BUSINESS_RULE_VIOLATION"
          },
          "subCode": {
            "type": "string",
            "description": "Case code. Present only when the case has its own code",
            "example": "CHANNEL_DISCONNECTED"
          },
          "message": {
            "type": "string",
            "description": "Error description. The text may change: handle the error by `code` and `subCode`",
            "example": "Channel is disconnected"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "`messageId` of the edited message"
          }
        }
      },
      "EditMessageRequest": {
        "type": "object",
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "type",
              "body"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Content type. Only text can be edited",
                "enum": [
                  "TEXT"
                ]
              },
              "body": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "New text of the message"
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in the Omni Z-API Security panel"
      }
    }
  }
}
