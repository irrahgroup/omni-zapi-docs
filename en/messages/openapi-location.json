{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Send Location",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages": {
      "post": {
        "summary": "Send location",
        "description": "Sends a location message. Only works when the 24-hour conversation window is open.",
        "operationId": "sendLocationMessage",
        "tags": [
          "Messages"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel ID",
            "schema": {
              "type": "string",
              "example": "YOUR_CHANNEL_ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendLocationRequest"
              },
              "example": {
                "recipient": {
                  "identifier": "5544936181064",
                  "name": "Recipient Name",
                  "subject": "Title",
                  "picture": ""
                },
                "sender": {
                  "identifier": "5544936181064",
                  "name": "Sender Name",
                  "picture": ""
                },
                "content": {
                  "type": "LOCATION",
                  "attachments": [
                    {
                      "name": "Google Brasil",
                      "address": "Av. Brg. Faria Lima, 3477 - Itaim Bibi, São Paulo - SP, 04538-133",
                      "latitude": "-23.0696347",
                      "longitude": "-50.4357913"
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MessageSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/InstanceNotFound"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MessageSuccess": {
        "description": "Message accepted and queued for sending. Delivery is confirmed later, by the webhook status events.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "example": {
              "messageId": "01A0C92D0C957FE98B73C8BA0CACF741"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Request refused before sending: invalid Secret Key, IP outside the allowed list, missing body or a body that does not fit the message type.",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SendError"
                },
                {
                  "$ref": "#/components/schemas/Error"
                }
              ]
            },
            "examples": {
              "authorizationInvalid": {
                "summary": "Invalid or missing Secret Key",
                "value": {
                  "error": "Authorization invalid"
                }
              },
              "ipNotAllowed": {
                "summary": "Source IP outside the allowed IP list",
                "value": {
                  "error": "203.0.113.10 not allowed"
                }
              },
              "payloadRequired": {
                "summary": "Empty body ({})",
                "value": {
                  "error": "message payload is required"
                }
              },
              "validationError": {
                "summary": "Required field missing for the type",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "VALIDATION_ERROR",
                  "message": "Field 'content.attachments': is required for message type LOCATION"
                }
              }
            }
          }
        }
      },
      "InstanceNotFound": {
        "description": "No instance found for the Secret Key sent.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "instanceNotFound": {
                "summary": "Instance not found",
                "value": {
                  "error": "instance not found"
                }
              }
            }
          }
        }
      },
      "Unprocessable": {
        "description": "Sending refused by a rule: channel disconnected, instance not provisioned, inactive subscription, blocked account or a type the channel does not have.",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SendError"
                },
                {
                  "$ref": "#/components/schemas/Error"
                }
              ]
            },
            "examples": {
              "channelDisconnected": {
                "summary": "Channel disconnected: connect the channel again and repeat the request",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "BUSINESS_RULE_VIOLATION",
                  "subCode": "CHANNEL_DISCONNECTED",
                  "message": "Channel is disconnected"
                }
              },
              "unsupportedChannelType": {
                "summary": "Type the channel does not have",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "BUSINESS_RULE_VIOLATION",
                  "message": "[UNSUPPORTED_CHANNEL_TYPE] O canal META_INSTAGRAM nao suporta mensagens do tipo LOCATION"
                }
              },
              "instanceNotProvisioned": {
                "summary": "Instance not provisioned",
                "value": {
                  "error": "instance is not provisioned"
                }
              },
              "subscriptionInactive": {
                "summary": "Instance subscription inactive",
                "value": {
                  "error": "instance subscription is not active"
                }
              },
              "blocked": {
                "summary": "Account blocked",
                "value": {
                  "error": "You are blocked, contact support."
                }
              }
            }
          }
        }
      },
      "BadGateway": {
        "description": "Failure on our side while processing the request. Check the status webhook before retrying: the request may have been accepted.",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SendError"
                },
                {
                  "$ref": "#/components/schemas/Error"
                }
              ]
            },
            "examples": {
              "integrationUnavailable": {
                "summary": "Temporary failure: try again in a few moments",
                "value": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              },
              "sendingFailed": {
                "summary": "Internal failure while processing the request",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "INTEGRATION_ERROR",
                  "message": "Message sending failed"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "SendLocationRequest": {
        "type": "object",
        "required": [
          "recipient",
          "content"
        ],
        "properties": {
          "recipient": {
            "type": "object",
            "required": [
              "identifier"
            ],
            "description": "Recipient data",
            "properties": {
              "identifier": {
                "type": "string",
                "description": "Recipient identifier on the channel: phone number with country and area code on WhatsApp (5511999999999), IGSID on Instagram, PSID on Messenger and chat_id on Telegram",
                "example": "5544936181064"
              },
              "name": {
                "type": "string",
                "description": "Recipient name (optional)",
                "example": "Recipient Name"
              },
              "subject": {
                "type": "string",
                "description": "Title or subject (optional)",
                "example": "Title"
              },
              "picture": {
                "type": "string",
                "description": "Recipient profile picture URL (optional)",
                "example": ""
              }
            }
          },
          "sender": {
            "type": "object",
            "description": "Sender data (optional)",
            "properties": {
              "identifier": {
                "type": "string",
                "description": "Sender phone number",
                "example": "5544936181064"
              },
              "name": {
                "type": "string",
                "description": "Sender name",
                "example": "Sender Name"
              },
              "picture": {
                "type": "string",
                "description": "Sender profile picture URL",
                "example": ""
              }
            }
          },
          "content": {
            "type": "object",
            "required": [
              "type",
              "attachments"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Message type",
                "enum": [
                  "LOCATION"
                ]
              },
              "attachments": {
                "type": "array",
                "description": "List with location data",
                "items": {
                  "type": "object",
                  "properties": {
                    "latitude": {
                      "type": "string",
                      "description": "Location latitude, as text, like the example. Not validated by the API, but required for the pin to display correctly on WhatsApp.",
                      "example": "-23.0696347"
                    },
                    "longitude": {
                      "type": "string",
                      "description": "Location longitude, as text, like the example. Not validated by the API, but required for the pin to display correctly on WhatsApp.",
                      "example": "-50.4357913"
                    },
                    "name": {
                      "type": "string",
                      "description": "Place name (optional)",
                      "example": "Google Brasil"
                    },
                    "address": {
                      "type": "string",
                      "description": "Place address (optional)",
                      "example": "Av. Brg. Faria Lima, 3477 - Itaim Bibi, São Paulo - SP, 04538-133"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "Message ID in Z-API Omni: 32-character uppercase hexadecimal string. It is the same value as message._id in the webhook"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Reason for the refusal"
          },
          "message": {
            "type": "string",
            "description": "Refusal detail, when there is one"
          }
        }
      },
      "SendError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time of the refusal, in UTC"
          },
          "code": {
            "type": "string",
            "description": "Error category",
            "example": "BUSINESS_RULE_VIOLATION"
          },
          "subCode": {
            "type": "string",
            "description": "Case code. Present only when the case has its own code",
            "example": "CHANNEL_DISCONNECTED"
          },
          "message": {
            "type": "string",
            "description": "Error description. The text may change: handle the error by `code` and `subCode`",
            "example": "Channel is disconnected"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in the Z-API Omni Security panel"
      }
    }
  }
}
