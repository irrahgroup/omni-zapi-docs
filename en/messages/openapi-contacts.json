{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Send several contacts",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages": {
      "post": {
        "summary": "Send several contacts",
        "description": "Send several contacts in one message.",
        "operationId": "sendContactArrayMessage",
        "tags": [
          "Messages"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel ID",
            "schema": {
              "type": "string",
              "example": "YOUR_CHANNEL_ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendContactArrayRequest"
              },
              "example": {
                "recipient": {
                  "identifier": "5511999999999"
                },
                "content": {
                  "type": "CONTACT_ARRAY",
                  "attachments": [
                    {
                      "name": "Gutemberg Fernandes",
                      "phones": [
                        "5511888888888"
                      ]
                    },
                    {
                      "name": "Ana Souza",
                      "phones": [
                        "5511777777777",
                        "5511666666666"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MessageSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/SendRefused"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MessageSuccess": {
        "description": "Message sent successfully",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "example": {
              "messageId": "01A0C92D0C957FE98B73C8BA0CACF741"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Invalid or missing token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": 401,
              "message": "Unauthorized"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Body without the required field of the type",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "example": {
              "timestamp": "2026-10-22T14:00:00.123Z",
              "code": "VALIDATION_ERROR",
              "message": "Field 'content.attachments': is required for message type CONTACT_ARRAY"
            }
          }
        }
      },
      "SendRefused": {
        "description": "Channel disconnected, or a type the channel does not accept. The message was not sent.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "examples": {
              "channelDisconnected": {
                "summary": "CHANNEL_DISCONNECTED",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "BUSINESS_RULE_VIOLATION",
                  "subCode": "CHANNEL_DISCONNECTED",
                  "message": "Channel is disconnected"
                }
              },
              "unsupportedChannel": {
                "summary": "UNSUPPORTED_CHANNEL_TYPE",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "BUSINESS_RULE_VIOLATION",
                  "message": "[UNSUPPORTED_CHANNEL_TYPE] O canal META_INSTAGRAM nao suporta mensagens do tipo CONTACT_ARRAY"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "SendContactArrayRequest": {
        "type": "object",
        "required": [
          "recipient",
          "content"
        ],
        "properties": {
          "recipient": {
            "type": "object",
            "required": [
              "identifier"
            ],
            "properties": {
              "identifier": {
                "type": "string",
                "description": "Recipient phone number (country code + area code + number)",
                "example": "5511999999999"
              }
            }
          },
          "content": {
            "type": "object",
            "required": [
              "type",
              "attachments"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Message type",
                "enum": [
                  "CONTACT_ARRAY"
                ]
              },
              "attachments": {
                "type": "array",
                "description": "List of contacts",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Contact name. It is passed on to the channel, which builds the name its own way"
                    },
                    "phones": {
                      "type": "array",
                      "description": "Contact phone numbers",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "Sent message ID — 32-character uppercase hexadecimal string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SendError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time of the refusal, in UTC"
          },
          "code": {
            "type": "string",
            "description": "Error category",
            "example": "BUSINESS_RULE_VIOLATION"
          },
          "subCode": {
            "type": "string",
            "description": "Case code. Present only when the case has its own code",
            "example": "CHANNEL_DISCONNECTED"
          },
          "message": {
            "type": "string",
            "description": "Error description. The text may change: handle the error by `code` and `subCode`",
            "example": "Channel is disconnected"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in the Omni Z-API Security panel"
      }
    }
  }
}
