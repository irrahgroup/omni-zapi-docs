{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Send multi-product",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages": {
      "post": {
        "summary": "Send multi-product",
        "description": "Sends a showcase with catalog products grouped in sections.",
        "operationId": "sendInteractiveMultiProductMessage",
        "tags": [
          "Messages"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel ID",
            "schema": {
              "type": "string",
              "example": "YOUR_CHANNEL_ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendProductListRequest"
              },
              "examples": {
                "productList": {
                  "summary": "Showcase with one section",
                  "value": {
                    "recipient": {
                      "identifier": "5511999999999"
                    },
                    "content": {
                      "type": "INTERACTIVE_MULTI_PRODUCT",
                      "header": {
                        "message": "Seleção da semana"
                      },
                      "body": {
                        "message": "Separamos alguns produtos para você."
                      },
                      "footer": {
                        "message": "Entrega em todo o Brasil"
                      },
                      "action": {
                        "catalogId": "1234567890"
                      },
                      "attachments": [
                        {
                          "title": "Camisetas",
                          "list": [
                            {
                              "id": "SKU-1042"
                            },
                            {
                              "id": "SKU-1043"
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MessageSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "$ref": "#/components/responses/ChannelDisconnected"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MessageSuccess": {
        "description": "Message sent successfully",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "example": {
              "messageId": "01A0C92D0C957FE98B73C8BA0CACF741"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Secret Key missing, malformed or nonexistent (`Authorization invalid`), IP outside the IP list (`<ip> not allowed`) or a body that does not fit the message type (`code` `VALIDATION_ERROR`).",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ErrorText"
                },
                {
                  "$ref": "#/components/schemas/SendError"
                }
              ]
            },
            "examples": {
              "authorization": {
                "summary": "Invalid Secret Key",
                "value": {
                  "error": "Authorization invalid"
                }
              },
              "validation": {
                "summary": "Invalid body",
                "value": {
                  "code": "VALIDATION_ERROR",
                  "message": "Field 'content.body': is required for message type INTERACTIVE_MULTI_PRODUCT"
                }
              }
            }
          }
        }
      },
      "ChannelDisconnected": {
        "description": "Channel disconnected. The message was not sent: connect the channel again and repeat the send.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "example": {
              "timestamp": "2026-10-22T14:00:00.123Z",
              "code": "BUSINESS_RULE_VIOLATION",
              "subCode": "CHANNEL_DISCONNECTED",
              "message": "Channel is disconnected"
            }
          }
        }
      }
    },
    "schemas": {
      "SendProductListRequest": {
        "type": "object",
        "required": [
          "recipient",
          "content"
        ],
        "properties": {
          "recipient": {
            "type": "object",
            "required": [
              "identifier"
            ],
            "properties": {
              "identifier": {
                "type": "string",
                "description": "Recipient phone (country code + area code + number)",
                "example": "5511999999999"
              }
            }
          },
          "content": {
            "type": "object",
            "required": [
              "type",
              "body",
              "action",
              "attachments"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Message type",
                "enum": [
                  "INTERACTIVE_MULTI_PRODUCT"
                ]
              },
              "header": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Header text. Optional"
                  }
                }
              },
              "body": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Message text"
                  }
                },
                "required": [
                  "message"
                ]
              },
              "footer": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Footer text. Optional"
                  }
                }
              },
              "action": {
                "type": "object",
                "properties": {
                  "catalogId": {
                    "type": "string",
                    "description": "Catalog ID"
                  }
                },
                "required": [
                  "catalogId"
                ]
              },
              "attachments": {
                "type": "array",
                "description": "Showcase sections",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "description": "Section title"
                    },
                    "list": {
                      "type": "array",
                      "description": "Section products",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Product ID (SKU) in the catalog"
                          }
                        },
                        "required": [
                          "id"
                        ]
                      }
                    }
                  },
                  "required": [
                    "title",
                    "list"
                  ]
                }
              }
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "ID of the sent message: 32 uppercase hexadecimal characters"
          }
        }
      },
      "ErrorText": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error text"
          }
        }
      },
      "SendError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time of the refusal, in UTC"
          },
          "code": {
            "type": "string",
            "description": "Error category",
            "example": "BUSINESS_RULE_VIOLATION"
          },
          "subCode": {
            "type": "string",
            "description": "Case code. Only present when the case has its own code",
            "example": "CHANNEL_DISCONNECTED"
          },
          "message": {
            "type": "string",
            "description": "Error description. The text may change: handle the error by `code` and `subCode`",
            "example": "Channel is disconnected"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in the Z-API Omni Security panel"
      }
    }
  }
}
