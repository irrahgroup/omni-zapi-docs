{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - SDK origins",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "publicKey": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/sdk-info": {
      "get": {
        "summary": "SDK origins",
        "description": "Returns what the connection SDK needs to open the channel flow: the channel type, the Meta app in use and the allowed origins. Authenticated with the **Public Key** in the `Authorization` header, so it can be called from the frontend.",
        "operationId": "getSdkInfo",
        "tags": [
          "Channels"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel ID (from Create channel or List channels)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SDK data for the channel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SdkInfo"
                },
                "example": {
                  "middleware": "META_WHATSAPP",
                  "appId": "1234567890123456",
                  "appConfig": "987654321098765",
                  "allowOrigins": [
                    "https://app.suaempresa.com",
                    "http://localhost:3000",
                    "https://app.hubmessage.io",
                    "https://app.omni.z-api.io"
                  ],
                  "appCustom": false,
                  "appInstagramId": null
                }
              }
            }
          },
          "400": {
            "description": "Public Key missing, malformed or unknown",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Invalid Public Key",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Channel does not exist or belongs to another workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "instanceNotFound": {
                    "summary": "Channel not found",
                    "value": {
                      "error": "Instance not found"
                    }
                  },
                  "appConfigurationNotFound": {
                    "summary": "App not configured",
                    "value": {
                      "error": "app configuration not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error reason"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable error code"
          },
          "message": {
            "type": "string",
            "description": "Error text, in English"
          }
        }
      },
      "SdkInfo": {
        "type": "object",
        "properties": {
          "middleware": {
            "type": "string",
            "description": "Channel type",
            "enum": [
              "META_WHATSAPP",
              "Z_API_WHATSAPP",
              "META_INSTAGRAM",
              "META_MESSENGER",
              "BOT_TELEGRAM"
            ]
          },
          "appId": {
            "type": "string",
            "description": "ID of the Meta app the SDK uses"
          },
          "appConfig": {
            "type": "string",
            "description": "Configuration of the Meta app the SDK uses"
          },
          "allowOrigins": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Origins allowed for the SDK: first the workspace ones, then the dashboard ones (`https://app.hubmessage.io` and `https://app.omni.z-api.io`)"
          },
          "appCustom": {
            "type": "boolean",
            "description": "`true` when the workspace uses its own app"
          },
          "appInstagramId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Instagram app ID"
          }
        }
      }
    },
    "securitySchemes": {
      "publicKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Public Key generated in Security, on the Z-API Omni dashboard, sent in the `Authorization` header."
      }
    }
  }
}
