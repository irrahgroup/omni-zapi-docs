{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Get WhatsApp Web status",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/zapi/status": {
      "get": {
        "summary": "Get WhatsApp Web status",
        "description": "Checks whether the QR code of a `Z_API_WHATSAPP` (WhatsApp Web) channel was scanned and the number is connected. Always call it from the backend. See [WhatsApp Web status and device](/en/channels/whatsapp-web-status).",
        "operationId": "getWhatsAppWebStatus",
        "tags": [
          "Channels"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "`Z_API_WHATSAPP` channel ID",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Connection status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhatsAppWebStatusResponse"
                },
                "example": {
                  "connected": true,
                  "session": true,
                  "created": 1764064800000,
                  "error": "",
                  "smartphoneConnected": true
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Channel does not exist or belongs to another workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "422": {
            "description": "The provider refused the request. The `error` field carries the provider envelope, with the error name in `error.errors[0].name`, or, without an envelope, a generic text.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ProviderError"
                    },
                    {
                      "type": "object",
                      "required": [
                        "error"
                      ],
                      "properties": {
                        "error": {
                          "type": "string",
                          "description": "Generic text, when the provider refusal comes without an envelope",
                          "example": "The operation could not be completed right now. Try again in a few moments."
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "502": {
            "description": "Internal service unavailable. Try again in a few moments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Secret Key rejected. See the reasons in Authentication.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "example": "Bearer"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Authorization invalid",
              "message": "Authorization invalid: this Secret Key does not exist or is no longer valid. Copy the current Secret Key under Security in the panel and send it as \"Authorization: Bearer <secret-key>\". See https://developer.omni.z-api.io/en/authentication"
            }
          }
        }
      },
      "Forbidden": {
        "description": "IP not on the workspace allow list (see [IP restriction](/en/security/ip-restriction))",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "ip_not_allowed",
              "message": "203.0.113.10 not allowed: this workspace only accepts API calls from the IPs on its allow list. The workspace Owner can add this IP under Administration > Security > IP Restriction in the panel (changes take up to 10 minutes to apply), or call from an allowed IP. See https://developer.omni.z-api.io/en/security/ip-restriction"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ProviderError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "description": "Provider error envelope",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "WhatsAppWebStatusResponse": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean",
            "description": "`true` when the QR code was scanned and the number is connected"
          },
          "session": {
            "type": "boolean",
            "description": "Whether a WhatsApp Web session exists"
          },
          "created": {
            "type": [
              "number",
              "null"
            ],
            "description": "When the session was created, if there is one"
          },
          "error": {
            "type": "string",
            "description": "Error text, if any"
          },
          "smartphoneConnected": {
            "type": "boolean",
            "description": "Whether the number's phone is connected"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in the Omni Z-API Security panel"
      }
    }
  }
}
