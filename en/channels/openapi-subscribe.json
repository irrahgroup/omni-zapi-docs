{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Subscribe channel",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/subscribe": {
      "get": {
        "summary": "Subscribe channel",
        "description": "Adds the channel to the account subscription. When there is a payment to make, the response has the checkout `url`; when the subscription is updated without checkout, the response has `type` `SUBSCRIPTION_UPDATED`. Requires the ENTERPRISE role.",
        "operationId": "subscribeChannel",
        "tags": [
          "Channels"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel ID (from Create channel or List channels)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          },
          {
            "name": "redirectUrl",
            "in": "query",
            "required": false,
            "description": "URL the checkout returns to after the payment",
            "schema": {
              "type": "string",
              "format": "uri",
              "example": "https://app.suaempresa.com/canais"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Subscription updated or checkout created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscribeResponse"
                },
                "examples": {
                  "subscriptionUpdated": {
                    "summary": "Subscription updated without checkout",
                    "value": {
                      "type": "SUBSCRIPTION_UPDATED",
                      "message": "Channel active. A prorated charge will be added to the next invoice."
                    }
                  },
                  "checkout": {
                    "summary": "Payment to make",
                    "value": {
                      "checkoutId": "cs_a1B2c3D4e5F6",
                      "url": "https://checkout.stripe.com/c/pay/cs_a1B2c3D4e5F6"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Secret Key missing, malformed or unknown, IP outside the allowed IP list, or invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Invalid Secret Key",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP outside the list",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Channel does not exist or belongs to another workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "422": {
            "description": "Account without the ENTERPRISE role, or billing rule violated (`CREDIT_LIMIT_EXCEEDED`: account credit limit reached; `SUBSCRIPTION_TERMINATED`: subscription terminated, channels cannot be added). In billing errors, the code comes in `error.type`.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/BusinessError"
                    }
                  ]
                },
                "examples": {
                  "enterpriseRequired": {
                    "summary": "Account without the ENTERPRISE role",
                    "value": {
                      "error": "Channel subscription requires ENTERPRISE role"
                    }
                  },
                  "creditLimit": {
                    "summary": "Credit limit reached",
                    "value": {
                      "error": {
                        "type": "CREDIT_LIMIT_EXCEEDED"
                      }
                    }
                  },
                  "terminated": {
                    "summary": "Subscription terminated",
                    "value": {
                      "error": {
                        "type": "SUBSCRIPTION_TERMINATED"
                      }
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Integration failure. The operation was not completed; try again in a few moments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error reason"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable error code"
          },
          "message": {
            "type": "string",
            "description": "Error text, in English"
          }
        }
      },
      "SubscribeResponse": {
        "type": "object",
        "properties": {
          "checkoutId": {
            "type": "string",
            "description": "Checkout ID, when there is a payment to make"
          },
          "url": {
            "type": "string",
            "description": "Checkout URL to complete the payment, when there is a payment to make"
          },
          "type": {
            "type": "string",
            "description": "`SUBSCRIPTION_UPDATED` when the subscription was updated without checkout",
            "example": "SUBSCRIPTION_UPDATED"
          },
          "message": {
            "type": "string",
            "description": "Informative message to show the user"
          }
        }
      },
      "BusinessError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Business error code"
              },
              "message": {
                "type": "string",
                "description": "Error description"
              },
              "details": {
                "description": "Additional details, when present"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in Security, on the Z-API Omni dashboard. The `Bearer` prefix is optional."
      }
    }
  }
}
