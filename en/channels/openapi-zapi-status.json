{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - WhatsApp Web status",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/zapi/status": {
      "get": {
        "summary": "Get WhatsApp Web status",
        "description": "Tells whether the `Z_API_WHATSAPP` channel is connected and whether the phone is online. Does not require ENTERPRISE.",
        "operationId": "zapiStatus",
        "tags": [
          "Channels"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel ID (from Create channel or List channels)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZapiStatus"
                },
                "example": {
                  "connected": true,
                  "session": true,
                  "created": 1762790400000,
                  "error": null,
                  "smartphoneConnected": true
                }
              }
            }
          },
          "400": {
            "description": "Secret Key missing, malformed or unknown, IP outside the allowed IP list, or invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Invalid Secret Key",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP outside the list",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Channel does not exist or belongs to another workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "502": {
            "description": "Integration failure. The operation was not completed; try again in a few moments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error reason"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable error code"
          },
          "message": {
            "type": "string",
            "description": "Error text, in English"
          }
        }
      },
      "ZapiStatus": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean",
            "description": "`true` when the number is connected to the channel"
          },
          "smartphoneConnected": {
            "type": "boolean",
            "description": "`true` when the number's phone is online"
          },
          "session": {
            "type": "boolean",
            "description": "Informative"
          },
          "created": {
            "type": "integer",
            "format": "int64",
            "description": "Informative"
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Informative"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in Security, on the Z-API Omni dashboard. The `Bearer` prefix is optional."
      }
    }
  }
}
