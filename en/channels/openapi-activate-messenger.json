{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Activate Messenger channel",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/activate-messenger": {
      "post": {
        "summary": "Activate Messenger channel",
        "description": "Activates a **META_MESSENGER** channel with the `code` and `redirectUri` returned by the `@omnizapi/connect` SDK. Always call it from the backend. Set your HTTP client timeout above 60 seconds: the API only starts a new activation step within 50 seconds, but a step that has already started runs to the end, and the gateway ends the request at 60 seconds. See [Activate channel](/en/channels/activate-channel).",
        "operationId": "activateMessengerChannel",
        "tags": [
          "Channels"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "`META_MESSENGER` channel ID",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivateMessengerRequest"
              },
              "example": {
                "code": "CODE_FROM_SDK",
                "redirectUri": "REDIRECT_URI_FROM_SDK",
                "pageId": "102938475601234"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Channel activated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivateMessengerResponse"
                },
                "example": {
                  "pageId": "102938475601234",
                  "connected": true,
                  "pageName": "My Store",
                  "pageCategory": "Shopping & retail",
                  "displayName": "My Store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Channel does not exist or belongs to another workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "422": {
            "description": "The provider refused the activation, or the channel type does not match the route. With more than one page and no `pageId`, the API responds `422`; a `pageId` that is not among the account's pages is also refused. If the channel is already active at the provider, `error` is `MESSENGER_META_IS_ALREADY_ACTIVATED`. Usually the `error` field carries the provider envelope, with the error name in `error.errors[0].name`; when the provider refuses without that envelope, it comes as a generic text.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ProviderError"
                    },
                    {
                      "type": "object",
                      "required": [
                        "error"
                      ],
                      "properties": {
                        "error": {
                          "type": "string",
                          "description": "Generic text, when the provider refusal comes without an envelope",
                          "example": "The operation could not be completed right now. Try again in a few moments."
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "502": {
            "description": "Internal service unavailable. Try again in a few moments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          },
          "504": {
            "description": "The activation took too long (`integration_timeout`): you can repeat the call. Or the activation did not finish in time and may still be completed (`outcome_unknown`): check the result before trying again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "timeout": {
                    "summary": "The activation took too long",
                    "value": {
                      "error": "integration_timeout"
                    }
                  },
                  "outcomeUnknown": {
                    "summary": "Unknown outcome",
                    "value": {
                      "error": "outcome_unknown"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Secret Key rejected. See the reasons in Authentication.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "example": "Bearer"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Authorization invalid",
              "message": "Authorization invalid: this Secret Key does not exist or is no longer valid. Copy the current Secret Key under Security in the panel and send it as \"Authorization: Bearer <secret-key>\". See https://developer.omni.z-api.io/en/authentication"
            }
          }
        }
      },
      "Forbidden": {
        "description": "IP not on the workspace allow list (see [IP restriction](/en/security/ip-restriction))",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "ip_not_allowed",
              "message": "203.0.113.10 not allowed: this workspace only accepts API calls from the IPs on its allow list. The workspace Owner can add this IP under Administration > Security > IP Restriction in the panel (changes take up to 10 minutes to apply), or call from an allowed IP. See https://developer.omni.z-api.io/en/security/ip-restriction"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ProviderError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "description": "Provider error envelope",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ActivateMessengerRequest": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "`code` returned by the SDK"
          },
          "redirectUri": {
            "type": "string",
            "description": "`redirectUri` returned by the SDK"
          },
          "pageId": {
            "type": "string",
            "description": "Page to link. Required when the user administers more than one page. It comes from the SDK, when the user administers a single page, or from the `list-messenger-pages` page list, when they pick one among several."
          }
        }
      },
      "ActivateMessengerResponse": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string"
          },
          "connected": {
            "type": "boolean"
          },
          "pageName": {
            "type": "string"
          },
          "pageCategory": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in the Omni Z-API Security panel"
      }
    }
  }
}
