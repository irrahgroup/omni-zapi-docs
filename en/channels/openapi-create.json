{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Create channel",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels": {
      "post": {
        "summary": "Create channel",
        "description": "Creates a new channel in the workspace of the Secret Key. The channel starts in `TRIAL` for 2 days; to keep it, subscribe with Subscribe channel. Accepts only the Secret Key. Requires the ENTERPRISE role.",
        "operationId": "createChannel",
        "tags": [
          "Channels"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChannelRequest"
              },
              "example": {
                "name": "Meu canal WhatsApp",
                "type": "META_WHATSAPP"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Channel created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateChannelResponse"
                },
                "example": {
                  "id": "019E4C54B1B375A28970B605CA9B03C3",
                  "token": "F1B29C3D4E5A6B7C8D9E0F1A2B3C4D5E"
                }
              }
            }
          },
          "400": {
            "description": "Secret Key missing, malformed or unknown, IP outside the allowed IP list, or invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Invalid Secret Key",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP outside the list",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  },
                  "typeRequired": {
                    "summary": "Missing type",
                    "value": {
                      "error": "type is required"
                    }
                  },
                  "bodyMissing": {
                    "summary": "type outside the list or invalid JSON",
                    "value": {
                      "error": "Required request body is missing"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Name already used by another active channel in the workspace. The comparison ignores case and leading or trailing spaces; accents and inner spaces make names different. Recognize it by the `error` field, which is stable; `message` is always in English.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "channel_name_in_use",
                  "message": "A channel with this name already exists in this workspace. Pick another one."
                }
              }
            }
          },
          "422": {
            "description": "Channel type not enabled for the workspace, or account without the ENTERPRISE role",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErrorWithMessage"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                },
                "examples": {
                  "channelTypeNotEnabled": {
                    "summary": "WhatsApp Web not enabled",
                    "value": {
                      "error": "channel_type_not_enabled",
                      "message": "Z_API_WHATSAPP channel is not enabled for this workspace. Contact support."
                    }
                  },
                  "enterpriseRequired": {
                    "summary": "Account without the ENTERPRISE role",
                    "value": {
                      "error": "Channel creation requires ENTERPRISE role"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Integration failure. The operation was not completed; try again in a few moments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          },
          "504": {
            "description": "The creation did not answer in time. Before retrying, check in List channels whether the channel was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error reason"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable error code"
          },
          "message": {
            "type": "string",
            "description": "Error text, in English"
          }
        }
      },
      "CreateChannelRequest": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Channel name, unique among the active channels of the workspace"
          },
          "type": {
            "type": "string",
            "description": "Channel type (platform)",
            "enum": [
              "META_WHATSAPP",
              "Z_API_WHATSAPP",
              "META_INSTAGRAM",
              "META_MESSENGER",
              "BOT_TELEGRAM"
            ]
          }
        }
      },
      "CreateChannelResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID of the created channel (channelId)"
          },
          "token": {
            "type": "string",
            "description": "Channel token, the same one returned by `GET /v1/channels/{channelId}`. The token identifies the channel on the routes in the Z-API format, with the token in the path. The routes in this reference use the Secret Key in the Authorization header."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in Security, on the Z-API Omni dashboard. The `Bearer` prefix is optional."
      }
    }
  }
}
