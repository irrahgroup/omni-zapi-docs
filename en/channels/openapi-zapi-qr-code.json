{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - WhatsApp Web QR Code",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/zapi/qr-code/image": {
      "get": {
        "summary": "Get QR Code",
        "description": "Returns the connection QR Code of a `Z_API_WHATSAPP` channel as a base64 image, ready to display. Call it from your backend, with the Secret Key. Does not require ENTERPRISE.",
        "operationId": "zapiQrCodeImage",
        "tags": [
          "Channels"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel ID (from Create channel or List channels)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "QR Code, or indication that the number is already connected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QrCode"
                },
                "example": {
                  "qrcode": "<QR Code image in base64>",
                  "connected": false
                }
              }
            }
          },
          "400": {
            "description": "Secret Key missing, malformed or unknown, IP outside the allowed IP list, or invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Invalid Secret Key",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP outside the list",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Channel does not exist or belongs to another workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "422": {
            "description": "WhatsApp Web is not enabled for the workspace. Contact support.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "channel_type_not_enabled",
                  "message": "Z_API_WHATSAPP channel is not enabled for this workspace. Contact support."
                }
              }
            }
          },
          "502": {
            "description": "Integration failure. The operation was not completed; try again in a few moments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    },
    "/v1/channels/{channelId}/zapi/qr-code": {
      "get": {
        "summary": "Get QR Code",
        "description": "Returns the value of the connection QR Code of a `Z_API_WHATSAPP` channel, so you can render the image yourself. Call it from your backend, with the Secret Key. Does not require ENTERPRISE.",
        "operationId": "zapiQrCode",
        "tags": [
          "Channels"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel ID (from Create channel or List channels)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "QR Code, or indication that the number is already connected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QrCode"
                },
                "example": {
                  "qrcode": "<QR Code value>",
                  "connected": false
                }
              }
            }
          },
          "400": {
            "description": "Secret Key missing, malformed or unknown, IP outside the allowed IP list, or invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Invalid Secret Key",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP outside the list",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Channel does not exist or belongs to another workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "422": {
            "description": "WhatsApp Web is not enabled for the workspace. Contact support.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "channel_type_not_enabled",
                  "message": "Z_API_WHATSAPP channel is not enabled for this workspace. Contact support."
                }
              }
            }
          },
          "502": {
            "description": "Integration failure. The operation was not completed; try again in a few moments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error reason"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable error code"
          },
          "message": {
            "type": "string",
            "description": "Error text, in English"
          }
        }
      },
      "QrCode": {
        "type": "object",
        "properties": {
          "qrcode": {
            "type": "string",
            "description": "QR Code for the user to scan. Not present when the number is already connected."
          },
          "connected": {
            "type": "boolean",
            "description": "`true` when the number is already connected"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in Security, on the Z-API Omni dashboard. The `Bearer` prefix is optional."
      }
    }
  }
}
