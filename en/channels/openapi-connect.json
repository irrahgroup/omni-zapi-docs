{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Connect Meta WhatsApp channel",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/connect": {
      "post": {
        "summary": "Connect Meta WhatsApp channel",
        "description": "Finishes the connection of a `META_WHATSAPP` channel with the data returned by the `@omnizapi/connect` SDK. It is exclusive to the Official WhatsApp: the other channels have their own route. Does not require ENTERPRISE.",
        "operationId": "connectMetaChannel",
        "tags": [
          "Channels"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel ID (from Create channel or List channels)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectChannelRequest"
              },
              "example": {
                "wabaId": "428083093730937",
                "phoneId": "123456789012345",
                "code": "ABC123DEF456",
                "coexistence": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connection result. `success` has the same value as `connected`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectChannelResponse"
                },
                "example": {
                  "phoneId": "123456789012345",
                  "connected": true,
                  "success": true,
                  "isCoexistence": false,
                  "phoneConnected": "5511999999999",
                  "businessName": "Minha Empresa"
                }
              }
            }
          },
          "400": {
            "description": "Secret Key missing, malformed or unknown, IP outside the allowed IP list, or invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Invalid Secret Key",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP outside the list",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  },
                  "wabaIdRequired": {
                    "summary": "Missing wabaId",
                    "value": {
                      "error": "wabaId is required"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Channel does not exist or belongs to another workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "409": {
            "description": "The same number is already connected and working on Meta. The API refuses and does not spend the `code`. To renew the connection of the same number, disconnect first with `PUT /v1/channels/{channelId}/disconnect`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "channel_already_connected",
                  "message": "Channel already connected"
                }
              }
            }
          },
          "502": {
            "description": "Integration failure. The operation was not completed; try again in a few moments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          },
          "504": {
            "description": "The connection went past the time limit and the result is not known. Check the channel state with Get channel before retrying.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "outcome_unknown"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error reason"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable error code"
          },
          "message": {
            "type": "string",
            "description": "Error text, in English"
          }
        }
      },
      "ConnectChannelRequest": {
        "type": "object",
        "required": [
          "wabaId"
        ],
        "properties": {
          "wabaId": {
            "type": "string",
            "description": "ID of the WhatsApp Business Account (WABA) chosen in the Embedded Signup. It is the only field validated by the API."
          },
          "phoneId": {
            "type": "string",
            "description": "ID of the chosen number. Needed to complete the connection."
          },
          "code": {
            "type": "string",
            "description": "Authorization code returned by Meta. Needed to complete the connection."
          },
          "coexistence": {
            "type": "boolean",
            "description": "Whether the number was connected in coexistence with the WhatsApp Business app"
          }
        }
      },
      "ConnectChannelResponse": {
        "type": "object",
        "properties": {
          "phoneId": {
            "type": "string",
            "description": "ID of the connected number"
          },
          "connected": {
            "type": "boolean",
            "description": "Whether the channel was connected"
          },
          "success": {
            "type": "boolean",
            "description": "Same value as `connected`"
          },
          "isCoexistence": {
            "type": "boolean",
            "description": "Whether the connection is in coexistence"
          },
          "phoneConnected": {
            "type": "string",
            "description": "Connected number, with country code"
          },
          "businessName": {
            "type": "string",
            "description": "Business name on Meta"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in Security, on the Z-API Omni dashboard. The `Bearer` prefix is optional."
      }
    }
  }
}
