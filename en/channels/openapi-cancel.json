{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Partner: Cancel Subscription",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/cancel": {
      "delete": {
        "summary": "Cancel subscription (Partner)",
        "description": "Requests cancellation of the channel subscription. The channel enters `CANCELLATION_PROCESS` and remains active until the end of the paid period. Requires ENTERPRISE role.",
        "operationId": "partnerCancelSubscription",
        "tags": [
          "Partners"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel ID (obtained via Create channel)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          },
          {
            "name": "cancel",
            "in": "query",
            "required": true,
            "description": "Must be `true` to confirm the cancellation",
            "schema": {
              "type": "boolean",
              "example": true
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRequest"
              },
              "examples": {
                "withReason": {
                  "summary": "With cancellation reason",
                  "value": {
                    "cancelReason": "Customer closed the company"
                  }
                }
              }
            }
          },
          "description": "Required. To cancel without a reason, send `{}`."
        },
        "responses": {
          "204": {
            "description": "Cancellation requested successfully. No content returned."
          },
          "400": {
            "description": "Missing body or missing `cancel` parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "missingBody": {
                    "summary": "No body",
                    "value": {
                      "error": "Required request body is missing"
                    }
                  },
                  "missingCancel": {
                    "summary": "Without the `cancel` parameter",
                    "value": {
                      "error": "Required parameter 'cancel' is missing"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Channel does not exist or belongs to another workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "403": {
            "description": "Account without the ENTERPRISE role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "planRequired": {
                    "value": {
                      "error": "plan_required",
                      "message": "Channel subscription requires ENTERPRISE role: managing channel subscriptions through the API is limited to partner accounts with the ENTERPRISE role. Ask support to enable the role, or manage the subscription in the panel at https://app.omni.z-api.io. See https://developer.omni.z-api.io/en/channels/introduction"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Secret Key rejected. See the reasons in Authentication.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "example": "Bearer"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Authorization invalid",
              "message": "Authorization invalid: this Secret Key does not exist or is no longer valid. Copy the current Secret Key under Security in the panel and send it as \"Authorization: Bearer <secret-key>\". See https://developer.omni.z-api.io/en/authentication"
            }
          }
        }
      }
    },
    "schemas": {
      "CancelRequest": {
        "type": "object",
        "properties": {
          "cancelReason": {
            "type": "string",
            "description": "Cancellation reason (optional, but recommended for auditing)",
            "example": "Customer closed the company"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in the Omni Z-API Security panel"
      }
    }
  }
}
