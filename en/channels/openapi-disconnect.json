{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Disconnect Meta WhatsApp channel",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/disconnect": {
      "put": {
        "summary": "Disconnect Meta WhatsApp channel",
        "description": "Disconnects a `META_WHATSAPP` channel from the WhatsApp Official API and clears the connection data (WABA, phone ID, connected number and coexistence). Does not require ENTERPRISE.",
        "operationId": "disconnectMetaChannel",
        "tags": [
          "Channels"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel ID (from Create channel or List channels)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "With `true`, the channel is disconnected and the connection data is cleared. With `false`, nothing changes on the channel.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                },
                "example": true
              }
            }
          },
          "400": {
            "description": "Secret Key missing, malformed or unknown, IP outside the allowed IP list, or invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Invalid Secret Key",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP outside the list",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Call made with the OAuth token of a connected app or the MCP. This route is not open to OAuth: use the Secret Key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "insufficient_scope"
                }
              }
            }
          },
          "404": {
            "description": "Channel does not exist or belongs to another workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "502": {
            "description": "Integration failure. The operation was not completed; try again in a few moments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error reason"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable error code"
          },
          "message": {
            "type": "string",
            "description": "Error text, in English"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in Security, on the Z-API Omni dashboard. The `Bearer` prefix is optional."
      }
    }
  }
}
