{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Z-API Compatibility",
    "description": "Z-API compatible API to facilitate migration to Omni Z-API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://zapi.omni.z-api.io/channels/{channel_id}/token/{channel_token}",
      "variables": {
        "channel_id": {
          "description": "Channel ID (equivalent to Z-API instance_id)",
          "default": "YOUR_CHANNEL"
        },
        "channel_token": {
          "description": "Channel token (equivalent to Z-API token)",
          "default": "YOUR_TOKEN"
        }
      }
    }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/send-text": {
      "post": {
        "summary": "Send text",
        "description": "Sends a plain text message. Supports WhatsApp formatting, emojis and line breaks (`\\n`, `\\r`, `\\r\\n` or `%0a`).",
        "operationId": "sendText",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendTextRequest" },
              "example": {
                "phone": "5511999999999",
                "message": "Welcome to *Omni Z-API*!"
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/NotMetaWhatsapp" }
        }
      }
    },
    "/send-image": {
      "post": {
        "summary": "Send image",
        "description": "Sends a message with an image. Accepts URL or Base64 (with `data:image/png;base64,` prefix).",
        "operationId": "sendImage",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendImageRequest" },
              "examples": {
                "url": {
                  "summary": "Send by URL",
                  "value": {
                    "phone": "5511999999999",
                    "image": "https://example.com/image.png",
                    "caption": "Check out this image!",
                    "viewOnce": false
                  }
                },
                "base64": {
                  "summary": "Send by Base64",
                  "value": {
                    "phone": "5511999999999",
                    "image": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAyAAAAMg...",
                    "caption": "Check out this image!",
                    "viewOnce": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/NotMetaWhatsapp" }
        }
      }
    },
    "/send-link": {
      "post": {
        "summary": "Send link",
        "description": "Sends a message with link preview (image, title and description).",
        "operationId": "sendLink",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendLinkRequest" },
              "example": {
                "phone": "5511999999999",
                "message": "Check out our website: https://www.omni.z-api.io",
                "image": "https://www.omni.z-api.io/logo.png",
                "linkUrl": "https://www.omni.z-api.io",
                "title": "Omni Z-API",
                "linkDescription": "Omnichannel API for Business Communication"
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/NotMetaWhatsapp" }
        }
      }
    },
    "/send-button-actions": {
      "post": {
        "summary": "Send action buttons",
        "description": "Sends a text message with action buttons: one URL button or up to three REPLY buttons, never both in the same message. The CALL button and the copy code button are not accepted. It works on Official WhatsApp channels and on WhatsApp Web channels, with WhatsApp Web enabled in the workspace, with the same rules.",
        "operationId": "sendButtonActions",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendButtonActionsRequest" },
              "examples": {
                "url": {
                  "summary": "URL button",
                  "value": {
                    "phone": "5511999999999",
                    "message": "Hello! How can we help?",
                    "title": "Omni Z-API",
                    "footer": "Choose an option",
                    "buttonActions": [
                      { "id": "1", "type": "URL", "url": "https://www.omni.z-api.io", "label": "Visit our website" }
                    ]
                  }
                },
                "reply": {
                  "summary": "Quick reply button",
                  "value": {
                    "phone": "5511999999999",
                    "message": "Need help?",
                    "buttonActions": [
                      { "id": "3", "type": "REPLY", "label": "Talk to an agent" }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "400": {
            "description": "`image` that is neither an http or https URL nor base64. It is checked before the button rules. The message is not sent.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                },
                "example": {
                  "error": "invalid image: must be a valid URL or base64 data URI"
                }
              }
            }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": {
            "description": "Buttons outside the rules, `image` with the URL button, a channel that is neither Official WhatsApp nor WhatsApp Web, or a WhatsApp Web channel without WhatsApp Web enabled in the workspace. The message is not sent.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "description": "Error message" }
                  }
                },
                "examples": {
                  "callButton": {
                    "summary": "CALL button",
                    "value": { "error": "call button is not supported for this channel" }
                  },
                  "copyButton": {
                    "summary": "Copy code button",
                    "value": { "error": "copy button is not supported for this channel" }
                  },
                  "urlAndReply": {
                    "summary": "URL and REPLY in the same message",
                    "value": { "error": "URL and REPLY buttons cannot be sent together on this channel" }
                  },
                  "notMetaWhatsapp": {
                    "summary": "Channel is neither Official WhatsApp nor WhatsApp Web",
                    "value": { "error": "instance middleware is not META_WHATSAPP" }
                  },
                  "urlButtonImage": {
                    "summary": "image with the URL button",
                    "value": { "error": "image header with a URL button is not available for this channel yet" }
                  },
                  "zapiDisabled": {
                    "summary": "WhatsApp Web not enabled in the workspace",
                    "value": { "error": "Z-API (WhatsApp Web) instances are not enabled for this workspace" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/send-button-list": {
      "post": {
        "summary": "Send button list",
        "description": "Sends a text message with quick-selection buttons.",
        "operationId": "sendButtonList",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendButtonListRequest" },
              "examples": {
                "withoutImage": {
                  "summary": "Without image",
                  "value": {
                    "phone": "5511999999999",
                    "message": "How would you rate our service?",
                    "buttonList": {
                      "buttons": [
                        { "id": "1", "label": "Excellent" },
                        { "id": "2", "label": "Good" },
                        { "id": "3", "label": "Average" }
                      ]
                    }
                  }
                },
                "withImage": {
                  "summary": "With image",
                  "value": {
                    "phone": "5511999999999",
                    "message": "How would you rate our service?",
                    "buttonList": {
                      "image": "https://example.com/image.png",
                      "buttons": [
                        { "id": "1", "label": "Excellent" },
                        { "id": "2", "label": "Good" },
                        { "id": "3", "label": "Average" }
                      ]
                    }
                  }
                },
                "withVideo": {
                  "summary": "With video",
                  "value": {
                    "phone": "5511999999999",
                    "message": "How would you rate our service?",
                    "buttonList": {
                      "video": "https://example.com/video.mp4",
                      "buttons": [
                        { "id": "1", "label": "Excellent" },
                        { "id": "2", "label": "Good" },
                        { "id": "3", "label": "Average" }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/NotMetaWhatsapp" }
        }
      }
    },
    "/send-contact": {
      "post": {
        "summary": "Send contact",
        "description": "Sends a contact via WhatsApp. The contact does not need to be saved in your address book.",
        "operationId": "sendContact",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendContactRequest" },
              "example": {
                "phone": "5511999999999",
                "contactName": "Omni Z-API Support",
                "contactPhone": "5511888888888"
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/NotMetaWhatsapp" }
        }
      }
    },
    "/send-document/{extension}": {
      "post": {
        "summary": "Send document",
        "description": "Sends a document (PDF, DOC, XLS, etc). The file extension must be provided in the path. Accepts URL or Base64.",
        "operationId": "sendDocument",
        "tags": ["Messages"],
        "parameters": [
          {
            "name": "extension",
            "in": "path",
            "required": true,
            "description": "File extension (e.g. pdf, docx, xlsx)",
            "schema": { "type": "string", "example": "pdf" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendDocumentRequest" },
              "examples": {
                "url": {
                  "summary": "Send by URL",
                  "value": {
                    "phone": "5511999999999",
                    "document": "https://example.com/file.pdf",
                    "fileName": "My document"
                  }
                },
                "base64": {
                  "summary": "Send by Base64",
                  "value": {
                    "phone": "5511999999999",
                    "document": "data:application/pdf;base64,JVBERiN0YXJ0eHJlZg...",
                    "fileName": "My document"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/NotMetaWhatsapp" }
        }
      }
    },
    "/send-video": {
      "post": {
        "summary": "Send video",
        "description": "Sends a message with a video. Accepts URL or Base64 (with `data:video/mp4;base64,` prefix).",
        "operationId": "sendVideo",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendVideoRequest" },
              "examples": {
                "url": {
                  "summary": "Send by URL",
                  "value": {
                    "phone": "5511999999999",
                    "video": "https://example.com/video.mp4",
                    "caption": "Check out this video!",
                    "viewOnce": false
                  }
                },
                "base64": {
                  "summary": "Send by Base64",
                  "value": {
                    "phone": "5511999999999",
                    "video": "data:video/mp4;base64,AAYXJ0eHJlZgIGZ0eXBtc0eH...",
                    "caption": "Check out this video!",
                    "viewOnce": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/NotMetaWhatsapp" }
        }
      }
    },
    "/send-audio": {
      "post": {
        "summary": "Send audio",
        "description": "Sends an audio message (voice message). Accepts URL or Base64 (with `data:audio/mpeg;base64,` prefix).",
        "operationId": "sendAudio",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendAudioRequest" },
              "examples": {
                "url": {
                  "summary": "Send by URL",
                  "value": {
                    "phone": "5511999999999",
                    "audio": "https://example.com/audio.mp3",
                    "viewOnce": false
                  }
                },
                "base64": {
                  "summary": "Send by Base64",
                  "value": {
                    "phone": "5511999999999",
                    "audio": "data:audio/mpeg;base64,SUQzAwAAA...",
                    "viewOnce": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/NotMetaWhatsapp" }
        }
      }
    },
    "/send-sticker": {
      "post": {
        "summary": "Send sticker",
        "description": "Sends a sticker. Accepts URL or Base64 (with `data:image/png;base64,` prefix).",
        "operationId": "sendSticker",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendStickerRequest" },
              "examples": {
                "url": {
                  "summary": "Send by URL",
                  "value": {
                    "phone": "5511999999999",
                    "sticker": "https://example.com/sticker.png",
                    "stickerAuthor": "Omni Z-API"
                  }
                },
                "base64": {
                  "summary": "Send by Base64",
                  "value": {
                    "phone": "5511999999999",
                    "sticker": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAyAAAAMg...",
                    "stickerAuthor": "Omni Z-API"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/NotMetaWhatsapp" }
        }
      }
    },
    "/send-carousel": {
      "post": {
        "summary": "Send carousel",
        "description": "Sends a message with a carousel of 2 to 10 cards, each with an image, text and action buttons. Each card carries one URL button or REPLY buttons, and all cards have the same number and type of buttons. The CALL button is not accepted.",
        "operationId": "sendCarousel",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendCarouselRequest" },
              "example": {
                "phone": "5511999999999",
                "message": "Check out our products:",
                "carousel": [
                  {
                    "text": "Product A",
                    "image": "https://example.com/product-a.png",
                    "buttons": [
                      { "id": "1", "type": "URL", "label": "View details", "url": "https://www.omni.z-api.io" }
                    ]
                  },
                  {
                    "text": "Product B",
                    "image": "https://example.com/product-b.png",
                    "buttons": [
                      { "id": "2", "type": "URL", "label": "View details", "url": "https://www.omni.z-api.io" }
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "400": {
            "description": "Invalid request, such as a card `image` that is neither an `http` or `https` URL nor a data URI, or that carries invalid base64. The message is not sent.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "description": "Error message" }
                  }
                },
                "examples": {
                  "invalidMediaFormat": {
                    "summary": "image that is neither a URL nor a data URI",
                    "value": { "error": "invalid media format: must be URL or base64 data URI" }
                  },
                  "invalidBase64": {
                    "summary": "image with invalid base64",
                    "value": { "error": "failed to decode base64: base64 decode failed: illegal base64 data at input byte 0" }
                  }
                }
              }
            }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "413": {
            "description": "Request body above 10 MiB. With many images, send URLs instead of base64.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "description": "Error message" }
                  }
                },
                "example": { "error": "request body too large" }
              }
            }
          },
          "422": {
            "description": "Carousel outside the rules, or a channel that is not WhatsApp Official. The message is not sent.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "description": "Error message" }
                  }
                },
                "examples": {
                  "carouselRefused": {
                    "summary": "Carousel outside the rules",
                    "value": { "error": "URL and REPLY buttons cannot be sent together on this channel" }
                  },
                  "notMetaWhatsapp": {
                    "summary": "Channel is not WhatsApp Official",
                    "value": { "error": "instance middleware is not META_WHATSAPP" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/send-button-pix": {
      "post": {
        "summary": "Send Pix button",
        "description": "Sends a message with a Pix payment button.",
        "operationId": "sendButtonPix",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendButtonPixRequest" },
              "example": {
                "phone": "5511999999999",
                "pixKey": "12345678900",
                "type": "CPF",
                "merchantName": "Omni Z-API"
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/NotMetaWhatsapp" }
        }
      }
    },
    "/send-catalog": {
      "post": {
        "summary": "Send catalog",
        "description": "Sends the product catalog connected to the channel's WhatsApp account. catalogPhone is required, but the number you send is ignored.",
        "operationId": "sendCatalog",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendCatalogRequest" },
              "example": {
                "phone": "5511999999999",
                "catalogPhone": "5511999999999",
                "message": "Follow this link to view our catalog on WhatsApp:",
                "catalogDescription": "Learn more about this company's products and services."
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "400": {
            "description": "Body outside the rules: `catalogPhone` missing or without 8 to 15 digits, `message` missing or above 1,024 characters, or `catalogDescription` above 60 characters. The message is not sent.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "error": { "type": "string", "description": "Error message" } } },
                "example": { "error": "catalogPhone is required" }
              }
            }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/NotMetaWhatsapp" }
        }
      }
    },
    "/send-product": {
      "post": {
        "summary": "Send product",
        "description": "Sends a product from the WhatsApp Business catalog.",
        "operationId": "sendProduct",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendProductRequest" },
              "example": {
                "phone": "5511999999999",
                "catalogPhone": "5511999999999",
                "productId": "7190654897637620"
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/NotMetaWhatsapp" }
        }
      }
    },
    "/send-reaction": {
      "post": {
        "summary": "Send reaction",
        "description": "Sends a reaction (emoji) to an existing message. Works for both sent and received messages.",
        "operationId": "sendReaction",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendReactionRequest" },
              "example": {
                "phone": "5511999999999",
                "reaction": "❤️",
                "messageId": "D241XXXX732339502B68"
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/NotMetaWhatsapp" }
        }
      }
    },
    "/send-remove-reaction": {
      "post": {
        "summary": "Remove reaction",
        "description": "Removes a reaction (emoji) from an existing message.",
        "operationId": "sendRemoveReaction",
        "tags": ["Messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendRemoveReactionRequest" },
              "example": {
                "phone": "5511999999999",
                "messageId": "D241XXXX732339502B68"
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageSuccess" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/NotMetaWhatsapp" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MessageSuccess": {
        "description": "Message sent successfully",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MessageResponse" },
            "example": {
              "zaapId": "3999984263738042930CD6ECDE9VDWSA",
              "messageId": "D241XXXX732339502B68",
              "id": "D241XXXX732339502B68"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "HTTP method the route does not accept. The `error` and the `Allow` header list the methods the route accepts; on the send routes, only `POST`.",
        "headers": {
          "Allow": {
            "description": "Methods the route accepts, separated by commas",
            "schema": { "type": "string" },
            "example": "POST"
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "method not allowed: use POST" }
          }
        }
      },
      "NotMetaWhatsapp": {
        "description": "Channel is not WhatsApp Official. The Z-API compatibility route only sends through WhatsApp Official channels (Meta API); for other channels, use the Omni Z-API message routes.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "description": "Error message"
                }
              }
            },
            "example": {
              "error": "instance middleware is not META_WHATSAPP"
            }
          }
        }
      }
    },
    "schemas": {
      "SendTextRequest": {
        "type": "object",
        "required": ["phone", "message"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "message": { "type": "string", "description": "Message text", "example": "Welcome to *Omni Z-API*!" },
          "delayMessage": { "type": "integer", "description": "Delay in seconds before sending (1-15)", "minimum": 1, "maximum": 15 },
          "delayTyping": { "type": "integer", "description": "Seconds to display \"typing\" status (1-15)", "minimum": 1, "maximum": 15 }
        }
      },
      "SendImageRequest": {
        "type": "object",
        "required": ["phone", "image"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "image": { "type": "string", "description": "Image URL or Base64 data" },
          "caption": { "type": "string", "description": "Image caption" },
          "messageId": { "type": "string", "description": "ID of an existing message to reply to" },
          "delayMessage": { "type": "integer", "description": "Delay in seconds before sending (1-15)", "minimum": 1, "maximum": 15 },
          "viewOnce": { "type": "boolean", "description": "Send as view-once message", "default": false }
        }
      },
      "SendLinkRequest": {
        "type": "object",
        "required": ["phone", "message", "image", "linkUrl", "title", "linkDescription"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "message": { "type": "string", "description": "Message text. Must include the link URL at the end" },
          "image": { "type": "string", "description": "Link preview image URL" },
          "linkUrl": { "type": "string", "description": "Link URL" },
          "title": { "type": "string", "description": "Link title" },
          "linkDescription": { "type": "string", "description": "Link description" },
          "linkType": { "type": "string", "description": "Preview size: SMALL, MEDIUM or LARGE", "enum": ["SMALL", "MEDIUM", "LARGE"], "default": "SMALL" },
          "delayMessage": { "type": "integer", "description": "Delay in seconds before sending (1-15)", "minimum": 1, "maximum": 15 },
          "delayTyping": { "type": "integer", "description": "Seconds to display \"typing\" status (1-15)", "minimum": 1, "maximum": 15 }
        }
      },
      "SendButtonActionsRequest": {
        "type": "object",
        "required": ["phone", "message", "buttonActions"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "message": { "type": "string", "description": "Message text, up to 1,024 characters", "maxLength": 1024 },
          "title": { "type": "string", "description": "Message title, up to 60 characters. Only with the URL button", "maxLength": 60 },
          "footer": { "type": "string", "description": "Message footer, up to 60 characters. Only with the URL button", "maxLength": 60 },
          "image": { "type": "string", "description": "Header image, only with REPLY buttons: an http or https URL or base64 (data:<mime type>;base64,<content>). With the URL button, the message is refused with 422" },
          "buttonActions": {
            "type": "array",
            "description": "Action buttons: one URL button or up to three REPLY buttons, never both in the same message",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["type", "label"],
              "properties": {
                "id": { "type": "string", "description": "Button identifier, up to 256 characters. Without id, the button gets its position in the list, starting at \"1\"", "maxLength": 256 },
                "type": { "type": "string", "description": "Button type: URL opens a link, REPLY is a quick reply", "enum": ["URL", "REPLY"] },
                "label": { "type": "string", "description": "Text displayed on the button, up to 20 characters", "maxLength": 20 },
                "url": { "type": "string", "description": "URL for URL-type buttons (must start with http:// or https://)" }
              }
            }
          },
          "delayMessage": { "type": "integer", "description": "Delay in seconds before sending (1-15)", "minimum": 1, "maximum": 15 }
        }
      },
      "SendButtonListRequest": {
        "type": "object",
        "required": ["phone", "message", "buttonList"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "message": { "type": "string", "description": "Message text (required, cannot be empty)" },
          "buttonList": {
            "type": "object",
            "description": "Button configuration",
            "required": ["buttons"],
            "properties": {
              "image": { "type": "string", "description": "URL or Base64 of an image to display alongside the buttons" },
              "video": { "type": "string", "description": "URL or Base64 of a video to display alongside the buttons" },
              "buttons": {
                "type": "array",
                "description": "List of buttons",
                "items": {
                  "type": "object",
                  "required": ["label"],
                  "properties": {
                    "id": { "type": "string", "description": "Button identifier" },
                    "label": { "type": "string", "description": "Text displayed on the button" }
                  }
                }
              }
            }
          },
          "delayMessage": { "type": "integer", "description": "Delay in seconds before sending (1-15)", "minimum": 1, "maximum": 15 }
        }
      },
      "SendContactRequest": {
        "type": "object",
        "required": ["phone", "contactName", "contactPhone"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "contactName": { "type": "string", "description": "Name of the contact to share" },
          "contactPhone": { "type": "string", "description": "Phone number of the contact to share" },
          "contactBusinessDescription": { "type": "string", "description": "Contact description" },
          "messageId": { "type": "string", "description": "ID of an existing message to reply to" },
          "delayMessage": { "type": "integer", "description": "Delay in seconds before sending (1-15)", "minimum": 1, "maximum": 15 }
        }
      },
      "SendDocumentRequest": {
        "type": "object",
        "required": ["phone", "document"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "document": { "type": "string", "description": "Document URL or Base64 data" },
          "fileName": { "type": "string", "description": "File name" },
          "caption": { "type": "string", "description": "Document description" },
          "messageId": { "type": "string", "description": "ID of an existing message to reply to" },
          "delayMessage": { "type": "integer", "description": "Delay in seconds before sending (1-15)", "minimum": 1, "maximum": 15 }
        }
      },
      "SendVideoRequest": {
        "type": "object",
        "required": ["phone", "video"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "video": { "type": "string", "description": "Video URL or Base64 data" },
          "caption": { "type": "string", "description": "Video caption" },
          "messageId": { "type": "string", "description": "ID of an existing message to reply to" },
          "delayMessage": { "type": "integer", "description": "Delay in seconds before sending (1-15)", "minimum": 1, "maximum": 15 },
          "viewOnce": { "type": "boolean", "description": "Send as view-once message", "default": false }
        }
      },
      "SendAudioRequest": {
        "type": "object",
        "required": ["phone", "audio"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "audio": { "type": "string", "description": "Audio URL or Base64 data" },
          "viewOnce": { "type": "boolean", "description": "Send as view-once message", "default": false },
          "delayMessage": { "type": "integer", "description": "Delay in seconds before sending (1-15)", "minimum": 1, "maximum": 15 },
          "delayTyping": { "type": "integer", "description": "Seconds to display \"Recording audio...\" status (1-15)", "minimum": 1, "maximum": 15 }
        }
      },
      "SendStickerRequest": {
        "type": "object",
        "required": ["phone", "sticker"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "sticker": { "type": "string", "description": "Sticker URL or Base64 data" },
          "stickerAuthor": { "type": "string", "description": "Sticker author name" },
          "messageId": { "type": "string", "description": "ID of an existing message to reply to" },
          "delayMessage": { "type": "integer", "description": "Delay in seconds before sending (1-15)", "minimum": 1, "maximum": 15 }
        }
      },
      "SendReactionRequest": {
        "type": "object",
        "required": ["phone", "reaction", "messageId"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "reaction": { "type": "string", "description": "Reaction emoji", "example": "❤️" },
          "messageId": { "type": "string", "description": "ID of the message to react to" },
          "delayMessage": { "type": "integer", "description": "Delay in seconds before sending (1-15)", "minimum": 1, "maximum": 15 }
        }
      },
      "SendCarouselRequest": {
        "type": "object",
        "required": ["phone", "message", "carousel"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "message": { "type": "string", "description": "Message text, up to 1,024 characters", "maxLength": 1024 },
          "carousel": {
            "type": "array",
            "description": "List of carousel cards, from 2 to 10. All cards have the same number and type of buttons.",
            "minItems": 2,
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": ["text", "image", "buttons"],
              "properties": {
                "text": { "type": "string", "description": "Card text, up to 160 characters and at most 2 line breaks", "maxLength": 160 },
                "image": { "type": "string", "description": "Card image URL, or a JPEG or PNG image in base64 (data URI) of up to 5 MB" },
                "buttons": {
                  "type": "array",
                  "description": "Card action buttons: one URL button or REPLY buttons, never both in the same card",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["type", "label"],
                    "properties": {
                      "id": { "type": "string", "description": "Button identifier, up to 256 characters and unique in the card. Without id, the button gets its position in the card, starting at \"1\"", "maxLength": 256 },
                      "type": { "type": "string", "description": "Button type: URL opens a link, REPLY is a quick reply", "enum": ["URL", "REPLY"] },
                      "label": { "type": "string", "description": "Text displayed on the button, up to 20 characters", "maxLength": 20 },
                      "url": { "type": "string", "description": "http or https URL, required on the URL button" }
                    }
                  }
                }
              }
            }
          },
          "delayMessage": { "type": "integer", "description": "Delay in seconds before sending (1-15)", "minimum": 1, "maximum": 15 }
        }
      },
      "SendButtonPixRequest": {
        "type": "object",
        "required": ["phone", "pixKey", "type"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "pixKey": { "type": "string", "description": "Pix key" },
          "type": { "type": "string", "description": "Pix key type", "enum": ["CPF", "CNPJ", "PHONE", "EMAIL", "EVP"] },
          "merchantName": { "type": "string", "description": "Button title. Default: \"Pix\"" }
        }
      },
      "SendCatalogRequest": {
        "type": "object",
        "required": ["phone", "catalogPhone", "message"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "catalogPhone": { "type": "string", "description": "Required, with 8 to 15 digits, but the value is ignored: the catalog sent is always the one connected to the channel's WhatsApp account" },
          "translation": { "type": "string", "description": "Ignored. The official API catalog message has no language.", "enum": ["EN", "PT"] },
          "message": { "type": "string", "description": "Message text, up to 1,024 characters", "maxLength": 1024 },
          "title": { "type": "string", "description": "Ignored. The official API catalog message has no title." },
          "catalogDescription": { "type": "string", "description": "Message footer, up to 60 characters", "maxLength": 60 }
        }
      },
      "SendProductRequest": {
        "type": "object",
        "required": ["phone", "catalogPhone", "productId"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "catalogPhone": { "type": "string", "description": "Phone number of the business account that owns the product" },
          "productId": { "type": "string", "description": "Product ID in the catalog" }
        }
      },
      "SendRemoveReactionRequest": {
        "type": "object",
        "required": ["phone", "messageId"],
        "properties": {
          "phone": { "type": "string", "description": "Recipient phone number (country code + area code + number)", "example": "5511999999999" },
          "messageId": { "type": "string", "description": "ID of the message whose reaction will be removed" },
          "delayMessage": { "type": "integer", "description": "Delay in seconds before sending (1-15)", "minimum": 1, "maximum": 15 }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "zaapId": { "type": "string", "description": "Internal identifier" },
          "messageId": { "type": "string", "description": "WhatsApp message ID" },
          "id": { "type": "string", "description": "Same value as messageId (compatibility)" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "description": "Error message" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in the Omni Z-API Security panel"
      }
    }
  }
}
