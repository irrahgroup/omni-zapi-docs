{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Templates API",
    "description": "API for managing WhatsApp Business message templates",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/whatsapp/businesses": {
      "get": {
        "summary": "List WABAs",
        "description": "Returns the list of WABAs (WhatsApp Business Accounts) available for the authenticated token.",
        "operationId": "listBusinesses",
        "tags": [
          "Templates"
        ],
        "responses": {
          "200": {
            "description": "List of WABAs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Business"
                  }
                },
                "example": [
                  {
                    "businessId": "428083093730937",
                    "name": "Demo",
                    "channelsCount": 1,
                    "connectedCount": 1,
                    "disconnectedCount": 0
                  }
                ]
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/whatsapp/businesses/{wabaId}/templates": {
      "get": {
        "summary": "List templates",
        "description": "Returns the list of templates for a WABA. The structure of `components` varies depending on the category and configuration of each template.",
        "operationId": "listTemplates",
        "tags": [
          "Templates"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "WABA ID (obtained via List WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of templates per page (Meta cursor pagination)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "example": 25
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by approval status",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "APPROVED",
                "REJECTED"
              ],
              "example": "APPROVED"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Previous page cursor, returned in `paging.cursors.before`",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "Next page cursor, returned in `paging.cursors.after`",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of templates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Template"
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": "1900296177408890",
                      "name": "confirm_account",
                      "status": "APPROVED",
                      "category": "AUTHENTICATION",
                      "language": "en_US",
                      "parameter_format": "POSITIONAL",
                      "message_send_ttl_seconds": 600,
                      "components": [
                        {
                          "type": "BODY",
                          "text": "Your verification code is *{{1}}*. For your security, do not share it.",
                          "add_security_recommendation": true,
                          "example": {
                            "body_text": [
                              [
                                "123456"
                              ]
                            ]
                          }
                        },
                        {
                          "type": "BUTTONS",
                          "buttons": [
                            {
                              "type": "URL",
                              "text": "Copy code",
                              "url": "https://www.whatsapp.com/otp/code/?otp_type=COPY_CODE&code=otp{{1}}",
                              "example": [
                                "https://www.whatsapp.com/otp/code/?otp_type=COPY_CODE&code=otp123456"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "summary": "Create template",
        "description": "Creates a new message template and submits it for Meta approval.",
        "operationId": "createTemplate",
        "tags": [
          "Templates"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "WABA ID (obtained via List WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTemplateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Template created and submitted for approval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTemplateResponse"
                },
                "example": {
                  "id": "1613165359891625",
                  "status": "PENDING",
                  "category": "UTILITY"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/MetaError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/whatsapp/businesses/{wabaId}/templates/{templateId}": {
      "put": {
        "summary": "Edit template",
        "description": "Edits an existing template and resubmits it for Meta approval.",
        "operationId": "updateTemplate",
        "tags": [
          "Templates"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "WABA ID (obtained via List WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "templateId",
            "in": "path",
            "required": true,
            "description": "Template ID (obtained via List templates)",
            "schema": {
              "type": "string",
              "example": "1900296177408890"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTemplateRequest"
              },
              "example": {
                "name": "order_update_v1",
                "category": "UTILITY",
                "language": "en_US",
                "components": [
                  {
                    "type": "BODY",
                    "text": "Hello {{1}}, your order {{2}} has been updated to {{3}}.",
                    "example": {
                      "body_text": [
                        [
                          "Ana",
                          "ORD-1024",
                          "in transit"
                        ]
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Template edited successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "success": true
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/MetaError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      },
      "delete": {
        "summary": "Delete template",
        "description": "Removes an existing template from the WABA.",
        "operationId": "deleteTemplate",
        "tags": [
          "Templates"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "WABA ID (obtained via List WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "templateId",
            "in": "path",
            "required": true,
            "description": "Template ID (obtained via List templates)",
            "schema": {
              "type": "string",
              "example": "1900296177408890"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "Template name. Meta requires the name alongside the ID to remove every translation of the template",
            "schema": {
              "type": "string",
              "example": "order_update_v1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Template deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "success": true
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/whatsapp/businesses/{wabaId}/templates/sync": {
      "post": {
        "summary": "Sync templates",
        "description": "Forces synchronization of templates with Meta, updating statuses (PENDING, APPROVED, REJECTED) and other information.",
        "operationId": "syncTemplates",
        "tags": [
          "Templates"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "WABA ID (obtained via List WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Synchronization completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                },
                "example": {
                  "data": [
                    {
                      "id": "1900296177408890",
                      "name": "confirm_account",
                      "status": "APPROVED",
                      "category": "AUTHENTICATION",
                      "language": "en_US",
                      "parameter_format": "POSITIONAL",
                      "message_send_ttl_seconds": 600,
                      "components": [
                        {
                          "type": "BODY",
                          "text": "Your verification code is *{{1}}*. For your security, do not share it.",
                          "add_security_recommendation": true,
                          "example": {
                            "body_text": [
                              [
                                "123456"
                              ]
                            ]
                          }
                        }
                      ]
                    }
                  ],
                  "syncedCount": 2,
                  "synced": true
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/whatsapp/businesses/{wabaId}/templates/media": {
      "post": {
        "summary": "Upload template media",
        "description": "Uploads the media HEADER file and returns the `header_handle` Meta requires.\n\nMeta does not accept the file directly when creating the template: it requires the handle from the Resumable Upload API, which depends on the application token. This endpoint bridges that.",
        "operationId": "uploadTemplateMedia",
        "tags": [
          "Templates"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "WABA ID (obtained via List WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "type"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Header file (image, video or document). 100 MB limit"
                  },
                  "type": {
                    "type": "string",
                    "description": "File MIME type (e.g. `image/jpeg`, `video/mp4`, `application/pdf`)",
                    "example": "image/jpeg"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateMediaResponse"
                },
                "example": {
                  "h": "4::aW1hZ2UvanBlZw==:ARZ...:e:1770000000:..."
                }
              }
            }
          },
          "400": {
            "description": "Invalid request — empty file or missing `type`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "File larger than 100 MB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "The account has no Meta App ID and App Secret configured (`MISSING_APP_CREDENTIALS`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Meta refused the upload (`META_REFUSED`) or the app configuration could not be read (`CONFIG_UNREACHABLE`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/whatsapp/businesses/{wabaId}/template-library": {
      "get": {
        "summary": "List template library",
        "description": "Returns the ready-made templates from Meta's library, which can be created without going through review.",
        "operationId": "listTemplateLibrary",
        "tags": [
          "Templates"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "WABA ID (obtained via List WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Library templates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateLibraryResponse"
                },
                "example": {
                  "data": [
                    {
                      "name": "order_confirmation_1",
                      "category": "UTILITY",
                      "languages": [
                        "pt_BR",
                        "en_US",
                        "es_ES"
                      ],
                      "body": "Ola {{1}}, seu pedido {{2}} foi confirmado."
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MethodNotAllowed": {
        "description": "Method not allowed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": 405,
              "message": "Method not allowed"
            }
          }
        }
      },
      "MetaError": {
        "description": "Error returned by Meta when processing the request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MetaError"
            },
            "example": {
              "error": "Newport request failed",
              "value": {
                "errors": [
                  {
                    "description": "",
                    "name": "META_WHATSAPP_ERROR",
                    "message": "Your message could not be sent because it contains content that other people on Facebook have reported as abusive.",
                    "code": "368"
                  }
                ]
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Invalid or missing token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": 401,
              "message": "Unauthorized"
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "The request could not be processed due to a validation error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UnprocessableEntity"
            },
            "example": {
              "error": {
                "errors": [
                  {
                    "code": "100",
                    "name": "META_WHATSAPP_ERROR",
                    "subCode": "2388024",
                    "message": "Invalid parameter",
                    "description": "There is already English (US) content for this template. You can create a new template and try again."
                  }
                ]
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Business": {
        "type": "object",
        "properties": {
          "businessId": {
            "type": "string",
            "description": "WABA ID (WhatsApp Business Account)"
          },
          "name": {
            "type": "string",
            "description": "WABA name"
          },
          "channelsCount": {
            "type": "integer",
            "description": "Total linked channels"
          },
          "connectedCount": {
            "type": "integer",
            "description": "Connected channels"
          },
          "disconnectedCount": {
            "type": "integer",
            "description": "Disconnected channels"
          }
        }
      },
      "CreateTemplateRequest": {
        "type": "object",
        "required": [
          "name",
          "category",
          "language"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^[a-z0-9_]+$",
            "description": "Template name: lowercase letters, digits and underscore. It cannot be changed after creation."
          },
          "category": {
            "type": "string",
            "enum": [
              "UTILITY",
              "MARKETING",
              "AUTHENTICATION"
            ],
            "description": "Several types have a fixed category. See \"Template types\"."
          },
          "language": {
            "type": "string",
            "description": "Language in Meta's format, such as pt_BR or en_US."
          },
          "parameter_format": {
            "type": "string",
            "enum": [
              "NAMED",
              "POSITIONAL"
            ],
            "description": "Variable syntax. Named is Meta's current format."
          },
          "message_send_ttl_seconds": {
            "type": "integer",
            "description": "Delivery window in seconds. Range by category: authentication 30 to 900, marketing 43200 to 2592000, utility 30 to 43200. The value -1 is a shortcut for 30 days."
          },
          "allow_category_change": {
            "type": "boolean",
            "description": "Lets Meta recategorize the template during review."
          },
          "library_template_name": {
            "type": "string",
            "description": "Model name in Meta's template library. See \"Template Library\"."
          },
          "library_template_body_inputs": {
            "type": "array",
            "description": "Body options the library model accepts.",
            "items": {
              "type": "object",
              "properties": {
                "add_contact_number": {
                  "type": "boolean",
                  "description": "Adds the sentence offering the contact phone number."
                },
                "add_learn_more_link": {
                  "type": "boolean",
                  "description": "Adds the sentence inviting the customer to learn more."
                },
                "add_security_recommendation": {
                  "type": "boolean",
                  "description": "Adds Meta's security recommendation."
                },
                "add_track_package_link": {
                  "type": "boolean",
                  "description": "Adds the sentence inviting the customer to track the delivery."
                },
                "code_expiration_minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 90,
                  "description": "Code validity in the model, from 1 to 90 minutes."
                }
              }
            }
          },
          "library_template_button_inputs": {
            "type": "array",
            "description": "Button data for the library model.",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "URL",
                    "PHONE_NUMBER",
                    "VOICE_CALL"
                  ],
                  "description": "Type of button the model asks for."
                },
                "url": {
                  "type": "object",
                  "description": "URL for the model's link button.",
                  "properties": {
                    "base_url": {
                      "type": "string",
                      "description": "Fixed URL, with the variable at the end when there is one."
                    },
                    "url_suffix_example": {
                      "type": "string",
                      "description": "The same URL with the variable filled in."
                    }
                  }
                },
                "phone_number": {
                  "type": "string",
                  "pattern": "^\\+[1-9]\\d{7,14}$",
                  "description": "Phone button number, in international format."
                }
              }
            }
          },
          "components": {
            "type": "array",
            "description": "Each item is a component, identified by the `type` field. The fields below belong to a specific `type`, and what each template type accepts is in \"Template types\".",
            "items": {
              "$ref": "#/components/schemas/TemplateComponent"
            }
          }
        }
      },
      "CreateTemplateResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Created template ID"
          },
          "status": {
            "type": "string",
            "description": "Initial status (usually PENDING)",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "category": {
            "type": "string",
            "description": "Created template category",
            "enum": [
              "UTILITY",
              "MARKETING",
              "AUTHENTICATION"
            ]
          }
        }
      },
      "SyncResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "description": "List of synced templates",
            "items": {
              "$ref": "#/components/schemas/Template"
            }
          },
          "syncedCount": {
            "type": "integer",
            "description": "Number of synced templates"
          },
          "synced": {
            "type": "boolean",
            "description": "Indicates whether the synchronization was successful"
          }
        }
      },
      "Template": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Template ID"
          },
          "name": {
            "type": "string",
            "description": "Template name"
          },
          "status": {
            "type": "string",
            "description": "Approval status",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "category": {
            "type": "string",
            "description": "Template category",
            "enum": [
              "UTILITY",
              "MARKETING",
              "AUTHENTICATION"
            ]
          },
          "language": {
            "type": "string",
            "description": "Template language (e.g. en_US, pt_BR)"
          },
          "parameter_format": {
            "type": "string",
            "description": "Parameter format"
          },
          "message_send_ttl_seconds": {
            "type": "integer",
            "description": "Message time-to-live in seconds"
          },
          "components": {
            "type": "array",
            "description": "Template components (HEADER, BODY, FOOTER, BUTTONS)",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indicates whether the operation was successful"
          }
        }
      },
      "MetaError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "General error description"
          },
          "value": {
            "type": "object",
            "properties": {
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string",
                      "description": "Error type (e.g. META_WHATSAPP_ERROR)"
                    },
                    "message": {
                      "type": "string",
                      "description": "Meta error message"
                    },
                    "code": {
                      "type": "string",
                      "description": "Meta error code"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "integer",
            "description": "Error code"
          },
          "message": {
            "type": "string",
            "description": "Error description"
          }
        }
      },
      "UnprocessableEntity": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "subCode": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "TemplateMediaResponse": {
        "type": "object",
        "properties": {
          "h": {
            "type": "string",
            "description": "Handle to use as the HEADER component `example` when creating the template"
          }
        }
      },
      "TemplateLibraryResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Template name in the library"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "UTILITY",
                    "MARKETING",
                    "AUTHENTICATION"
                  ],
                  "description": "Category"
                },
                "languages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Available languages"
                },
                "body": {
                  "type": "string",
                  "description": "Template body preview"
                }
              }
            }
          }
        }
      },
      "TemplateVariableExample": {
        "type": "object",
        "description": "An example for each variable, in the order they appear. Meta rejects the template without it.",
        "properties": {
          "body_text": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Message examples in positional format: a list, in the order of {{1}}, {{2}} and so on."
          },
          "body_text_named_params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "param_name",
                "example"
              ],
              "properties": {
                "param_name": {
                  "type": "string",
                  "description": "Variable name, the same one written between braces in the text."
                },
                "example": {
                  "type": "string",
                  "description": "Sample value Meta reads during review."
                }
              }
            },
            "description": "Message examples in named format, one per variable."
          },
          "header_text": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1,
            "description": "Header example in positional format. The header accepts one variable."
          },
          "header_text_named_params": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": [
                "param_name",
                "example"
              ],
              "properties": {
                "param_name": {
                  "type": "string",
                  "description": "Variable name, the same one written between braces in the text."
                },
                "example": {
                  "type": "string",
                  "description": "Sample value Meta reads during review."
                }
              }
            },
            "description": "Header example in named format."
          },
          "header_handle": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1,
            "description": "On a media header: the file handle, obtained in \"Upload media\", or its public link."
          }
        }
      },
      "CarouselCard": {
        "type": "object",
        "required": [
          "components"
        ],
        "properties": {
          "components": {
            "type": "array",
            "description": "This card's components: the header with the media, the text (optional, and if one card has it, all of them need it) and the buttons.",
            "items": {
              "$ref": "#/components/schemas/TemplateComponent"
            }
          }
        }
      },
      "TemplateButton": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "QUICK_REPLY",
              "URL",
              "PHONE_NUMBER",
              "COPY_CODE",
              "OTP",
              "FLOW",
              "CATALOG",
              "MPM",
              "SPM",
              "PAYMENT_REQUEST",
              "ORDER_DETAILS",
              "VOICE_CALL"
            ],
            "description": "What the button does. QUICK_REPLY sends the button text back as a message; URL opens an address; PHONE_NUMBER calls; COPY_CODE copies a code; OTP is the authentication code button; FLOW opens a published flow. CATALOG, MPM, SPM, PAYMENT_REQUEST, ORDER_DETAILS and VOICE_CALL have a fixed Meta label."
          },
          "text": {
            "type": "string",
            "maxLength": 25,
            "description": "Up to 25 characters. On OTP and on fixed-label types, Meta writes and translates the text: whatever is sent gets overwritten."
          },
          "url": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^https?://",
            "description": "On URL: accepts one variable, and only at the end of the address."
          },
          "phone_number": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^\\+[1-9]\\d{7,14}$",
            "description": "On PHONE_NUMBER: international format, with the country code."
          },
          "example": {
            "description": "On a URL with a variable, the same address filled in. On COPY_CODE, the sample code Meta uses during review: letters, digits, hyphen and underscore, up to 20 characters.",
            "oneOf": [
              {
                "type": "string",
                "maxLength": 20,
                "description": "On COPY_CODE: the sample code, up to 20 characters."
              },
              {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "On a URL with a variable: a list with the address filled in."
              }
            ]
          },
          "otp_type": {
            "type": "string",
            "enum": [
              "COPY_CODE",
              "ONE_TAP",
              "ZERO_TAP"
            ],
            "description": "On OTP: how the customer gets the code. ONE_TAP and ZERO_TAP require the app details."
          },
          "supported_apps": {
            "type": "array",
            "maxItems": 5,
            "description": "On one-tap or zero-tap OTP: the apps that receive the code.",
            "items": {
              "type": "object",
              "required": [
                "package_name",
                "signature_hash"
              ],
              "properties": {
                "package_name": {
                  "type": "string",
                  "description": "Android app identifier, such as com.company.app."
                },
                "signature_hash": {
                  "type": "string",
                  "description": "App signature hash, generated at build time."
                }
              }
            }
          },
          "zero_tap_terms_accepted": {
            "type": "boolean",
            "description": "On zero-tap OTP: terms acceptance. Without it Meta rejects the template."
          },
          "flow_id": {
            "type": "string",
            "description": "On FLOW: published flow identifier. Use this or the name, never both."
          },
          "flow_name": {
            "type": "string",
            "description": "On FLOW: published flow name, as an alternative to the identifier."
          },
          "flow_json": {
            "type": "string",
            "description": "On FLOW: flow definition in JSON, to create and link it in one go."
          },
          "flow_action": {
            "type": "string",
            "enum": [
              "navigate",
              "data_exchange"
            ],
            "description": "On FLOW: how it opens, navigating to a screen or exchanging data."
          },
          "navigate_screen": {
            "type": "string",
            "description": "On FLOW with navigation: the start screen."
          }
        }
      },
      "TemplateComponent": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "HEADER",
              "BODY",
              "FOOTER",
              "BUTTONS",
              "CAROUSEL",
              "LIMITED_TIME_OFFER",
              "CALL_PERMISSION_REQUEST"
            ],
            "description": "Which component this is. HEADER is the band above the message; BODY is the main text, and the only one that accepts line breaks; FOOTER is the discreet line below; BUTTONS are the buttons; CAROUSEL are the cards the customer swipes; LIMITED_TIME_OFFER is the offer badge with a countdown; CALL_PERMISSION_REQUEST asks for permission to call, and has no other field."
          },
          "format": {
            "type": "string",
            "enum": [
              "TEXT",
              "IMAGE",
              "VIDEO",
              "DOCUMENT",
              "LOCATION",
              "PRODUCT"
            ],
            "description": "HEADER only: what it shows. PRODUCT exists only on the product carousel card, where the header is the catalog item itself."
          },
          "text": {
            "type": "string",
            "maxLength": 1024,
            "description": "In HEADER, up to 60 characters and at most one variable. In BODY, up to 1024, with line breaks. In FOOTER, up to 60 and no variables. On a carousel card, up to 160."
          },
          "example": {
            "$ref": "#/components/schemas/TemplateVariableExample"
          },
          "add_security_recommendation": {
            "type": "boolean",
            "description": "Authentication BODY only: adds the security sentence Meta writes (\"do not share this code\")."
          },
          "code_expiration_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90,
            "description": "Authentication FOOTER only: code validity, from 1 to 90 minutes. Meta writes the sentence."
          },
          "buttons": {
            "type": "array",
            "maxItems": 10,
            "description": "BUTTONS only: quick replies first, then the rest. Meta rejects the template when the order mixes the two groups.",
            "items": {
              "$ref": "#/components/schemas/TemplateButton"
            }
          },
          "cards": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "description": "CAROUSEL only: 2 to 10 cards, and all of them must have the same components. Each card carries its own components, with the media, the text and the buttons.",
            "items": {
              "$ref": "#/components/schemas/CarouselCard"
            }
          },
          "limited_time_offer": {
            "type": "object",
            "description": "LIMITED_TIME_OFFER only. The deadline itself goes in the send, not in the creation.",
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 16,
                "description": "Text shown on the badge, such as \"20% off\"."
              },
              "has_expiration": {
                "type": "boolean",
                "description": "Shows the countdown. The end instant goes in the send."
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in the Omni Z-API Security panel"
      }
    }
  }
}
