{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - WhatsApp Flows",
    "description": "API to create and manage WhatsApp Flows (native in-conversation forms)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/whatsapp/businesses/{wabaId}/flows": {
      "get": {
        "summary": "List flows",
        "description": "Returns all flows of the WABA at once, with name, categories and publication status. There is no pagination. With `sync=true`, it syncs with Meta before listing.",
        "operationId": "listFlows",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "WABA ID (obtained via List WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "sync",
            "in": "query",
            "required": false,
            "description": "When `true`, syncs the flows with Meta before listing. Without it, the list comes from the platform's records. The list comes complete, with no pagination",
            "schema": {
              "type": "boolean",
              "default": false,
              "example": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of flows",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlowListResponse"
                },
                "example": {
                  "data": [
                    {
                      "id": "1122334455667788",
                      "name": "agendamento_consulta",
                      "categories": [
                        "APPOINTMENT_BOOKING"
                      ],
                      "status": "PUBLISHED",
                      "endpoint_uri": null,
                      "validation_errors": []
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "description": "Meta or the platform refused the operation. See the body format in the example.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Refusal from Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Refusal without details",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/IntegrationTimeout"
          }
        }
      },
      "post": {
        "summary": "Create flow",
        "description": "Creates a flow. `flow_json` is the screen definition in JSON, sent as a string. With `publish: true` the flow is born published; otherwise it stays in `DRAFT`.",
        "operationId": "createFlow",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "WABA ID (obtained via List WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFlowRequest"
              },
              "example": {
                "name": "agendamento_consulta",
                "categories": [
                  "APPOINTMENT_BOOKING"
                ],
                "flow_json": "{\"version\": \"7.0\", \"routing_model\": {\"WELCOME\": [\"DONE\"], \"DONE\": []}, \"screens\": [{\"id\": \"WELCOME\", \"title\": \"Agendamento\", \"layout\": {\"type\": \"SingleColumnLayout\", \"children\": [{\"type\": \"TextHeading\", \"text\": \"Escolha um horario\"}, {\"type\": \"Form\", \"name\": \"form\", \"children\": [{\"type\": \"TextInput\", \"name\": \"nome\", \"label\": \"Seu nome\", \"input-type\": \"text\", \"required\": true}, {\"type\": \"DatePicker\", \"name\": \"data\", \"label\": \"Data\"}, {\"type\": \"Footer\", \"label\": \"Continuar\", \"on-click-action\": {\"name\": \"navigate\", \"next\": {\"type\": \"screen\", \"name\": \"DONE\"}, \"payload\": {}}}]}]}}, {\"id\": \"DONE\", \"title\": \"Pronto\", \"terminal\": true, \"success\": true, \"layout\": {\"type\": \"SingleColumnLayout\", \"children\": [{\"type\": \"TextBody\", \"text\": \"Agendamento confirmado.\"}, {\"type\": \"Footer\", \"label\": \"Fechar\", \"on-click-action\": {\"name\": \"complete\", \"payload\": {}}}]}}]}",
                "publish": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flow created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                },
                "example": {
                  "id": "1122334455667788",
                  "name": "agendamento_consulta",
                  "categories": [
                    "APPOINTMENT_BOOKING"
                  ],
                  "status": "DRAFT",
                  "endpoint_uri": null,
                  "validation_errors": []
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/FlowBadRequest"
          },
          "422": {
            "description": "Meta or the platform refused the operation: malformed `flow_json`, unknown category or another Meta rule. See the body format in the example.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Refusal from Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Refusal without details",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/OutcomeUnknown"
          }
        }
      }
    },
    "/whatsapp/businesses/{wabaId}/flows/sync": {
      "post": {
        "summary": "Sync flows",
        "description": "Forces flow synchronization with Meta, updating status and validation issues.",
        "operationId": "syncFlows",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "WABA ID (obtained via List WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlowListResponse"
                },
                "example": {
                  "data": [
                    {
                      "id": "1122334455667788",
                      "name": "agendamento_consulta",
                      "categories": [
                        "APPOINTMENT_BOOKING"
                      ],
                      "status": "PUBLISHED",
                      "endpoint_uri": null,
                      "validation_errors": []
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "description": "Meta or the platform refused the operation. See the body format in the example.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Refusal from Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Refusal without details",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/OutcomeUnknown"
          }
        }
      }
    },
    "/whatsapp/businesses/{wabaId}/flows/{flowId}": {
      "get": {
        "summary": "Get flow",
        "description": "Returns a specific flow, including its `flow_json` and Meta's validation issues.",
        "operationId": "getFlow",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "WABA ID (obtained via List WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "flowId",
            "in": "path",
            "required": true,
            "description": "Flow ID (obtained via List flows)",
            "schema": {
              "type": "string",
              "example": "1122334455667788"
            }
          },
          {
            "name": "sync",
            "in": "query",
            "required": false,
            "description": "When `true`, fetches the flow state straight from Meta before responding",
            "schema": {
              "type": "boolean",
              "example": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                },
                "example": {
                  "id": "1122334455667788",
                  "name": "agendamento_consulta",
                  "categories": [
                    "APPOINTMENT_BOOKING"
                  ],
                  "status": "PUBLISHED",
                  "endpoint_uri": null,
                  "validation_errors": [],
                  "flow_json": "{\"version\": \"7.0\", \"routing_model\": {\"WELCOME\": [\"DONE\"], \"DONE\": []}, \"screens\": [{\"id\": \"WELCOME\", \"title\": \"Agendamento\", \"layout\": {\"type\": \"SingleColumnLayout\", \"children\": [{\"type\": \"TextHeading\", \"text\": \"Escolha um horario\"}, {\"type\": \"Form\", \"name\": \"form\", \"children\": [{\"type\": \"TextInput\", \"name\": \"nome\", \"label\": \"Seu nome\", \"input-type\": \"text\", \"required\": true}, {\"type\": \"DatePicker\", \"name\": \"data\", \"label\": \"Data\"}, {\"type\": \"Footer\", \"label\": \"Continuar\", \"on-click-action\": {\"name\": \"navigate\", \"next\": {\"type\": \"screen\", \"name\": \"DONE\"}, \"payload\": {}}}]}]}}, {\"id\": \"DONE\", \"title\": \"Pronto\", \"terminal\": true, \"success\": true, \"layout\": {\"type\": \"SingleColumnLayout\", \"children\": [{\"type\": \"TextBody\", \"text\": \"Agendamento confirmado.\"}, {\"type\": \"Footer\", \"label\": \"Fechar\", \"on-click-action\": {\"name\": \"complete\", \"payload\": {}}}]}}]}"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "description": "Flow that does not exist or belongs to another workspace, or a refusal from Meta while fetching it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Refusal from Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Refusal without details",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/IntegrationTimeout"
          }
        }
      },
      "put": {
        "summary": "Update flow",
        "description": "Updates an existing flow. Every field is optional — only the ones you send change. A `PUBLISHED` flow does not accept `flow_json` changes.",
        "operationId": "updateFlow",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "WABA ID (obtained via List WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "flowId",
            "in": "path",
            "required": true,
            "description": "Flow ID (obtained via List flows)",
            "schema": {
              "type": "string",
              "example": "1122334455667788"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFlowRequest"
              },
              "example": {
                "name": "agendamento_consulta_v2"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flow updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                },
                "example": {
                  "id": "1122334455667788",
                  "name": "agendamento_consulta_v2",
                  "categories": [
                    "APPOINTMENT_BOOKING"
                  ],
                  "status": "PUBLISHED",
                  "endpoint_uri": null,
                  "validation_errors": []
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/FlowBadRequest"
          },
          "422": {
            "description": "Meta or the platform refused the operation: flow that does not exist or belongs to another workspace, malformed `flow_json`, unknown category, or a published flow that does not accept `flow_json` changes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Refusal from Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Refusal without details",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/OutcomeUnknown"
          }
        }
      },
      "delete": {
        "summary": "Delete flow",
        "description": "Permanently deletes a flow. Only flows in `DRAFT` can be deleted.",
        "operationId": "deleteFlow",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "WABA ID (obtained via List WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "flowId",
            "in": "path",
            "required": true,
            "description": "Flow ID (obtained via List flows)",
            "schema": {
              "type": "string",
              "example": "1122334455667788"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Flow deleted. The body is the boolean `true`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean",
                  "description": "`true` when the deletion was accepted"
                },
                "example": true
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "description": "Flow that does not exist or belongs to another workspace, or a flow outside `DRAFT`, which cannot be deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Refusal from Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Refusal without details",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/OutcomeUnknown"
          }
        }
      }
    },
    "/whatsapp/businesses/{wabaId}/flows/{flowId}/publish": {
      "post": {
        "summary": "Publish flow",
        "description": "Publishes the flow, making it available for use in messages. Once published, `flow_json` can no longer be changed.",
        "operationId": "publishFlow",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "WABA ID (obtained via List WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "flowId",
            "in": "path",
            "required": true,
            "description": "Flow ID (obtained via List flows)",
            "schema": {
              "type": "string",
              "example": "1122334455667788"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                },
                "example": {
                  "id": "1122334455667788",
                  "name": "agendamento_consulta",
                  "categories": [
                    "APPOINTMENT_BOOKING"
                  ],
                  "status": "PUBLISHED",
                  "endpoint_uri": null,
                  "validation_errors": []
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "description": "Flow that does not exist or belongs to another workspace, or a refusal from Meta while publishing (for example, validation issues in the `flow_json`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Refusal from Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Refusal without details",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/OutcomeUnknown"
          }
        }
      }
    },
    "/whatsapp/businesses/{wabaId}/flows/{flowId}/deprecate": {
      "post": {
        "summary": "Deprecate flow",
        "description": "Marks the flow as `DEPRECATED`. It stops accepting new openings, but sessions already running continue.",
        "operationId": "deprecateFlow",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "WABA ID (obtained via List WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "flowId",
            "in": "path",
            "required": true,
            "description": "Flow ID (obtained via List flows)",
            "schema": {
              "type": "string",
              "example": "1122334455667788"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                },
                "example": {
                  "id": "1122334455667788",
                  "name": "agendamento_consulta",
                  "categories": [
                    "APPOINTMENT_BOOKING"
                  ],
                  "status": "DEPRECATED",
                  "endpoint_uri": null,
                  "validation_errors": []
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "description": "Flow that does not exist or belongs to another workspace, or a refusal from Meta while deprecating.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Refusal from Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Refusal without details",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/OutcomeUnknown"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateFlowRequest": {
        "type": "object",
        "required": [
          "name",
          "categories",
          "flow_json"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Flow name",
            "example": "agendamento_consulta"
          },
          "categories": {
            "type": "array",
            "description": "Flow categories (Meta uses them during review)",
            "items": {
              "type": "string",
              "enum": [
                "SIGN_UP",
                "SIGN_IN",
                "APPOINTMENT_BOOKING",
                "LEAD_GENERATION",
                "CONTACT_US",
                "CUSTOMER_SUPPORT",
                "SURVEY",
                "OTHER"
              ]
            },
            "example": [
              "APPOINTMENT_BOOKING"
            ]
          },
          "flow_json": {
            "type": "string",
            "description": "Screen definition in JSON, sent as a **string**"
          },
          "endpoint_uri": {
            "type": "string",
            "description": "Your endpoint URL, required only for flows using `data_exchange`",
            "example": "https://app.yourcompany.com/flows/callback"
          },
          "publish": {
            "type": "boolean",
            "description": "When `true`, publishes the flow right at creation",
            "default": false
          }
        }
      },
      "UpdateFlowRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Flow name"
          },
          "categories": {
            "type": "array",
            "description": "Flow categories (Meta uses them during review)",
            "items": {
              "type": "string",
              "enum": [
                "SIGN_UP",
                "SIGN_IN",
                "APPOINTMENT_BOOKING",
                "LEAD_GENERATION",
                "CONTACT_US",
                "CUSTOMER_SUPPORT",
                "SURVEY",
                "OTHER"
              ]
            }
          },
          "flow_json": {
            "type": "string",
            "description": "Screen definition in JSON, sent as a **string**"
          },
          "endpoint_uri": {
            "type": "string",
            "description": "Your endpoint URL, required only for flows using `data_exchange`"
          }
        }
      },
      "Flow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Flow ID"
          },
          "name": {
            "type": "string",
            "description": "Flow name"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SIGN_UP",
                "SIGN_IN",
                "APPOINTMENT_BOOKING",
                "LEAD_GENERATION",
                "CONTACT_US",
                "CUSTOMER_SUPPORT",
                "SURVEY",
                "OTHER"
              ]
            },
            "description": "Flow categories (Meta uses them during review)"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "DEPRECATED",
              "BLOCKED",
              "THROTTLED"
            ],
            "description": "Publication status"
          },
          "endpoint_uri": {
            "type": "string",
            "nullable": true,
            "description": "Your endpoint URL, required only for flows using `data_exchange`"
          },
          "flow_json": {
            "type": "string",
            "description": "Screen definition in JSON, sent as a **string**"
          },
          "validation_errors": {
            "type": "array",
            "description": "Validation issues returned by Meta",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Issue key"
                },
                "value": {
                  "type": "string",
                  "description": "Issue detail"
                }
              }
            }
          }
        }
      },
      "FlowListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "description": "List of flows",
            "items": {
              "$ref": "#/components/schemas/Flow"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error code or message"
          },
          "message": {
            "type": "string",
            "description": "Error description"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error code"
          },
          "message": {
            "type": "string",
            "description": "Message for the integrator"
          }
        }
      },
      "UnprocessableEntity": {
        "type": "object",
        "properties": {
          "error": {
            "description": "Refusal details (object) or, when there are no details, the message as text.",
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "timestamp": {
                    "type": "string",
                    "description": "When the refusal happened"
                  },
                  "status": {
                    "type": "integer",
                    "description": "HTTP status reported in the refusal details"
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "description": "Meta error code"
                        },
                        "name": {
                          "type": "string",
                          "description": "Error type (e.g. META_WHATSAPP_ERROR)"
                        },
                        "subCode": {
                          "type": "string",
                          "description": "Meta error subcode"
                        },
                        "message": {
                          "type": "string",
                          "description": "Error message"
                        },
                        "description": {
                          "type": "string",
                          "description": "Explanation of the refusal"
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generated in the Z-API Omni Security panel. The `Bearer` prefix is optional."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Authentication refused. The `Authorization` header is missing, the key is malformed or does not exist (`Authorization invalid`), or the source IP is not in the Secret Key's allowed IP list (`<ip> not allowed`). The `Bearer` prefix is optional.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "authorization_invalid": {
                "summary": "Missing, malformed or unknown key",
                "value": {
                  "error": "Authorization invalid"
                }
              },
              "ip_not_allowed": {
                "summary": "IP not in the Secret Key's allowed IP list",
                "value": {
                  "error": "203.0.113.10 not allowed"
                }
              },
              "business_id_required": {
                "summary": "WABA not provided",
                "value": {
                  "error": "Business id is required"
                }
              }
            }
          }
        }
      },
      "FlowBadRequest": {
        "description": "Request refused before reaching Meta: authentication refused (missing `Authorization` header, malformed or unknown key, or IP not in the Secret Key's allowed IP list) or missing body.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "authorization_invalid": {
                "summary": "Missing, malformed or unknown key",
                "value": {
                  "error": "Authorization invalid"
                }
              },
              "ip_not_allowed": {
                "summary": "IP not in the Secret Key's allowed IP list",
                "value": {
                  "error": "203.0.113.10 not allowed"
                }
              },
              "request_body_missing": {
                "summary": "Missing request body",
                "value": {
                  "error": "Required request body is missing"
                }
              },
              "business_id_required": {
                "summary": "WABA not provided",
                "value": {
                  "error": "Business id is required"
                }
              }
            }
          }
        }
      },
      "IntegrationUnavailable": {
        "description": "Temporary failure of an internal service. Try again in a few moments.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "error": "integration_unavailable",
              "message": "The operation could not be completed right now. Try again in a few moments."
            }
          }
        }
      },
      "IntegrationTimeout": {
        "description": "The service did not respond in time. Retrying is safe.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "error": "integration_timeout",
              "message": "The operation took too long to complete. Try again in a few moments."
            }
          }
        }
      },
      "OutcomeUnknown": {
        "description": "The service did not respond in time and the operation may have been completed. Check the result before retrying.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "error": "outcome_unknown",
              "message": "The operation did not finish in time and may still be completed. Check the result before trying again."
            }
          }
        }
      }
    }
  }
}
