{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Groups",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/groups/capabilities": {
      "get": {
        "summary": "Group capabilities",
        "description": "Lists the group operations available on the channel. On a Meta channel the list is empty.",
        "operationId": "groupCapabilities",
        "tags": [
          "Grupos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Group capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "operations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "examples": {
                  "whatsappWeb": {
                    "value": {
                      "type": "Z_API_WHATSAPP",
                      "operations": [
                        "LIST_GROUPS",
                        "GET_GROUP",
                        "GET_INVITE_LINK",
                        "PREVIEW_INVITE"
                      ]
                    }
                  },
                  "meta": {
                    "value": {
                      "type": "META_WHATSAPP",
                      "operations": []
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/InstanceNotFound"
          }
        }
      }
    },
    "/v1/channels/{channelId}/groups": {
      "get": {
        "summary": "List groups",
        "description": "Lists the number's groups, paginated by cursor. WhatsApp Web channel (`Z_API_WHATSAPP`) only.",
        "operationId": "listGroups",
        "tags": [
          "Grupos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Items per page. Default 20, no maximum, positive integer up to 9 digits.",
            "schema": {
              "type": "integer",
              "example": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor for the next page. Send back exactly the `nextCursor` you received.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List groups",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupList"
                },
                "example": {
                  "content": [
                    {
                      "id": "120363430328583007-group",
                      "name": "Teste ZAPI-8975"
                    }
                  ],
                  "nextCursor": "8xkQ2"
                }
              }
            }
          },
          "400": {
            "description": "Cursor out of format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "cursor",
                  "message": "cursor is not valid: send back exactly the nextCursor returned by the previous page, or leave it out to start from the first page"
                }
              }
            }
          },
          "422": {
            "description": "Operation not available on the channel, instance not provisioned, inactive subscription or blocked workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "operationNotSupported": {
                    "summary": "Channel without group support in this API",
                    "value": {
                      "error": "operation not supported for this instance"
                    }
                  },
                  "instanceNotProvisioned": {
                    "summary": "Instance not provisioned",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Inactive subscription",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "workspaceBlocked": {
                    "summary": "Blocked workspace",
                    "value": {
                      "error": "You are blocked, contact support.",
                      "message": "You are blocked, contact support. This workspace is blocked on the platform, so sending, editing and group calls are refused until it is unblocked. Talk to support through the panel at https://app.omni.z-api.io."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/InstanceNotFound"
          },
          "502": {
            "$ref": "#/components/responses/ProviderResponseTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/ProviderRateLimited"
          },
          "504": {
            "$ref": "#/components/responses/IntegrationTimeout"
          }
        }
      }
    },
    "/v1/channels/{channelId}/groups/{groupId}": {
      "get": {
        "summary": "Get group",
        "description": "Returns a group's data: name, description, owner, participants, and settings.",
        "operationId": "getGroup",
        "tags": [
          "Grupos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "description": "Group id. From 1 to 128 characters in `[A-Za-z0-9._*-]`, and not `.` or `..`.",
            "schema": {
              "type": "string",
              "example": "120363430328583007-group"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get group",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Group"
                },
                "example": {
                  "id": "120363430328583007-group",
                  "name": "Teste ZAPI-8975",
                  "description": "Grupo de teste",
                  "createdAt": "2026-10-06T19:09:18.429Z",
                  "owner": "5544936180923",
                  "participants": [
                    {
                      "id": "5544936180923",
                      "name": null,
                      "role": "ADMIN"
                    }
                  ],
                  "participantCount": 3,
                  "settings": {
                    "onlyAdminsSendMessages": false,
                    "onlyAdminsEditInfo": true,
                    "joinApprovalRequired": false,
                    "onlyAdminsAddParticipants": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Group id out of format: empty, longer than 128 characters, with a character outside `[A-Za-z0-9._*-]`, or equal to `.` or `..`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "groupId"
                }
              }
            }
          },
          "404": {
            "description": "Group or channel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "groupNotFound": {
                    "summary": "Group not found",
                    "value": {
                      "error": "provider_error",
                      "message": "Error on get group"
                    }
                  },
                  "groupForbidden": {
                    "summary": "Channel is no longer a member of the group",
                    "value": {
                      "error": "provider_error",
                      "message": "GROUP_FORBIDDEN"
                    }
                  },
                  "instanceNotFound": {
                    "summary": "Channel (instance) not found",
                    "value": {
                      "error": "instance not found"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Operation not available on the channel, instance not provisioned, inactive subscription or blocked workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "operationNotSupported": {
                    "summary": "Channel without group support in this API",
                    "value": {
                      "error": "operation not supported for this instance"
                    }
                  },
                  "instanceNotProvisioned": {
                    "summary": "Instance not provisioned",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Inactive subscription",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "workspaceBlocked": {
                    "summary": "Blocked workspace",
                    "value": {
                      "error": "You are blocked, contact support.",
                      "message": "You are blocked, contact support. This workspace is blocked on the platform, so sending, editing and group calls are refused until it is unblocked. Talk to support through the panel at https://app.omni.z-api.io."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "502": {
            "$ref": "#/components/responses/ProviderResponseTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/ProviderRateLimited"
          },
          "504": {
            "$ref": "#/components/responses/IntegrationTimeout"
          }
        }
      }
    },
    "/v1/channels/{channelId}/groups/{groupId}/invite-link": {
      "get": {
        "summary": "Invite link",
        "description": "Returns the group invite link. The channel must be an admin.",
        "operationId": "getGroupInviteLink",
        "tags": [
          "Grupos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "description": "Group id. From 1 to 128 characters in `[A-Za-z0-9._*-]`, and not `.` or `..`.",
            "schema": {
              "type": "string",
              "example": "120363430328583007-group"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invite link",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "inviteLink": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "inviteLink": "https://chat.whatsapp.com/XXXXXXXXXXX"
                }
              }
            }
          },
          "400": {
            "description": "Group id out of format: empty, longer than 128 characters, with a character outside `[A-Za-z0-9._*-]`, or equal to `.` or `..`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "groupId"
                }
              }
            }
          },
          "404": {
            "description": "Group or channel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "groupNotFound": {
                    "summary": "Group not found",
                    "value": {
                      "error": "provider_error",
                      "message": "Group not found"
                    }
                  },
                  "instanceNotFound": {
                    "summary": "Channel (instance) not found",
                    "value": {
                      "error": "instance not found"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Channel is not a group admin, operation not available on the channel, instance not provisioned, inactive subscription or blocked workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "notGroupAdmin": {
                    "summary": "The channel is not a group admin",
                    "value": {
                      "error": "provider_error",
                      "message": "The channel is not an admin of this group, so WhatsApp does not return its invite link. Make the channel an admin of the group, or ask a group admin for the link."
                    }
                  },
                  "operationNotSupported": {
                    "summary": "Channel without group support in this API",
                    "value": {
                      "error": "operation not supported for this instance"
                    }
                  },
                  "instanceNotProvisioned": {
                    "summary": "Instance not provisioned",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Inactive subscription",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "workspaceBlocked": {
                    "summary": "Blocked workspace",
                    "value": {
                      "error": "You are blocked, contact support.",
                      "message": "You are blocked, contact support. This workspace is blocked on the platform, so sending, editing and group calls are refused until it is unblocked. Talk to support through the panel at https://app.omni.z-api.io."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/ProviderRateLimited"
          },
          "504": {
            "$ref": "#/components/responses/IntegrationTimeout"
          }
        }
      }
    },
    "/v1/channels/{channelId}/group-invites/preview": {
      "get": {
        "summary": "Preview by link",
        "description": "Returns a group's preview (name and data) from an invite link, without joining it.",
        "operationId": "previewGroupInvite",
        "tags": [
          "Grupos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "link",
            "in": "query",
            "required": true,
            "description": "Group invite link. Once URL-encoded, it has up to 2,044 characters.",
            "schema": {
              "type": "string",
              "example": "https://chat.whatsapp.com/XXXXXXXXXXX"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Preview by link",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "participantCount": {
                      "type": "integer"
                    }
                  }
                },
                "example": {
                  "id": "120363430328583007-group",
                  "name": "Teste ZAPI-8975",
                  "description": "Grupo de teste",
                  "participantCount": 3
                }
              }
            }
          },
          "400": {
            "description": "Missing, empty or too long link: once URL-encoded, it goes over 2,044 characters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "link"
                }
              }
            }
          },
          "422": {
            "description": "Operation not available on the channel, instance not provisioned, inactive subscription or blocked workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "operationNotSupported": {
                    "summary": "Channel without group support in this API",
                    "value": {
                      "error": "operation not supported for this instance"
                    }
                  },
                  "instanceNotProvisioned": {
                    "summary": "Instance not provisioned",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Inactive subscription",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "workspaceBlocked": {
                    "summary": "Blocked workspace",
                    "value": {
                      "error": "You are blocked, contact support.",
                      "message": "You are blocked, contact support. This workspace is blocked on the platform, so sending, editing and group calls are refused until it is unblocked. Talk to support through the panel at https://app.omni.z-api.io."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/InstanceNotFound"
          },
          "429": {
            "$ref": "#/components/responses/ProviderRateLimited"
          },
          "504": {
            "$ref": "#/components/responses/IntegrationTimeout"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "GroupSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Participant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "MEMBER",
              "ADMIN",
              "OWNER"
            ]
          }
        }
      },
      "Group": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "owner": {
            "type": "string"
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Participant"
            }
          },
          "participantCount": {
            "type": "integer"
          },
          "settings": {
            "type": "object",
            "properties": {
              "onlyAdminsSendMessages": {
                "type": "boolean",
                "nullable": true
              },
              "onlyAdminsEditInfo": {
                "type": "boolean",
                "nullable": true
              },
              "joinApprovalRequired": {
                "type": "boolean",
                "nullable": true
              },
              "onlyAdminsAddParticipants": {
                "type": "boolean",
                "nullable": true
              }
            }
          }
        }
      },
      "GroupList": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroupSummary"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Next-page cursor. It is null only when the page has fewer items than pageSize; a last page with exactly pageSize items is followed by an empty page. The groups cursor (g1:) does not work for contacts."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Secret Key missing or invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Authorization invalid",
              "message": "Authorization invalid: the Authorization header is missing or empty. Send the workspace Secret Key as \"Authorization: Bearer <secret-key>\". See https://developer.omni.z-api.io/en/authentication"
            }
          }
        },
        "headers": {
          "WWW-Authenticate": {
            "description": "Always `Bearer`",
            "schema": {
              "type": "string"
            },
            "example": "Bearer"
          }
        }
      },
      "Forbidden": {
        "description": "IP not on the workspace IP allow list",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "ip_not_allowed",
              "message": "203.0.113.10 not allowed: this workspace only accepts API calls from the IPs on its allow list. The workspace Owner can add this IP under Administration > Security > IP Restriction in the panel (changes take up to 10 minutes to apply), or call from an allowed IP. See https://developer.omni.z-api.io/en/security/ip-restriction"
            }
          }
        }
      },
      "InstanceNotFound": {
        "description": "Channel (instance) not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "instance not found"
            }
          }
        }
      },
      "InstanceUnprocessable": {
        "description": "Instance not provisioned, inactive subscription or blocked workspace",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "instanceNotProvisioned": {
                "summary": "Instance not provisioned",
                "value": {
                  "error": "instance is not provisioned"
                }
              },
              "subscriptionInactive": {
                "summary": "Inactive subscription",
                "value": {
                  "error": "instance subscription is not active"
                }
              },
              "workspaceBlocked": {
                "summary": "Blocked workspace",
                "value": {
                  "error": "You are blocked, contact support.",
                  "message": "You are blocked, contact support. This workspace is blocked on the platform, so sending, editing and group calls are refused until it is unblocked. Talk to support through the panel at https://app.omni.z-api.io."
                }
              }
            }
          }
        }
      },
      "ProviderResponseTooLarge": {
        "description": "Channel answer too large",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "provider_response_too_large",
              "message": "The channel answer is too large. Use a smaller pageSize."
            }
          }
        }
      },
      "ProviderRateLimited": {
        "description": "The channel asked to wait. The `Retry-After` header carries the wait in seconds when the channel sends it. Other channel refusals (`4xx`) arrive with the same status the channel gave and the same body",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before trying again. Present only when the channel sends the wait in seconds",
            "schema": {
              "type": "string"
            },
            "example": "30"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "provider_error"
            }
          }
        }
      },
      "IntegrationTimeout": {
        "description": "The channel ran out of time to answer. The route only reads data: you can repeat the call",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "integration_timeout",
              "message": "The operation took too long to complete. Try again in a few moments."
            }
          }
        }
      }
    }
  }
}
