{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Cancelar suscripción",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/cancel": {
      "delete": {
        "summary": "Cancelar suscripción",
        "description": "Solicita la cancelación de la suscripción del canal. El canal pasa a `CANCELLATION_PROCESS` y sigue activo hasta el final del periodo pagado. El cuerpo es obligatorio: envía al menos `{}`. Requiere el rol ENTERPRISE.",
        "operationId": "cancelSubscription",
        "tags": [
          "Canales"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal (obtenido en Crear canal o Listar canales)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          },
          {
            "name": "cancel",
            "in": "query",
            "required": true,
            "description": "Envía `true` para confirmar la cancelación",
            "schema": {
              "type": "boolean",
              "example": true
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRequest"
              },
              "examples": {
                "withReason": {
                  "summary": "Con motivo de cancelación",
                  "value": {
                    "cancelReason": "El cliente cerró la empresa"
                  }
                },
                "withoutReason": {
                  "summary": "Sin motivo (cuerpo vacío)",
                  "value": {}
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Cancelación solicitada. No se devuelve contenido."
          },
          "400": {
            "description": "Secret Key ausente, mal formada o inexistente, IP fuera de la lista de IPs permitidas o solicitud inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Secret Key inválida",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP fuera de la lista",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  },
                  "bodyMissing": {
                    "summary": "Sin cuerpo",
                    "value": {
                      "error": "Required request body is missing"
                    }
                  },
                  "cancelMissing": {
                    "summary": "Sin el parámetro cancel",
                    "value": {
                      "error": "Required parameter 'cancel' is missing"
                    }
                  },
                  "cancelInvalid": {
                    "summary": "cancel no booleano",
                    "value": {
                      "error": "Invalid value for parameter 'cancel'"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Canal inexistente o de otro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "422": {
            "description": "Cuenta sin el rol ENTERPRISE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Channel subscription requires ENTERPRISE role"
                }
              }
            }
          },
          "502": {
            "description": "Falla de integración. La operación no se completó; vuelve a intentarlo en unos instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Motivo del error"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código estable del error"
          },
          "message": {
            "type": "string",
            "description": "Texto del error, en inglés"
          }
        }
      },
      "CancelRequest": {
        "type": "object",
        "properties": {
          "cancelReason": {
            "type": "string",
            "description": "Motivo de la cancelación (opcional, recomendado para auditoría)"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en Seguridad, en el panel de Z-API Omni. El prefijo `Bearer` es opcional."
      }
    }
  }
}
