{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Partner: cancelar suscripción",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/cancel": {
      "delete": {
        "summary": "Cancelar suscripción (Partner)",
        "description": "Solicita la cancelación de la suscripción del canal. El canal pasa a `CANCELLATION_PROCESS` y sigue activo hasta el final del periodo pagado. Requiere el rol ENTERPRISE.",
        "operationId": "partnerCancelSubscription",
        "tags": [
          "Partners"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal (obtenido con Crear canal)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          },
          {
            "name": "cancel",
            "in": "query",
            "required": true,
            "description": "Debe ser `true` para confirmar la cancelación",
            "schema": {
              "type": "boolean",
              "example": true
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRequest"
              },
              "examples": {
                "withReason": {
                  "summary": "Con motivo de cancelación",
                  "value": {
                    "cancelReason": "El cliente cerró la empresa"
                  }
                }
              }
            }
          },
          "description": "Obligatorio. Para cancelar sin motivo, envía `{}`."
        },
        "responses": {
          "204": {
            "description": "Cancelación solicitada correctamente. No se devuelve contenido."
          },
          "400": {
            "description": "Falta el cuerpo o el parámetro `cancel`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "missingBody": {
                    "summary": "Sin cuerpo",
                    "value": {
                      "error": "Required request body is missing"
                    }
                  },
                  "missingCancel": {
                    "summary": "Sin el parámetro `cancel`",
                    "value": {
                      "error": "Required parameter 'cancel' is missing"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "El canal no existe o pertenece a otro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "403": {
            "description": "Cuenta sin el rol ENTERPRISE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "planRequired": {
                    "value": {
                      "error": "plan_required",
                      "message": "Channel subscription requires ENTERPRISE role: managing channel subscriptions through the API is limited to partner accounts with the ENTERPRISE role. Ask support to enable the role, or manage the subscription in the panel at https://app.omni.z-api.io. See https://developer.omni.z-api.io/en/channels/introduction"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Secret Key rechazada. Consulta los motivos en Autenticación.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "example": "Bearer"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Authorization invalid",
              "message": "Authorization invalid: this Secret Key does not exist or is no longer valid. Copy the current Secret Key under Security in the panel and send it as \"Authorization: Bearer <secret-key>\". See https://developer.omni.z-api.io/en/authentication"
            }
          }
        }
      }
    },
    "schemas": {
      "CancelRequest": {
        "type": "object",
        "properties": {
          "cancelReason": {
            "type": "string",
            "description": "Motivo de la cancelación (opcional, pero recomendado con fines de auditoría)",
            "example": "El cliente cerró la empresa"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en el panel de Seguridad de Omni Z-API"
      }
    }
  }
}
