{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Desactivar canales sociales",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/deactivate-instagram": {
      "post": {
        "summary": "Desactivar Instagram",
        "description": "Desconecta un canal `META_INSTAGRAM` y limpia el vínculo en el proveedor. Sin cuerpo. No requiere ENTERPRISE.",
        "operationId": "deactivateInstagram",
        "tags": [
          "Canales"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal (obtenido en Crear canal o Listar canales)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Con `true`, el canal queda desconectado y se limpia el vínculo con la cuenta, la página o el bot. Con `false`, nada cambia en el canal.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                },
                "example": true
              }
            }
          },
          "400": {
            "description": "Secret Key ausente, mal formada o inexistente, IP fuera de la lista de IPs permitidas o solicitud inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Secret Key inválida",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP fuera de la lista",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Canal inexistente o de otro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "502": {
            "description": "Falla de integración. La operación no se completó; vuelve a intentarlo en unos instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    },
