{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Partner: crear canal",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels": {
      "post": {
        "summary": "Crear canal (Partner)",
        "description": "Crea un canal nuevo en el workspace autenticado. Requiere el rol ENTERPRISE.",
        "operationId": "partnerCreateChannel",
        "tags": [
          "Partners"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChannelRequest"
              },
              "examples": {
                "whatsappMeta": {
                  "summary": "WhatsApp Oficial (Meta)",
                  "value": {
                    "name": "Canal de Vendas",
                    "type": "META_WHATSAPP"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Canal creado correctamente. Con la Secret Key, la respuesta trae `id` y `token`; con el token OAuth de una app autorizada, solo `id`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateChannelResponse"
                },
                "examples": {
                  "secretKey": {
                    "summary": "Autenticado con la Secret Key",
                    "value": {
                      "id": "019E4C54B1B375A28970B605CA9B03C3",
                      "token": "F1B29C3D4E5A6B7C8D9E0F1A2B3C4D5E"
                    }
                  },
                  "oauthApp": {
                    "summary": "Autenticado con el token OAuth de una app",
                    "value": {
                      "id": "019E4C54B1B375A28970B605CA9B03C3"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Petición no válida: falta un campo obligatorio o el tipo no es válido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": 400,
                  "message": "Validation error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "Nombre ya usado por otro canal activo del workspace. La comparación ignora mayúsculas y los espacios de los extremos; los acentos y los espacios internos diferencian. Reconózcalo por el campo `error`, que es estable; `message` siempre está en inglés.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelNameInUseError"
                },
                "example": {
                  "error": "channel_name_in_use",
                  "message": "A channel with this name already exists in this workspace. Pick another one."
                }
              }
            }
          },
          "422": {
            "description": "Regla de negocio incumplida: cuenta sin el rol ENTERPRISE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": 422,
                  "message": "This action requires ENTERPRISE role"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Token no válido o ausente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": 401,
              "message": "Unauthorized"
            }
          }
        }
      }
    },
    "schemas": {
      "CreateChannelRequest": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre del canal",
            "example": "Canal de Vendas"
          },
          "type": {
            "type": "string",
            "description": "Tipo de canal (plataforma)",
            "enum": [
              "META_WHATSAPP",
              "Z_API_WHATSAPP",
              "META_INSTAGRAM",
              "META_MESSENGER",
              "BOT_TELEGRAM"
            ],
            "example": "META_WHATSAPP"
          }
        }
      },
      "CreateChannelResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID único del canal creado. Úsalo como `channelId` en todos los demás endpoints.",
            "example": "019E4C54B1B375A28970B605CA9B03C3"
          },
          "token": {
            "type": "string",
            "description": "Token del canal, el mismo que devuelve `GET /v1/channels/{channelId}`. Úsalo en las rutas de código QR y de estado del canal. Solo está presente cuando la creación se autentica con la Secret Key del workspace; con el token OAuth de una app, la clave no aparece en la respuesta.",
            "example": "F1B29C3D4E5A6B7C8D9E0F1A2B3C4D5E"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ChannelNameInUseError": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "channel_name_in_use"
            ],
            "description": "Código estable del rechazo"
          },
          "message": {
            "type": "string",
            "description": "Texto fijo, siempre en inglés"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en el panel de Seguridad de Omni Z-API"
      }
    }
  }
}
