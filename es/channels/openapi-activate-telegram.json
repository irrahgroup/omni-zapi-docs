{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Activar Telegram",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/activate-telegram": {
      "post": {
        "summary": "Activar Telegram",
        "description": "Finaliza la conexión de un canal `BOT_TELEGRAM` con el token del bot. El campo se llama `token`: envía en él el `botToken` del resultado del SDK. No requiere ENTERPRISE. Si la cuenta ya está activa en el proveedor y el canal está desconectado con suscripción activa (`PAID`, `TRIAL`, `BOLETO_PENDING` o `CANCELLATION_PROCESS`), Z-API Omni deshace la conexión anterior y activa de nuevo por sí solo; en caso contrario, responde `422` con el error del proveedor.",
        "operationId": "activateTelegram",
        "tags": [
          "Canales"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal (obtenido en Crear canal o Listar canales)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivateTelegramRequest"
              },
              "example": {
                "token": "123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canal activado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivateTelegramResponse"
                },
                "example": {
                  "externalId": "123456789",
                  "connected": true,
                  "displayName": "minhaloja_bot"
                }
              }
            }
          },
          "400": {
            "description": "Secret Key ausente, mal formada o inexistente, IP fuera de la lista de IPs permitidas o solicitud inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Secret Key inválida",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP fuera de la lista",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Canal inexistente o de otro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "422": {
            "description": "El proveedor rechazó la activación. El error del proveedor viene en `error`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderError"
                }
              }
            }
          },
          "502": {
            "description": "Falla de integración. La operación no se completó; vuelve a intentarlo en unos instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          },
          "504": {
            "description": "La activación superó el plazo de 50 segundos. Con `integration_timeout`, nada cambió en el canal y puedes repetir. Con `outcome_unknown`, la conexión anterior ya se deshizo y el resultado no se conoce: revisa el canal con Consultar canal antes de repetir.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "examples": {
                  "integrationTimeout": {
                    "summary": "Nada cambió",
                    "value": {
                      "error": "integration_timeout"
                    }
                  },
                  "outcomeUnknown": {
                    "summary": "Resultado desconocido",
                    "value": {
                      "error": "outcome_unknown"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Motivo del error"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código estable del error"
          },
          "message": {
            "type": "string",
            "description": "Texto del error, en inglés"
          }
        }
      },
      "ActivateTelegramRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token del bot, generado por BotFather"
          }
        }
      },
      "ActivateTelegramResponse": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string",
            "description": "ID del bot en Telegram"
          },
          "connected": {
            "type": "boolean",
            "description": "Si el canal quedó conectado"
          },
          "displayName": {
            "type": "string",
            "description": "Usuario del bot"
          }
        }
      },
      "ProviderError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Nombre del error"
                    },
                    "description": {
                      "type": "string",
                      "description": "Texto del error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en Seguridad, en el panel de Z-API Omni. El prefijo `Bearer` es opcional."
      }
    }
  }
}
