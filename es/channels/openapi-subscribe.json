{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Suscribir canal",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/subscribe": {
      "get": {
        "summary": "Suscribir canal",
        "description": "Incluye el canal en la suscripción de la cuenta. Cuando hay un pago pendiente, la respuesta trae la `url` del checkout; cuando la suscripción se actualiza sin checkout, la respuesta trae `type` `SUBSCRIPTION_UPDATED`. Requiere el rol ENTERPRISE.",
        "operationId": "subscribeChannel",
        "tags": [
          "Canales"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal (obtenido en Crear canal o Listar canales)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          },
          {
            "name": "redirectUrl",
            "in": "query",
            "required": false,
            "description": "URL a la que vuelve el checkout después del pago",
            "schema": {
              "type": "string",
              "format": "uri",
              "example": "https://app.suaempresa.com/canais"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Suscripción actualizada o checkout creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscribeResponse"
                },
                "examples": {
                  "subscriptionUpdated": {
                    "summary": "Suscripción actualizada sin checkout",
                    "value": {
                      "type": "SUBSCRIPTION_UPDATED",
                      "message": "Canal activo. El cargo proporcional se incluirá en la próxima factura."
                    }
                  },
                  "checkout": {
                    "summary": "Pago pendiente",
                    "value": {
                      "checkoutId": "cs_a1B2c3D4e5F6",
                      "url": "https://checkout.stripe.com/c/pay/cs_a1B2c3D4e5F6"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Secret Key ausente, mal formada o inexistente, IP fuera de la lista de IPs permitidas o solicitud inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Secret Key inválida",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP fuera de la lista",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Canal inexistente o de otro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "422": {
            "description": "Cuenta sin el rol ENTERPRISE, o regla de cobro incumplida (`CREDIT_LIMIT_EXCEEDED`: se alcanzó el límite de crédito de la cuenta; `SUBSCRIPTION_TERMINATED`: suscripción finalizada, no se pueden añadir canales). En los errores de cobro, el código viene en `error.type`.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/BusinessError"
                    }
                  ]
                },
                "examples": {
                  "enterpriseRequired": {
                    "summary": "Cuenta sin el rol ENTERPRISE",
                    "value": {
                      "error": "Channel subscription requires ENTERPRISE role"
                    }
                  },
                  "creditLimit": {
                    "summary": "Límite de crédito alcanzado",
                    "value": {
                      "error": {
                        "type": "CREDIT_LIMIT_EXCEEDED"
                      }
                    }
                  },
                  "terminated": {
                    "summary": "Suscripción finalizada",
                    "value": {
                      "error": {
                        "type": "SUBSCRIPTION_TERMINATED"
                      }
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Falla de integración. La operación no se completó; vuelve a intentarlo en unos instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Motivo del error"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código estable del error"
          },
          "message": {
            "type": "string",
            "description": "Texto del error, en inglés"
          }
        }
      },
      "SubscribeResponse": {
        "type": "object",
        "properties": {
          "checkoutId": {
            "type": "string",
            "description": "ID del checkout, cuando hay un pago pendiente"
          },
          "url": {
            "type": "string",
            "description": "URL del checkout para completar el pago, cuando hay un pago pendiente"
          },
          "type": {
            "type": "string",
            "description": "`SUBSCRIPTION_UPDATED` cuando la suscripción se actualizó sin checkout",
            "example": "SUBSCRIPTION_UPDATED"
          },
          "message": {
            "type": "string",
            "description": "Mensaje informativo para mostrar al usuario"
          }
        }
      },
      "BusinessError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Código de negocio del error"
              },
              "message": {
                "type": "string",
                "description": "Texto descriptivo del error"
              },
              "details": {
                "description": "Detalles adicionales, cuando los hay"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en Seguridad, en el panel de Z-API Omni. El prefijo `Bearer` es opcional."
      }
    }
  }
}
