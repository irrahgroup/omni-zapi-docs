{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Orígenes del SDK",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "publicKey": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/sdk-info": {
      "get": {
        "summary": "Orígenes del SDK",
        "description": "Devuelve lo que el SDK de conexión necesita para abrir el flujo del canal: el tipo de canal, la app de Meta que se usa y los orígenes permitidos. Se autentica con la **Public Key** en el header `Authorization`, para poder llamarse desde el frontend.",
        "operationId": "getSdkInfo",
        "tags": [
          "Canales"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal (obtenido en Crear canal o Listar canales)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Datos del SDK para el canal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SdkInfo"
                },
                "example": {
                  "middleware": "META_WHATSAPP",
                  "appId": "1234567890123456",
                  "appConfig": "987654321098765",
                  "allowOrigins": [
                    "https://app.suaempresa.com",
                    "http://localhost:3000",
                    "https://app.hubmessage.io",
                    "https://app.omni.z-api.io"
                  ],
                  "appCustom": false,
                  "appInstagramId": null
                }
              }
            }
          },
          "400": {
            "description": "Public Key ausente, mal formada o inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Public Key inválida",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Canal inexistente o de otro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "instanceNotFound": {
                    "summary": "Canal no encontrado",
                    "value": {
                      "error": "Instance not found"
                    }
                  },
                  "appConfigurationNotFound": {
                    "summary": "App no configurada",
                    "value": {
                      "error": "app configuration not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Motivo del error"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código estable del error"
          },
          "message": {
            "type": "string",
            "description": "Texto del error, en inglés"
          }
        }
      },
      "SdkInfo": {
        "type": "object",
        "properties": {
          "middleware": {
            "type": "string",
            "description": "Tipo de canal",
            "enum": [
              "META_WHATSAPP",
              "Z_API_WHATSAPP",
              "META_INSTAGRAM",
              "META_MESSENGER",
              "BOT_TELEGRAM"
            ]
          },
          "appId": {
            "type": "string",
            "description": "ID de la app de Meta que usa el SDK"
          },
          "appConfig": {
            "type": "string",
            "description": "Configuración de la app de Meta que usa el SDK"
          },
          "allowOrigins": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Orígenes permitidos para el SDK: primero los del workspace, después los del panel (`https://app.hubmessage.io` y `https://app.omni.z-api.io`)"
          },
          "appCustom": {
            "type": "boolean",
            "description": "`true` cuando el workspace usa su propia app"
          },
          "appInstagramId": {
            "type": [
              "string",
              "null"
            ],
            "description": "ID de la app de Instagram"
          }
        }
      }
    },
    "securitySchemes": {
      "publicKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Public Key generada en Seguridad, en el panel de Z-API Omni, enviada en el header `Authorization`."
      }
    }
  }
}
