{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Conectar canal Meta WhatsApp",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/connect": {
      "post": {
        "summary": "Conectar canal Meta WhatsApp",
        "description": "Finaliza la conexión de un canal `META_WHATSAPP` con los datos que devuelve el SDK `@omnizapi/connect`. Es exclusiva de WhatsApp Oficial: los otros canales tienen su propia ruta. No requiere ENTERPRISE.",
        "operationId": "connectMetaChannel",
        "tags": [
          "Canales"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal (obtenido en Crear canal o Listar canales)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectChannelRequest"
              },
              "example": {
                "wabaId": "428083093730937",
                "phoneId": "123456789012345",
                "code": "ABC123DEF456",
                "coexistence": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado de la conexión. `success` tiene el mismo valor que `connected`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectChannelResponse"
                },
                "example": {
                  "phoneId": "123456789012345",
                  "connected": true,
                  "success": true,
                  "isCoexistence": false,
                  "phoneConnected": "5511999999999",
                  "businessName": "Minha Empresa"
                }
              }
            }
          },
          "400": {
            "description": "Secret Key ausente, mal formada o inexistente, IP fuera de la lista de IPs permitidas o solicitud inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Secret Key inválida",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP fuera de la lista",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  },
                  "wabaIdRequired": {
                    "summary": "Sin wabaId",
                    "value": {
                      "error": "wabaId is required"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Canal inexistente o de otro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "409": {
            "description": "El mismo número ya está conectado y funcionando en Meta. La API rechaza y no gasta el `code`. Para renovar la conexión del mismo número, desconecta antes con `PUT /v1/channels/{channelId}/disconnect`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "channel_already_connected",
                  "message": "Channel already connected"
                }
              }
            }
          },
          "502": {
            "description": "Falla de integración. La operación no se completó; vuelve a intentarlo en unos instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          },
          "504": {
            "description": "La conexión superó el plazo y el resultado no se conoce. Revisa el estado del canal con Consultar canal antes de repetir.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "outcome_unknown"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Motivo del error"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código estable del error"
          },
          "message": {
            "type": "string",
            "description": "Texto del error, en inglés"
          }
        }
      },
      "ConnectChannelRequest": {
        "type": "object",
        "required": [
          "wabaId"
        ],
        "properties": {
          "wabaId": {
            "type": "string",
            "description": "ID de la cuenta de WhatsApp Business (WABA) elegida en el Embedded Signup. Es el único campo que valida la API."
          },
          "phoneId": {
            "type": "string",
            "description": "ID del número elegido. Necesario para completar la conexión."
          },
          "code": {
            "type": "string",
            "description": "Código de autorización que devuelve Meta. Necesario para completar la conexión."
          },
          "coexistence": {
            "type": "boolean",
            "description": "Si el número se conectó en coexistencia con la app de WhatsApp Business"
          }
        }
      },
      "ConnectChannelResponse": {
        "type": "object",
        "properties": {
          "phoneId": {
            "type": "string",
            "description": "ID del número conectado"
          },
          "connected": {
            "type": "boolean",
            "description": "Si el canal quedó conectado"
          },
          "success": {
            "type": "boolean",
            "description": "Mismo valor que `connected`"
          },
          "isCoexistence": {
            "type": "boolean",
            "description": "Si la conexión es en coexistencia"
          },
          "phoneConnected": {
            "type": "string",
            "description": "Número conectado, con código de país"
          },
          "businessName": {
            "type": "string",
            "description": "Nombre de la empresa en Meta"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en Seguridad, en el panel de Z-API Omni. El prefijo `Bearer` es opcional."
      }
    }
  }
}
