{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Conectar canal",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/connect": {
      "post": {
        "summary": "Conectar canal Meta WhatsApp",
        "description": "Finaliza la conexión de un canal **META_WHATSAPP** con los datos devueltos por el SDK `@omnizapi/connect`. Exclusivo para canales de la API Oficial de WhatsApp (Meta). Para canales Instagram, Messenger y Telegram, usa las rutas `activate-*` ([Activar canal](/es/channels/activate-channel)).",
        "operationId": "connectMetaChannel",
        "tags": [
          "Canales"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal (obtenido con Crear canal)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectChannelRequest"
              },
              "example": {
                "wabaId": "428083093730937",
                "phoneId": "123456789012345",
                "code": "ABC123DEF456",
                "coexistence": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canal conectado correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectChannelResponse"
                },
                "example": {
                  "phoneId": "123456789012345",
                  "connected": true,
                  "success": true,
                  "isCoexistence": false,
                  "phoneConnected": "5511999999999",
                  "businessName": "Mi Tienda"
                }
              }
            }
          },
          "400": {
            "description": "Falta `wabaId`. Esta ruta solo vale para canales `META_WHATSAPP`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "wabaId is required"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "El canal no existe o pertenece a otro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "409": {
            "description": "Canal ya conectado al mismo `phoneId`, y Meta confirma que el número funciona. Nada cambia en el canal y el `code` no se usa. Para renovar la conexión del mismo número, desconecte antes. Reconózcalo por el campo `error`, que es estable; `message` siempre está en inglés.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelAlreadyConnectedError"
                },
                "example": {
                  "error": "channel_already_connected",
                  "message": "Channel already connected"
                }
              }
            }
          },
          "422": {
            "description": "Rechazo del proveedor. El campo `error` trae el envoltorio del proveedor, con el nombre del error en `errors[0].name`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderError"
                }
              }
            }
          },
          "502": {
            "description": "Servicio interno no disponible. Inténtalo de nuevo en unos instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Secret Key rechazada. Consulta los motivos en Autenticación.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "example": "Bearer"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Authorization invalid",
              "message": "Authorization invalid: this Secret Key does not exist or is no longer valid. Copy the current Secret Key under Security in the panel and send it as \"Authorization: Bearer <secret-key>\". See https://developer.omni.z-api.io/en/authentication"
            }
          }
        }
      }
    },
    "schemas": {
      "ConnectChannelRequest": {
        "type": "object",
        "required": [
          "wabaId"
        ],
        "properties": {
          "wabaId": {
            "type": "string",
            "description": "ID de la cuenta de WhatsApp Business"
          },
          "phoneId": {
            "type": "string",
            "description": "ID del número de teléfono"
          },
          "code": {
            "type": "string",
            "description": "Código de autorización generado por WhatsApp"
          },
          "coexistence": {
            "type": "boolean",
            "description": "Indica si el número está en modo de coexistencia"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ChannelAlreadyConnectedError": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "channel_already_connected"
            ],
            "description": "Código estable del rechazo"
          },
          "message": {
            "type": "string",
            "description": "Texto fijo, siempre en inglés"
          }
        }
      },
      "ConnectChannelResponse": {
        "type": "object",
        "properties": {
          "phoneId": {
            "type": "string",
            "description": "ID del número de teléfono"
          },
          "connected": {
            "type": "boolean",
            "description": "Si el canal quedó conectado"
          },
          "success": {
            "type": "boolean",
            "description": "Si la operación se realizó correctamente"
          },
          "isCoexistence": {
            "type": "boolean",
            "description": "Si el número está en modo de coexistencia"
          },
          "phoneConnected": {
            "type": "string",
            "description": "Número conectado"
          },
          "businessName": {
            "type": "string",
            "description": "Nombre de la cuenta comercial"
          }
        }
      },
      "ProviderError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "description": "Envoltorio de error del proveedor",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en el panel de Seguridad de Omni Z-API"
      }
    }
  }
}
