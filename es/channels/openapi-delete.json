{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Eliminar canal",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}": {
      "delete": {
        "summary": "Eliminar canal",
        "description": "Elimina un canal. Solo se permite eliminar con el canal desconectado y sin suscripción activa. Requiere el rol ENTERPRISE.",
        "operationId": "deleteChannel",
        "tags": [
          "Canales"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal (obtenido en Crear canal o Listar canales)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteRequest"
              },
              "example": {
                "cancelReason": "El cliente cerró la empresa"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Canal eliminado. No se devuelve contenido."
          },
          "400": {
            "description": "Secret Key ausente, mal formada o inexistente, IP fuera de la lista de IPs permitidas o solicitud inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Secret Key inválida",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP fuera de la lista",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Canal inexistente o de otro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "422": {
            "description": "Cuenta sin el rol ENTERPRISE, o regla de negocio incumplida. En los errores de negocio, el código viene en `error.type`.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/BusinessError"
                    }
                  ]
                },
                "examples": {
                  "enterpriseRequired": {
                    "summary": "Cuenta sin el rol ENTERPRISE",
                    "value": {
                      "error": "Channel deletion requires ENTERPRISE role"
                    }
                  },
                  "channelConnected": {
                    "summary": "Canal todavía conectado",
                    "value": {
                      "error": {
                        "type": "INSTANCE_STILL_CONNECTED"
                      }
                    }
                  },
                  "activeSubscription": {
                    "summary": "Canal con suscripción activa (PAID o CANCELLATION_PROCESS)",
                    "value": {
                      "error": {
                        "type": "INSTANCE_HAS_ACTIVE_SUBSCRIPTION"
                      }
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Falla de integración. La operación no se completó; vuelve a intentarlo en unos instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Motivo del error"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código estable del error"
          },
          "message": {
            "type": "string",
            "description": "Texto del error, en inglés"
          }
        }
      },
      "DeleteRequest": {
        "type": "object",
        "properties": {
          "cancelReason": {
            "type": "string",
            "description": "Motivo de la eliminación (opcional, recomendado para auditoría)"
          }
        }
      },
      "BusinessError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Código de negocio del error"
              },
              "message": {
                "type": "string",
                "description": "Texto descriptivo del error"
              },
              "details": {
                "description": "Detalles adicionales, cuando los hay"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en Seguridad, en el panel de Z-API Omni. El prefijo `Bearer` es opcional."
      }
    }
  }
}
