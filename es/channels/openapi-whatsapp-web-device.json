{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Consultar dispositivo de WhatsApp Web",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/zapi/device": {
      "get": {
        "summary": "Consultar dispositivo de WhatsApp Web",
        "description": "Consulta qué número y qué dispositivo están vinculados a un canal `Z_API_WHATSAPP` (WhatsApp Web). Llama siempre desde el backend. Consulta [Estado y dispositivo de WhatsApp Web](/es/channels/whatsapp-web-status).",
        "operationId": "getWhatsAppWebDevice",
        "tags": [
          "Canales"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal `Z_API_WHATSAPP`",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dispositivo conectado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhatsAppWebDeviceResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "El canal no existe o pertenece a otro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "422": {
            "description": "El proveedor rechazó la consulta. El campo `error` trae el envoltorio del proveedor, con el nombre del error en `error.errors[0].name`, o, sin envoltorio, un texto genérico.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ProviderError"
                    },
                    {
                      "type": "object",
                      "required": [
                        "error"
                      ],
                      "properties": {
                        "error": {
                          "type": "string",
                          "description": "Texto genérico, cuando el rechazo del proveedor viene sin envoltorio",
                          "example": "The operation could not be completed right now. Try again in a few moments."
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "502": {
            "description": "Servicio interno no disponible. Inténtalo de nuevo en unos instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Secret Key rechazada. Consulta los motivos en Autenticación.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "example": "Bearer"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Authorization invalid",
              "message": "Authorization invalid: this Secret Key does not exist or is no longer valid. Copy the current Secret Key under Security in the panel and send it as \"Authorization: Bearer <secret-key>\". See https://developer.omni.z-api.io/en/authentication"
            }
          }
        }
      },
      "Forbidden": {
        "description": "IP fuera de la lista del workspace (ver [Restricción de IP](/es/security/ip-restriction))",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "ip_not_allowed",
              "message": "203.0.113.10 not allowed: this workspace only accepts API calls from the IPs on its allow list. The workspace Owner can add this IP under Administration > Security > IP Restriction in the panel (changes take up to 10 minutes to apply), or call from an allowed IP. See https://developer.omni.z-api.io/en/security/ip-restriction"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ProviderError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "description": "Envoltorio de error del proveedor",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "WhatsAppWebDeviceResponse": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "Número conectado"
          },
          "imgUrl": {
            "type": "string",
            "description": "URL de la foto de perfil"
          },
          "name": {
            "type": "string",
            "description": "Nombre del perfil"
          },
          "device": {
            "type": "object",
            "properties": {
              "sessionName": {
                "type": "string",
                "description": "Nombre de la sesión"
              },
              "deviceModel": {
                "type": "string",
                "description": "Modelo del dispositivo"
              }
            }
          },
          "originalDevice": {
            "description": "Dispositivo original"
          },
          "sessionId": {
            "type": "string",
            "description": "ID de la sesión"
          },
          "isBusiness": {
            "type": "boolean",
            "description": "Si la cuenta es de WhatsApp Business"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en el panel de Seguridad de Omni Z-API"
      }
    }
  }
}
