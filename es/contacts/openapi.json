{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Contactos",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/contacts": {
      "get": {
        "summary": "Listar contactos",
        "description": "Lista los contactos de la agenda del número, paginada por cursor. Solo en el canal WhatsApp Web (`Z_API_WHATSAPP`).",
        "operationId": "listContacts",
        "tags": [
          "Contatos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Cantidad por página. Predeterminado 20, sin máximo. Entero positivo de hasta 9 dígitos.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "example": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Cursor opaco de la página siguiente. Devuelve exactamente el `nextCursor` recibido; omítelo para empezar desde el inicio.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de contactos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactList"
                },
                "example": {
                  "content": [
                    {
                      "id": "554497294996",
                      "phone": "554497294996",
                      "name": "Contato de teste",
                      "shortName": "Contato",
                      "profileName": "Contato de teste",
                      "vcardName": "Contato de teste"
                    },
                    {
                      "id": "123330724110591@lid",
                      "phone": null,
                      "name": "Contato por LID",
                      "shortName": "Contato",
                      "profileName": "Contato por LID",
                      "vcardName": "Contato por LID"
                    }
                  ],
                  "nextCursor": "8xkQ2"
                }
              }
            }
          },
          "400": {
            "description": "Parámetro fuera de formato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "cursor": {
                    "summary": "cursor inválido",
                    "value": {
                      "error": "invalid_request",
                      "field": "cursor",
                      "message": "cursor is not valid: send back exactly the nextCursor returned by the previous page, or leave it out to start from the first page"
                    }
                  },
                  "pageSize": {
                    "summary": "pageSize inválido",
                    "value": {
                      "error": "invalid_request",
                      "field": "pageSize"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Instancia no aprovisionada, suscripción inactiva, workspace bloqueado u operación no admitida en el canal, verificados en este orden (el `404` de canal inexistente viene antes que todos). Solo el 422 de operación no admitida trae `message`, y es para lectura: trátalo por el `error`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "instanceNotProvisioned": {
                    "summary": "Instancia no aprovisionada",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Suscripción inactiva",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "blockedWorkspace": {
                    "summary": "Workspace bloqueado",
                    "value": {
                      "error": "You are blocked, contact support."
                    }
                  },
                  "operationNotSupportedMeta": {
                    "summary": "Canal WhatsApp Oficial (Meta)",
                    "value": {
                      "error": "operation not supported for this instance",
                      "message": "Listing contacts is not supported on WhatsApp official API (Meta) channels: the official API does not give access to the contacts of the number. Use a WhatsApp Web channel for contacts; GET /v1/channels/{id}/contacts/capabilities lists what each channel supports."
                    }
                  },
                  "operationNotSupportedOtherChannel": {
                    "summary": "Canal Telegram (Instagram y Messenger: mismo texto, con el nombre del canal)",
                    "value": {
                      "error": "operation not supported for this instance",
                      "message": "Listing contacts is not supported on Telegram channels: contacts belong to a WhatsApp number, and this channel has none. Use a WhatsApp Web channel for contacts; GET /v1/channels/{id}/contacts/capabilities lists what each channel supports."
                    }
                  },
                  "operationNotSupportedNoType": {
                    "summary": "Canal aún sin tipo",
                    "value": {
                      "error": "operation not supported for this instance",
                      "message": "Listing contacts is not supported on this instance: it is not connected to any channel type yet. Use a WhatsApp Web channel for contacts; GET /v1/channels/{id}/contacts/capabilities lists what each channel supports."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/InstanceNotFound"
          },
          "502": {
            "description": "Respuesta del canal demasiado grande",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "provider_response_too_large",
                  "message": "The channel answer is too large. Use a smaller pageSize."
                }
              }
            }
          }
        }
      }
    },
    "/v1/channels/{channelId}/contacts/{contact}": {
      "get": {
        "summary": "Consultar contacto",
        "description": "Devuelve los datos de un contacto por teléfono (solo dígitos, con código de país y de área), por `{phone}@c.us` o por el LID.",
        "operationId": "getContact",
        "tags": [
          "Contatos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "contact",
            "in": "path",
            "required": true,
            "description": "Teléfono del contacto (solo dígitos, con código de país y de área), `{phone}@c.us` o LID.",
            "schema": {
              "type": "string",
              "example": "554497294996"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Datos del contacto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactDetail"
                },
                "example": {
                  "id": "554497294996",
                  "phone": "554497294996",
                  "name": "Contato de teste",
                  "shortName": "Contato",
                  "profileName": "Contato de teste",
                  "vcardName": "Contato de teste",
                  "about": "Disponível",
                  "photoUrl": "https://pps.whatsapp.net/v/t61.24694-24/..."
                }
              }
            }
          },
          "400": {
            "description": "Parámetro fuera de formato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalid": {
                    "summary": "Id inválido",
                    "value": {
                      "error": "invalid_request",
                      "field": "contact",
                      "message": "contact is not valid: send the phone number with country code and area code, digits only (8 to 15 digits, for example 5511999999999), or the contact LID (for example 999999999999999@lid)"
                    }
                  },
                  "notFound": {
                    "summary": "Número no reconocido por el canal",
                    "value": {
                      "error": "provider_error",
                      "message": "The channel did not recognize this contact: check the phone number (country code and area code, digits only) or the LID."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Instancia no aprovisionada, suscripción inactiva, workspace bloqueado u operación no admitida en el canal, verificados en este orden (el `404` de canal inexistente viene antes que todos). Solo el 422 de operación no admitida trae `message`, y es para lectura: trátalo por el `error`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "instanceNotProvisioned": {
                    "summary": "Instancia no aprovisionada",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Suscripción inactiva",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "blockedWorkspace": {
                    "summary": "Workspace bloqueado",
                    "value": {
                      "error": "You are blocked, contact support."
                    }
                  },
                  "operationNotSupportedMeta": {
                    "summary": "Canal WhatsApp Oficial (Meta)",
                    "value": {
                      "error": "operation not supported for this instance",
                      "message": "Reading a contact is not supported on WhatsApp official API (Meta) channels: the official API does not give access to the contacts of the number. Use a WhatsApp Web channel for contacts; GET /v1/channels/{id}/contacts/capabilities lists what each channel supports."
                    }
                  },
                  "operationNotSupportedOtherChannel": {
                    "summary": "Canal Telegram (Instagram y Messenger: mismo texto, con el nombre del canal)",
                    "value": {
                      "error": "operation not supported for this instance",
                      "message": "Reading a contact is not supported on Telegram channels: contacts belong to a WhatsApp number, and this channel has none. Use a WhatsApp Web channel for contacts; GET /v1/channels/{id}/contacts/capabilities lists what each channel supports."
                    }
                  },
                  "operationNotSupportedNoType": {
                    "summary": "Canal aún sin tipo",
                    "value": {
                      "error": "operation not supported for this instance",
                      "message": "Reading a contact is not supported on this instance: it is not connected to any channel type yet. Use a WhatsApp Web channel for contacts; GET /v1/channels/{id}/contacts/capabilities lists what each channel supports."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/InstanceNotFound"
          },
          "502": {
            "description": "Respuesta del canal demasiado grande",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "provider_response_too_large",
                  "message": "The channel answer is too large. Use a smaller pageSize."
                }
              }
            }
          }
        }
      }
    },
    "/v1/channels/{channelId}/contacts/{contact}/photo": {
      "get": {
        "summary": "Foto del contacto",
        "description": "Devuelve la URL de la foto de perfil del contacto, o `null` cuando no hay foto.",
        "operationId": "getContactPhoto",
        "tags": [
          "Contatos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "contact",
            "in": "path",
            "required": true,
            "description": "Teléfono del contacto (solo dígitos, con código de país y de área), `{phone}@c.us` o LID.",
            "schema": {
              "type": "string",
              "example": "5544936180923"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "URL de la foto (o `null`)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "photoUrl": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                },
                "examples": {
                  "withPhoto": {
                    "value": {
                      "photoUrl": "https://pps.whatsapp.net/v/t61.24694-24/..."
                    }
                  },
                  "noPhoto": {
                    "value": {
                      "photoUrl": null
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parámetro fuera de formato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "contact",
                  "message": "contact is not valid: send the phone number with country code and area code, digits only (8 to 15 digits, for example 5511999999999), or the contact LID (for example 999999999999999@lid)"
                }
              }
            }
          },
          "422": {
            "description": "Instancia no aprovisionada, suscripción inactiva, workspace bloqueado u operación no admitida en el canal, verificados en este orden (el `404` de canal inexistente viene antes que todos). Solo el 422 de operación no admitida trae `message`, y es para lectura: trátalo por el `error`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "instanceNotProvisioned": {
                    "summary": "Instancia no aprovisionada",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Suscripción inactiva",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "blockedWorkspace": {
                    "summary": "Workspace bloqueado",
                    "value": {
                      "error": "You are blocked, contact support."
                    }
                  },
                  "operationNotSupportedMeta": {
                    "summary": "Canal WhatsApp Oficial (Meta)",
                    "value": {
                      "error": "operation not supported for this instance",
                      "message": "Reading a contact photo is not supported on WhatsApp official API (Meta) channels: the official API does not give the profile photo of a contact. Use a WhatsApp Web channel for contacts; GET /v1/channels/{id}/contacts/capabilities lists what each channel supports."
                    }
                  },
                  "operationNotSupportedOtherChannel": {
                    "summary": "Canal Telegram (Instagram y Messenger: mismo texto, con el nombre del canal)",
                    "value": {
                      "error": "operation not supported for this instance",
                      "message": "Reading a contact photo is not supported on Telegram channels: contacts belong to a WhatsApp number, and this channel has none. Use a WhatsApp Web channel for contacts; GET /v1/channels/{id}/contacts/capabilities lists what each channel supports."
                    }
                  },
                  "operationNotSupportedNoType": {
                    "summary": "Canal aún sin tipo",
                    "value": {
                      "error": "operation not supported for this instance",
                      "message": "Reading a contact photo is not supported on this instance: it is not connected to any channel type yet. Use a WhatsApp Web channel for contacts; GET /v1/channels/{id}/contacts/capabilities lists what each channel supports."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/InstanceNotFound"
          },
          "502": {
            "description": "Respuesta del canal demasiado grande",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "provider_response_too_large",
                  "message": "The channel answer is too large. Use a smaller pageSize."
                }
              }
            }
          }
        }
      }
    },
    "/v1/channels/{channelId}/contacts/check": {
      "post": {
        "summary": "Verificar números",
        "description": "Verifica, en lote, si cada número tiene WhatsApp.",
        "operationId": "checkContacts",
        "tags": [
          "Contatos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "contacts"
                ],
                "properties": {
                  "contacts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Números a verificar (solo dígitos, con código de país y de área). De 1 a 50.000 elementos; fuera de eso, responde 400 con `field` `contacts`.",
                    "minItems": 1,
                    "maxItems": 50000
                  }
                }
              },
              "example": {
                "contacts": [
                  "554497294996",
                  "5511900000001"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado por número",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResult"
                },
                "example": {
                  "results": [
                    {
                      "contact": "554497294996",
                      "exists": true,
                      "phone": "554497294996",
                      "lid": "123330724110591@lid"
                    },
                    {
                      "contact": "5511900000001",
                      "exists": false,
                      "phone": null,
                      "lid": null
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Parámetro fuera de formato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "contacts"
                }
              }
            }
          },
          "413": {
            "description": "Cuerpo por encima del límite (hasta 10 MiB)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "payload_too_large"
                }
              }
            }
          },
          "422": {
            "description": "Instancia no aprovisionada, suscripción inactiva, workspace bloqueado u operación no admitida en el canal, verificados en este orden (el `404` de canal inexistente viene antes que todos). Solo el 422 de operación no admitida trae `message`, y es para lectura: trátalo por el `error`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "instanceNotProvisioned": {
                    "summary": "Instancia no aprovisionada",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Suscripción inactiva",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "blockedWorkspace": {
                    "summary": "Workspace bloqueado",
                    "value": {
                      "error": "You are blocked, contact support."
                    }
                  },
                  "operationNotSupportedMeta": {
                    "summary": "Canal WhatsApp Oficial (Meta)",
                    "value": {
                      "error": "operation not supported for this instance",
                      "message": "Checking whether numbers have WhatsApp is not supported on WhatsApp official API (Meta) channels: the official API cannot check whether a number has WhatsApp. Use a WhatsApp Web channel for contacts; GET /v1/channels/{id}/contacts/capabilities lists what each channel supports."
                    }
                  },
                  "operationNotSupportedOtherChannel": {
                    "summary": "Canal Telegram (Instagram y Messenger: mismo texto, con el nombre del canal)",
                    "value": {
                      "error": "operation not supported for this instance",
                      "message": "Checking whether numbers have WhatsApp is not supported on Telegram channels: contacts belong to a WhatsApp number, and this channel has none. Use a WhatsApp Web channel for contacts; GET /v1/channels/{id}/contacts/capabilities lists what each channel supports."
                    }
                  },
                  "operationNotSupportedNoType": {
                    "summary": "Canal aún sin tipo",
                    "value": {
                      "error": "operation not supported for this instance",
                      "message": "Checking whether numbers have WhatsApp is not supported on this instance: it is not connected to any channel type yet. Use a WhatsApp Web channel for contacts; GET /v1/channels/{id}/contacts/capabilities lists what each channel supports."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Respuesta del canal demasiado grande",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "provider_response_too_large",
                  "message": "Send fewer contacts per request."
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/InstanceNotFound"
          }
        }
      }
    },
    "/v1/channels/{channelId}/contacts/capabilities": {
      "get": {
        "summary": "Capacidades de contacto",
        "description": "Lista las operaciones de contacto disponibles en el canal. En el canal Meta, la lista viene vacía.",
        "operationId": "contactCapabilities",
        "tags": [
          "Contatos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operaciones del canal",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "operations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "examples": {
                  "whatsappWeb": {
                    "value": {
                      "type": "Z_API_WHATSAPP",
                      "operations": [
                        "LIST_CONTACTS",
                        "GET_CONTACT",
                        "GET_CONTACT_PHOTO",
                        "CHECK_CONTACTS"
                      ]
                    }
                  },
                  "meta": {
                    "value": {
                      "type": "META_WHATSAPP",
                      "operations": []
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/InstanceNotFound"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ContactList": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContactListItem"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Cursor de la página siguiente. Viene `null` solo cuando la página tiene menos elementos que `pageSize`; si la última página tiene exactamente `pageSize` elementos, la siguiente viene vacía."
          }
        }
      },
      "CheckResult": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "contact": {
                  "type": "string"
                },
                "exists": {
                  "type": "boolean"
                },
                "phone": {
                  "type": "string",
                  "nullable": true
                },
                "lid": {
                  "type": "string",
                  "nullable": true
                }
              }
            }
          }
        }
      },
      "ContactListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
