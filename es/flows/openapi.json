{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Flows de WhatsApp",
    "description": "API para crear y gestionar WhatsApp Flows (formularios nativos dentro de la conversación)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/whatsapp/businesses/{wabaId}/flows": {
      "get": {
        "summary": "Listar flows",
        "description": "Devuelve todos los flows de la WABA de una vez, con nombre, categorías y estado de publicación. No hay paginación. Con `sync=true`, sincroniza con Meta antes de listar.",
        "operationId": "listFlows",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "ID de la WABA (obtenido con Listar WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "sync",
            "in": "query",
            "required": false,
            "description": "Cuando es `true`, sincroniza los flows con Meta antes de listar. Sin él, la lista sale del registro de la plataforma. La lista viene completa, sin paginación",
            "schema": {
              "type": "boolean",
              "default": false,
              "example": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de flows",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlowListResponse"
                },
                "example": {
                  "data": [
                    {
                      "id": "1122334455667788",
                      "name": "agendamento_consulta",
                      "categories": [
                        "APPOINTMENT_BOOKING"
                      ],
                      "status": "PUBLISHED",
                      "endpoint_uri": null,
                      "validation_errors": []
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "description": "Meta o la plataforma rechazó la operación. Mira el formato del cuerpo en el ejemplo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Rechazo de Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Rechazo sin detalle",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/IntegrationTimeout"
          }
        }
      },
      "post": {
        "summary": "Crear flow",
        "description": "Crea un flow. El `flow_json` es la definición de las pantallas en JSON, enviada como string. Con `publish: true` el flow nace publicado; si no, queda en `DRAFT`.",
        "operationId": "createFlow",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "ID de la WABA (obtenido con Listar WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFlowRequest"
              },
              "example": {
                "name": "agendamento_consulta",
                "categories": [
                  "APPOINTMENT_BOOKING"
                ],
                "flow_json": "{\"version\": \"7.0\", \"routing_model\": {\"WELCOME\": [\"DONE\"], \"DONE\": []}, \"screens\": [{\"id\": \"WELCOME\", \"title\": \"Agendamento\", \"layout\": {\"type\": \"SingleColumnLayout\", \"children\": [{\"type\": \"TextHeading\", \"text\": \"Escolha um horario\"}, {\"type\": \"Form\", \"name\": \"form\", \"children\": [{\"type\": \"TextInput\", \"name\": \"nome\", \"label\": \"Seu nome\", \"input-type\": \"text\", \"required\": true}, {\"type\": \"DatePicker\", \"name\": \"data\", \"label\": \"Data\"}, {\"type\": \"Footer\", \"label\": \"Continuar\", \"on-click-action\": {\"name\": \"navigate\", \"next\": {\"type\": \"screen\", \"name\": \"DONE\"}, \"payload\": {}}}]}]}}, {\"id\": \"DONE\", \"title\": \"Pronto\", \"terminal\": true, \"success\": true, \"layout\": {\"type\": \"SingleColumnLayout\", \"children\": [{\"type\": \"TextBody\", \"text\": \"Agendamento confirmado.\"}, {\"type\": \"Footer\", \"label\": \"Fechar\", \"on-click-action\": {\"name\": \"complete\", \"payload\": {}}}]}}]}",
                "publish": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flow creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                },
                "example": {
                  "id": "1122334455667788",
                  "name": "agendamento_consulta",
                  "categories": [
                    "APPOINTMENT_BOOKING"
                  ],
                  "status": "DRAFT",
                  "endpoint_uri": null,
                  "validation_errors": []
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/FlowBadRequest"
          },
          "422": {
            "description": "Meta o la plataforma rechazó la operación: `flow_json` mal formado, categoría inexistente u otra regla de Meta. Mira el formato del cuerpo en el ejemplo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Rechazo de Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Rechazo sin detalle",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/OutcomeUnknown"
          }
        }
      }
    },
    "/whatsapp/businesses/{wabaId}/flows/sync": {
      "post": {
        "summary": "Sincronizar flows",
        "description": "Fuerza la sincronización de los flows con Meta, actualizando estados e incidencias de validación.",
        "operationId": "syncFlows",
