  "components": {
    "schemas": {
      "CreateFlowRequest": {
        "type": "object",
        "required": [
          "name",
          "categories",
          "flow_json"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre del flow",
            "example": "agendamento_consulta"
          },
          "categories": {
            "type": "array",
            "description": "Categorías del flow (Meta las usa en la revisión)",
            "items": {
              "type": "string",
              "enum": [
                "SIGN_UP",
                "SIGN_IN",
                "APPOINTMENT_BOOKING",
                "LEAD_GENERATION",
                "CONTACT_US",
                "CUSTOMER_SUPPORT",
                "SURVEY",
                "OTHER"
              ]
            },
            "example": [
              "APPOINTMENT_BOOKING"
            ]
          },
          "flow_json": {
            "type": "string",
            "description": "Definición de las pantallas en JSON, enviada como **string**"
          },
          "endpoint_uri": {
            "type": "string",
            "description": "URL de tu endpoint, obligatoria solo para los flows con `data_exchange`",
            "example": "https://app.suempresa.com/flows/callback"
          },
          "publish": {
            "type": "boolean",
            "description": "Cuando es `true`, publica el flow ya en la creación",
            "default": false
          }
        }
      },
      "UpdateFlowRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre del flow"
          },
          "categories": {
            "type": "array",
            "description": "Categorías del flow (Meta las usa en la revisión)",
            "items": {
              "type": "string",
              "enum": [
                "SIGN_UP",
                "SIGN_IN",
                "APPOINTMENT_BOOKING",
                "LEAD_GENERATION",
                "CONTACT_US",
                "CUSTOMER_SUPPORT",
                "SURVEY",
                "OTHER"
              ]
            }
          },
          "flow_json": {
            "type": "string",
            "description": "Definición de las pantallas en JSON, enviada como **string**"
          },
          "endpoint_uri": {
            "type": "string",
            "description": "URL de tu endpoint, obligatoria solo para los flows con `data_exchange`"
          }
        }
      },
      "Flow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID del flow"
          },
          "name": {
            "type": "string",
            "description": "Nombre del flow"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SIGN_UP",
                "SIGN_IN",
                "APPOINTMENT_BOOKING",
                "LEAD_GENERATION",
                "CONTACT_US",
                "CUSTOMER_SUPPORT",
                "SURVEY",
                "OTHER"
              ]
            },
            "description": "Categorías del flow (Meta las usa en la revisión)"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "DEPRECATED",
              "BLOCKED",
              "THROTTLED"
            ],
            "description": "Estado de publicación"
          },
          "endpoint_uri": {
            "type": "string",
            "nullable": true,
            "description": "URL de tu endpoint, obligatoria solo para los flows con `data_exchange`"
          },
          "flow_json": {
            "type": "string",
            "description": "Definición de las pantallas en JSON, enviada como **string**"
          },
          "validation_errors": {
            "type": "array",
            "description": "Incidencias de validación devueltas por Meta",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Clave de la incidencia"
                },
                "value": {
                  "type": "string",
                  "description": "Detalle de la incidencia"
                }
              }
            }
          }
        }
      },
      "FlowListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "description": "Lista de flows",
            "items": {
              "$ref": "#/components/schemas/Flow"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código o mensaje del error"
          },
          "message": {
            "type": "string",
            "description": "Descripción del error"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código del error"
          },
          "message": {
            "type": "string",
            "description": "Mensaje para quien integra"
          }
        }
      },
      "UnprocessableEntity": {
        "type": "object",
        "properties": {
          "error": {
            "description": "Detalle del rechazo (objeto) o, cuando no hay detalle, el mensaje en texto.",
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "timestamp": {
                    "type": "string",
                    "description": "Momento del rechazo"
                  },
                  "status": {
                    "type": "integer",
                    "description": "Status HTTP informado en el detalle del rechazo"
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "description": "Código de error de Meta"
                        },
                        "name": {
                          "type": "string",
                          "description": "Tipo del error (ej: META_WHATSAPP_ERROR)"
                        },
                        "subCode": {
                          "type": "string",
                          "description": "Subcódigo de error de Meta"
                        },
                        "message": {
                          "type": "string",
                          "description": "Mensaje de error"
                        },
                        "description": {
                          "type": "string",
                          "description": "Explicación del rechazo"
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en el panel de Seguridad de Z-API Omni. El prefijo `Bearer` es opcional."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Autenticación rechazada. El header `Authorization` falta, la clave está mal formada o no existe (`Authorization invalid`), o la IP de origen está fuera de la lista de IPs permitidas de la Secret Key (`<ip> not allowed`). El prefijo `Bearer` es opcional.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "authorization_invalid": {
                "summary": "Clave ausente, mal formada o inexistente",
                "value": {
                  "error": "Authorization invalid"
                }
              },
              "ip_not_allowed": {
                "summary": "IP fuera de la lista de IPs permitidas de la Secret Key",
                "value": {
                  "error": "203.0.113.10 not allowed"
                }
              },
              "business_id_required": {
                "summary": "WABA no informada",
                "value": {
                  "error": "Business id is required"
                }
              }
            }
          }
        }
      },
      "FlowBadRequest": {
        "description": "Petición rechazada antes de llegar a Meta: autenticación rechazada (header `Authorization` ausente, clave mal formada o inexistente, o IP fuera de la lista de IPs permitidas de la Secret Key) o cuerpo ausente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "authorization_invalid": {
                "summary": "Clave ausente, mal formada o inexistente",
                "value": {
                  "error": "Authorization invalid"
                }
              },
              "ip_not_allowed": {
                "summary": "IP fuera de la lista de IPs permitidas de la Secret Key",
                "value": {
                  "error": "203.0.113.10 not allowed"
                }
              },
              "request_body_missing": {
                "summary": "Cuerpo de la petición ausente",
                "value": {
                  "error": "Required request body is missing"
                }
              },
              "business_id_required": {
                "summary": "WABA no informada",
                "value": {
                  "error": "Business id is required"
                }
              }
            }
          }
        }
      },
      "IntegrationUnavailable": {
        "description": "Falla temporal de un servicio interno. Intenta de nuevo en unos instantes.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "error": "integration_unavailable",
              "message": "The operation could not be completed right now. Try again in a few moments."
            }
          }
        }
      },
      "IntegrationTimeout": {
        "description": "El servicio no respondió a tiempo. Repetir es seguro.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "error": "integration_timeout",
              "message": "The operation took too long to complete. Try again in a few moments."
            }
          }
        }
      },
      "OutcomeUnknown": {
        "description": "El servicio no respondió a tiempo y la operación puede haberse completado. Verifica el resultado antes de repetir.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "error": "outcome_unknown",
              "message": "The operation did not finish in time and may still be completed. Check the result before trying again."
            }
          }
        }
      }
    }
  }
}
