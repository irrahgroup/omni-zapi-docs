                "example": {
                  "data": [
                    {
                      "id": "1122334455667788",
                      "name": "agendamento_consulta",
                      "categories": [
                        "APPOINTMENT_BOOKING"
                      ],
                      "status": "PUBLISHED",
                      "endpoint_uri": null,
                      "validation_errors": []
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "description": "Meta o la plataforma rechazó la operación. Mira el formato del cuerpo en el ejemplo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Rechazo de Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Rechazo sin detalle",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/OutcomeUnknown"
          }
        }
      }
    },
    "/whatsapp/businesses/{wabaId}/flows/{flowId}": {
      "get": {
        "summary": "Consultar flow",
        "description": "Devuelve un flow concreto, incluido su `flow_json` y las incidencias de validación de Meta.",
        "operationId": "getFlow",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "ID de la WABA (obtenido con Listar WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "flowId",
            "in": "path",
            "required": true,
            "description": "ID del flow (obtenido con Listar flows)",
            "schema": {
              "type": "string",
              "example": "1122334455667788"
            }
          },
          {
            "name": "sync",
            "in": "query",
            "required": false,
            "description": "Cuando es `true`, consulta el estado del flow directamente en Meta antes de responder",
            "schema": {
              "type": "boolean",
              "example": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación realizada correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                },
                "example": {
                  "id": "1122334455667788",
                  "name": "agendamento_consulta",
                  "categories": [
                    "APPOINTMENT_BOOKING"
                  ],
                  "status": "PUBLISHED",
                  "endpoint_uri": null,
                  "validation_errors": [],
                  "flow_json": "{\"version\": \"7.0\", \"routing_model\": {\"WELCOME\": [\"DONE\"], \"DONE\": []}, \"screens\": [{\"id\": \"WELCOME\", \"title\": \"Agendamento\", \"layout\": {\"type\": \"SingleColumnLayout\", \"children\": [{\"type\": \"TextHeading\", \"text\": \"Escolha um horario\"}, {\"type\": \"Form\", \"name\": \"form\", \"children\": [{\"type\": \"TextInput\", \"name\": \"nome\", \"label\": \"Seu nome\", \"input-type\": \"text\", \"required\": true}, {\"type\": \"DatePicker\", \"name\": \"data\", \"label\": \"Data\"}, {\"type\": \"Footer\", \"label\": \"Continuar\", \"on-click-action\": {\"name\": \"navigate\", \"next\": {\"type\": \"screen\", \"name\": \"DONE\"}, \"payload\": {}}}]}]}}, {\"id\": \"DONE\", \"title\": \"Pronto\", \"terminal\": true, \"success\": true, \"layout\": {\"type\": \"SingleColumnLayout\", \"children\": [{\"type\": \"TextBody\", \"text\": \"Agendamento confirmado.\"}, {\"type\": \"Footer\", \"label\": \"Fechar\", \"on-click-action\": {\"name\": \"complete\", \"payload\": {}}}]}}]}"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "description": "Flow inexistente o de otro workspace, o rechazo de Meta al consultarlo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Rechazo de Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Rechazo sin detalle",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/IntegrationTimeout"
          }
        }
      },
      "put": {
        "summary": "Actualizar flow",
        "description": "Actualiza un flow existente. Todos los campos son opcionales: solo cambian los que envías. Un flow `PUBLISHED` no admite cambios en el `flow_json`.",
        "operationId": "updateFlow",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "ID de la WABA (obtenido con Listar WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "flowId",
            "in": "path",
            "required": true,
            "description": "ID del flow (obtenido con Listar flows)",
            "schema": {
              "type": "string",
              "example": "1122334455667788"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFlowRequest"
              },
              "example": {
                "name": "agendamento_consulta_v2"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flow actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                },
                "example": {
                  "id": "1122334455667788",
                  "name": "agendamento_consulta_v2",
                  "categories": [
                    "APPOINTMENT_BOOKING"
                  ],
                  "status": "PUBLISHED",
                  "endpoint_uri": null,
                  "validation_errors": []
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/FlowBadRequest"
          },
          "422": {
            "description": "Meta o la plataforma rechazó la operación: flow inexistente o de otro workspace, `flow_json` mal formado, categoría inexistente, o flow publicado que no admite cambios en el `flow_json`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Rechazo de Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Rechazo sin detalle",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/OutcomeUnknown"
          }
        }
      },
      "delete": {
        "summary": "Eliminar flow",
        "description": "Elimina permanentemente un flow. Solo se pueden eliminar flows en `DRAFT`.",
        "operationId": "deleteFlow",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "ID de la WABA (obtenido con Listar WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "flowId",
            "in": "path",
            "required": true,
            "description": "ID del flow (obtenido con Listar flows)",
            "schema": {
              "type": "string",
              "example": "1122334455667788"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Flow eliminado. El cuerpo es el booleano `true`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean",
                  "description": "`true` cuando la eliminación fue aceptada"
                },
                "example": true
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "description": "Flow inexistente o de otro workspace, o flow fuera de `DRAFT`, que no se puede eliminar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Rechazo de Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Rechazo sin detalle",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/OutcomeUnknown"
          }
        }
      }
    },
