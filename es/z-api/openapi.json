                    "message": "¿Cómo valoras nuestra atención?",
                    "buttonList": {
                      "buttons": [
                        {
                          "id": "1",
                          "label": "Ótimo"
                        },
                        {
                          "id": "2",
                          "label": "Bom"
                        },
                        {
                          "id": "3",
                          "label": "Regular"
                        }
                      ]
                    }
                  }
                },
                "withImage": {
                  "summary": "Con imagen",
                  "value": {
                    "phone": "5511999999999",
                    "message": "¿Cómo valoras nuestra atención?",
                    "buttonList": {
                      "image": "https://ejemplo.com/imagen.png",
                      "buttons": [
                        {
                          "id": "1",
                          "label": "Ótimo"
                        },
                        {
                          "id": "2",
                          "label": "Bom"
                        },
                        {
                          "id": "3",
                          "label": "Regular"
                        }
                      ]
                    }
                  }
                },
                "withVideo": {
                  "summary": "Con vídeo",
                  "value": {
                    "phone": "5511999999999",
                    "message": "¿Cómo valoras nuestra atención?",
                    "buttonList": {
                      "video": "https://ejemplo.com/video.mp4",
                      "buttons": [
                        {
                          "id": "1",
                          "label": "Ótimo"
                        },
                        {
                          "id": "2",
                          "label": "Bom"
                        },
                        {
                          "id": "3",
                          "label": "Regular"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MessageSuccess"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          }
        }
      }
    },
    "/send-contact": {
      "post": {
        "summary": "Enviar contacto",
        "description": "Envía un contacto por WhatsApp. No hace falta que el contacto esté guardado en tu agenda.",
        "operationId": "sendContact",
        "tags": [
