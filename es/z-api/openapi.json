          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          }
        }
      }
    },
    "/send-document/{extension}": {
      "post": {
        "summary": "Enviar documento",
        "description": "Envía un documento (PDF, DOC, XLS, etc.). La extensión del archivo debe indicarse en el path. Admite URL o Base64.",
        "operationId": "sendDocument",
        "tags": [
          "Mensajes"
        ],
        "parameters": [
          {
            "name": "extension",
            "in": "path",
            "required": true,
            "description": "Extensión del archivo (p. ej.: pdf, docx, xlsx)",
            "schema": {
              "type": "string",
              "example": "pdf"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendDocumentRequest"
              },
              "examples": {
                "url": {
                  "summary": "Envío por URL",
                  "value": {
                    "phone": "5511999999999",
                    "document": "https://ejemplo.com/archivo.pdf",
                    "fileName": "Mi documento"
                  }
                },
                "base64": {
                  "summary": "Envío por Base64",
                  "value": {
                    "phone": "5511999999999",
                    "document": "data:application/pdf;base64,JVBERiN0YXJ0eHJlZg...",
                    "fileName": "Mi documento"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MessageSuccess"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          }
        }
      }
    },
