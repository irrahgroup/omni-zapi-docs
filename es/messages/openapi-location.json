{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Enviar ubicación",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages": {
      "post": {
        "summary": "Enviar ubicación",
        "description": "Envía un mensaje de ubicación. Solo funciona cuando la ventana de conversación de 24 horas está abierta.",
        "operationId": "sendLocationMessage",
        "tags": [
          "Mensajes"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal",
            "schema": {
              "type": "string",
              "example": "SU_CHANNEL_ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendLocationRequest"
              },
              "example": {
                "recipient": {
                  "identifier": "5544936181064",
                  "name": "Nombre del Destinatario",
                  "subject": "Título",
                  "picture": ""
                },
                "sender": {
                  "identifier": "5544936181064",
                  "name": "Nombre del Remitente",
                  "picture": ""
                },
                "content": {
                  "type": "LOCATION",
                  "attachments": [
                    {
                      "name": "Google Brasil",
                      "address": "Av. Brg. Faria Lima, 3477 - Itaim Bibi, São Paulo - SP, 04538-133",
                      "latitude": "-23.0696347",
                      "longitude": "-50.4357913"
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MessageSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/InstanceNotFound"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MessageSuccess": {
        "description": "Mensaje aceptado y puesto en la cola de envío. La entrega se confirma después, por los eventos de estado del webhook.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "example": {
              "messageId": "01A0C92D0C957FE98B73C8BA0CACF741"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Solicitud rechazada antes del envío: Secret Key no válida, IP fuera de la lista permitida, cuerpo ausente o cuerpo que no sirve para el tipo de mensaje.",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SendError"
                },
                {
                  "$ref": "#/components/schemas/Error"
                }
              ]
            },
            "examples": {
              "authorizationInvalid": {
                "summary": "Secret Key no válida o ausente",
                "value": {
                  "error": "Authorization invalid"
                }
              },
              "ipNotAllowed": {
                "summary": "IP de origen fuera de la lista de IPs permitidas",
                "value": {
                  "error": "203.0.113.10 not allowed"
                }
              },
              "payloadRequired": {
                "summary": "Cuerpo vacío ({})",
                "value": {
                  "error": "message payload is required"
                }
              },
              "validationError": {
                "summary": "Campo obligatorio ausente para el tipo",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "VALIDATION_ERROR",
                  "message": "Field 'content.attachments': is required for message type LOCATION"
                }
              }
            }
          }
        }
      },
      "InstanceNotFound": {
        "description": "No se encontró una instancia para la Secret Key enviada.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "instanceNotFound": {
                "summary": "Instancia no encontrada",
                "value": {
                  "error": "instance not found"
                }
              }
            }
          }
        }
      },
      "Unprocessable": {
        "description": "Envío rechazado por una regla: canal desconectado, instancia sin aprovisionar, suscripción inactiva, cuenta bloqueada o tipo que el canal no tiene.",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SendError"
                },
                {
                  "$ref": "#/components/schemas/Error"
                }
              ]
            },
            "examples": {
              "channelDisconnected": {
                "summary": "Canal desconectado: conecta el canal de nuevo y repite el envío",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "BUSINESS_RULE_VIOLATION",
                  "subCode": "CHANNEL_DISCONNECTED",
                  "message": "Channel is disconnected"
                }
              },
              "unsupportedChannelType": {
                "summary": "Tipo que el canal no tiene",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "BUSINESS_RULE_VIOLATION",
                  "message": "[UNSUPPORTED_CHANNEL_TYPE] O canal META_INSTAGRAM nao suporta mensagens do tipo LOCATION"
                }
              },
              "instanceNotProvisioned": {
                "summary": "Instancia sin aprovisionar",
                "value": {
                  "error": "instance is not provisioned"
                }
              },
              "subscriptionInactive": {
                "summary": "Suscripción de la instancia inactiva",
                "value": {
                  "error": "instance subscription is not active"
                }
              },
              "blocked": {
                "summary": "Cuenta bloqueada",
                "value": {
                  "error": "You are blocked, contact support."
                }
              }
            }
          }
        }
      },
      "BadGateway": {
        "description": "Falla de nuestro lado al procesar la solicitud. Revisa el webhook de estado antes de repetir: la solicitud puede haber sido aceptada.",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SendError"
                },
                {
                  "$ref": "#/components/schemas/Error"
                }
              ]
            },
            "examples": {
              "integrationUnavailable": {
                "summary": "Falla temporal: intenta de nuevo en unos instantes",
                "value": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              },
              "sendingFailed": {
                "summary": "Falla interna al procesar la solicitud",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "INTEGRATION_ERROR",
                  "message": "Message sending failed"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "SendLocationRequest": {
        "type": "object",
        "required": [
          "recipient",
          "content"
        ],
        "properties": {
          "recipient": {
            "type": "object",
            "required": [
              "identifier"
            ],
            "description": "Datos del destinatario",
            "properties": {
              "identifier": {
                "type": "string",
                "description": "Identificador del destinatario en el canal: teléfono con código de país y de área en WhatsApp (5511999999999), IGSID en Instagram, PSID en Messenger y chat_id en Telegram",
                "example": "5544936181064"
              },
              "name": {
                "type": "string",
                "description": "Nombre del destinatario (opcional)",
                "example": "Nombre del Destinatario"
              },
              "subject": {
                "type": "string",
                "description": "Título o asunto (opcional)",
                "example": "Título"
              },
              "picture": {
                "type": "string",
                "description": "URL de la foto del destinatario (opcional)",
                "example": ""
              }
            }
          },
          "sender": {
            "type": "object",
            "description": "Datos del remitente (opcional)",
            "properties": {
              "identifier": {
                "type": "string",
                "description": "Teléfono del remitente",
                "example": "5544936181064"
              },
              "name": {
                "type": "string",
                "description": "Nombre del remitente",
                "example": "Nombre del Remitente"
              },
              "picture": {
                "type": "string",
                "description": "URL de la foto del remitente",
                "example": ""
              }
            }
          },
          "content": {
            "type": "object",
            "required": [
              "type",
              "attachments"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Tipo de mensaje",
                "enum": [
                  "LOCATION"
                ]
              },
              "attachments": {
                "type": "array",
                "description": "Lista con los datos de la ubicación",
                "items": {
                  "type": "object",
                  "properties": {
                    "latitude": {
                      "type": "string",
                      "description": "Latitud de la ubicación, en texto, como en el ejemplo. La API no lo valida, pero es necesario para que el pin se muestre correctamente en WhatsApp.",
                      "example": "-23.0696347"
                    },
                    "longitude": {
                      "type": "string",
                      "description": "Longitud de la ubicación, en texto, como en el ejemplo. La API no lo valida, pero es necesario para que el pin se muestre correctamente en WhatsApp.",
                      "example": "-50.4357913"
                    },
                    "name": {
                      "type": "string",
                      "description": "Nombre del lugar (opcional)",
                      "example": "Google Brasil"
                    },
                    "address": {
                      "type": "string",
                      "description": "Dirección del lugar (opcional)",
                      "example": "Av. Brg. Faria Lima, 3477 - Itaim Bibi, São Paulo - SP, 04538-133"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "ID del mensaje en Z-API Omni: hexadecimal de 32 caracteres en mayúsculas. Es el mismo valor de message._id en el webhook"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Motivo del rechazo"
          },
          "message": {
            "type": "string",
            "description": "Detalle del rechazo, cuando lo hay"
          }
        }
      },
      "SendError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora del rechazo, en UTC"
          },
          "code": {
            "type": "string",
            "description": "Categoría del error",
            "example": "BUSINESS_RULE_VIOLATION"
          },
          "subCode": {
            "type": "string",
            "description": "Código del caso. Solo viene cuando el caso tiene un código propio",
            "example": "CHANNEL_DISCONNECTED"
          },
          "message": {
            "type": "string",
            "description": "Descripción del error. El texto puede cambiar: trata el error por `code` y `subCode`",
            "example": "Channel is disconnected"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en el panel de Seguridad de Z-API Omni"
      }
    }
  }
}
