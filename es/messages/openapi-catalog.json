{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Enviar catálogo",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages": {
      "post": {
        "summary": "Enviar catálogo",
        "description": "Envía un mensaje que abre el catálogo conectado a la cuenta.",
        "operationId": "sendInteractiveCatalogMessage",
        "tags": [
          "Mensajes"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal",
            "schema": {
              "type": "string",
              "example": "SU_CHANNEL_ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendCatalogRequest"
              },
              "examples": {
                "catalog": {
                  "summary": "Catálogo con producto de portada",
                  "value": {
                    "recipient": {
                      "identifier": "5511999999999"
                    },
                    "content": {
                      "type": "INTERACTIVE_CATALOG",
                      "body": {
                        "message": "Chegaram novidades na loja. Toque para ver o catálogo completo."
                      },
                      "footer": {
                        "message": "Preços válidos enquanto durar o estoque"
                      },
                      "action": {
                        "id": "SKU-1042"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MessageSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "$ref": "#/components/responses/ChannelDisconnected"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MessageSuccess": {
        "description": "Mensaje enviado correctamente",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "example": {
              "messageId": "01A0C92D0C957FE98B73C8BA0CACF741"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Secret Key ausente, malformada o inexistente (`Authorization invalid`), IP fuera de la lista de IPs (`<ip> not allowed`) o cuerpo que no sirve para el tipo de mensaje (`code` `VALIDATION_ERROR`).",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ErrorText"
                },
                {
                  "$ref": "#/components/schemas/SendError"
                }
              ]
            },
            "examples": {
              "authorization": {
                "summary": "Secret Key inválida",
                "value": {
                  "error": "Authorization invalid"
                }
              },
              "validation": {
                "summary": "Cuerpo inválido",
                "value": {
                  "code": "VALIDATION_ERROR",
                  "message": "Field 'content.body': is required for message type INTERACTIVE_CATALOG"
                }
              }
            }
          }
        }
      },
      "ChannelDisconnected": {
        "description": "Canal desconectado. El mensaje no se envió: conecta el canal de nuevo y repite el envío.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "example": {
              "timestamp": "2026-10-22T14:00:00.123Z",
              "code": "BUSINESS_RULE_VIOLATION",
              "subCode": "CHANNEL_DISCONNECTED",
              "message": "Channel is disconnected"
            }
          }
        }
      }
    },
    "schemas": {
      "SendCatalogRequest": {
        "type": "object",
        "required": [
          "recipient",
          "content"
        ],
        "properties": {
          "recipient": {
            "type": "object",
            "required": [
              "identifier"
            ],
            "properties": {
              "identifier": {
                "type": "string",
                "description": "Teléfono del destinatario (código de país + código de área + número)",
                "example": "5511999999999"
              }
            }
          },
          "content": {
            "type": "object",
            "required": [
              "type",
              "body"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Tipo del mensaje",
                "enum": [
                  "INTERACTIVE_CATALOG"
                ]
              },
              "body": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Texto del mensaje"
                  }
                },
                "required": [
                  "message"
                ]
              },
              "footer": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Texto del pie. Opcional"
                  }
                }
              },
              "action": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Nombre de la acción. Si está vacío, vale `catalog_message`"
                  },
                  "id": {
                    "type": "string",
                    "description": "ID del producto (SKU) usado como portada"
                  }
                }
              },
              "messageIdReply": {
                "type": "string",
                "description": "ID del mensaje que se responde, con cita. Opcional"
              },
              "messageIdForwarded": {
                "type": "string",
                "description": "ID del mensaje reenviado. Opcional"
              }
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "ID del mensaje enviado: hexadecimal de 32 caracteres en mayúsculas"
          }
        }
      },
      "ErrorText": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Texto del error"
          }
        }
      },
      "SendError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora del rechazo, en UTC"
          },
          "code": {
            "type": "string",
            "description": "Categoría del error",
            "example": "BUSINESS_RULE_VIOLATION"
          },
          "subCode": {
            "type": "string",
            "description": "Código del caso. Solo viene cuando el caso tiene un código propio",
            "example": "CHANNEL_DISCONNECTED"
          },
          "message": {
            "type": "string",
            "description": "Descripción del error. El texto puede cambiar: trata el error por `code` y `subCode`",
            "example": "Channel is disconnected"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en el panel de Seguridad de Z-API Omni"
      }
    }
  }
}
