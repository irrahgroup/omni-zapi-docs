{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Enviar formulario (Flow)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages": {
      "post": {
        "summary": "Enviar formulario (Flow)",
        "description": "Envía un formulario publicado de WhatsApp, sin plantilla.",
        "operationId": "sendFlowMessage",
        "tags": [
          "Mensajes"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal",
            "schema": {
              "type": "string",
              "example": "SU_CHANNEL_ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendFlowRequest"
              },
              "examples": {
                "full": {
                  "summary": "Con título y pie",
                  "value": {
                    "recipient": {
                      "identifier": "5511999999999"
                    },
                    "content": {
                      "type": "INTERACTIVE_FLOW",
                      "header": {
                        "message": "Agendamiento"
                      },
                      "body": {
                        "message": "Elige el mejor horario para ti."
                      },
                      "footer": {
                        "message": "Lleva menos de un minuto"
                      },
                      "action": {
                        "name": "flow",
                        "version": "3",
                        "id": "1234567890123456",
                        "cta": "Agendar"
                      }
                    }
                  }
                },
                "minimal": {
                  "summary": "Solo lo obligatorio",
                  "value": {
                    "recipient": {
                      "identifier": "5511999999999"
                    },
                    "content": {
                      "type": "INTERACTIVE_FLOW",
                      "body": {
                        "message": "Elige el mejor horario para ti."
                      },
                      "action": {
                        "name": "flow",
                        "version": "3",
                        "id": "1234567890123456",
                        "cta": "Agendar"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MessageSuccess"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ChannelDisconnected"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MessageSuccess": {
        "description": "Mensaje enviado correctamente",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "example": {
              "messageId": "01A0C92D0C957FE98B73C8BA0CACF741"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Token no válido o ausente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": 401,
              "message": "Unauthorized"
            }
          }
        }
      },
      "ChannelDisconnected": {
        "description": "Canal desconectado. El mensaje no se envió: conecta el canal de nuevo y repite el envío.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "example": {
              "timestamp": "2026-10-22T14:00:00.123Z",
              "code": "BUSINESS_RULE_VIOLATION",
              "subCode": "CHANNEL_DISCONNECTED",
              "message": "Channel is disconnected"
            }
          }
        }
      }
    },
    "schemas": {
      "SendFlowRequest": {
        "type": "object",
        "required": [
          "recipient",
          "content"
        ],
        "properties": {
          "recipient": {
            "type": "object",
            "required": [
              "identifier"
            ],
            "properties": {
              "identifier": {
                "type": "string",
                "description": "Teléfono del destinatario (código de país + prefijo + número)",
                "example": "5511999999999"
              }
            }
          },
          "content": {
            "type": "object",
            "required": [
              "type",
              "body",
              "action"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Tipo de mensaje",
                "enum": [
                  "INTERACTIVE_FLOW"
                ]
              },
              "body": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Texto del mensaje, encima del botón"
                  }
                },
                "required": [
                  "message"
                ]
              },
              "header": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Título en texto"
                  }
                }
              },
              "footer": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Pie"
                  }
                }
              },
              "action": {
                "type": "object",
                "description": "El formulario y el botón que lo abre",
                "required": [
                  "name",
                  "version",
                  "id",
                  "cta"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Siempre `flow`",
                    "enum": [
                      "flow"
                    ]
                  },
                  "version": {
                    "type": "string",
                    "description": "Versión del mensaje de Flow en Meta: `3`",
                    "enum": [
                      "3"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "description": "El `id` de un formulario publicado en la misma cuenta del canal, como viene en Listar flows"
                  },
                  "cta": {
                    "type": "string",
                    "description": "Texto del botón, hasta 30 caracteres",
                    "maxLength": 30
                  },
                  "mode": {
                    "type": "string",
                    "description": "Estado del formulario. Sin él, vale `published`",
                    "enum": [
                      "published"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "ID del mensaje enviado — hexadecimal de 32 caracteres en mayúsculas"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SendError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora del rechazo, en UTC"
          },
          "code": {
            "type": "string",
            "description": "Categoría del error",
            "example": "BUSINESS_RULE_VIOLATION"
          },
          "subCode": {
            "type": "string",
            "description": "Código del caso. Solo viene cuando el caso tiene un código propio",
            "example": "CHANNEL_DISCONNECTED"
          },
          "message": {
            "type": "string",
            "description": "Descripción del error. El texto puede cambiar: trata el error por `code` y `subCode`",
            "example": "Channel is disconnected"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en el panel de Seguridad de Omni Z-API"
      }
    }
  }
}
