{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Enviar documento",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages": {
      "post": {
        "summary": "Enviar documento",
        "description": "Envía un archivo al contacto.",
        "operationId": "sendDocumentMessage",
        "tags": [
          "Mensajes"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal",
            "schema": {
              "type": "string",
              "example": "SU_CHANNEL_ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendDocumentRequest"
              },
              "examples": {
                "url": {
                  "summary": "Por URL",
                  "value": {
                    "recipient": {
                      "identifier": "5511999999999"
                    },
                    "content": {
                      "type": "DOCUMENT",
                      "attachments": [
                        {
                          "url": "https://tutienda.com/factura.pdf",
                          "name": "factura",
                          "extension": "pdf",
                          "caption": "Aquí está tu factura"
                        }
                      ]
                    }
                  }
                },
                "base64": {
                  "summary": "Por Base64",
                  "value": {
                    "recipient": {
                      "identifier": "5511999999999"
                    },
                    "content": {
                      "type": "DOCUMENT",
                      "attachments": [
                        {
                          "url": "data:application/pdf;base64,JVBERi0xLjQK...",
                          "name": "factura",
                          "extension": "pdf",
                          "caption": "Aquí está tu factura"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MessageSuccess"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ChannelDisconnected"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MessageSuccess": {
        "description": "Mensaje enviado correctamente",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "example": {
              "messageId": "01A0C92D0C957FE98B73C8BA0CACF741"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Token no válido o ausente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": 401,
              "message": "Unauthorized"
            }
          }
        }
      },
      "ChannelDisconnected": {
        "description": "Canal desconectado. El mensaje no se envió: conecta el canal de nuevo y repite el envío.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "example": {
              "timestamp": "2026-10-22T14:00:00.123Z",
              "code": "BUSINESS_RULE_VIOLATION",
              "subCode": "CHANNEL_DISCONNECTED",
              "message": "Channel is disconnected"
            }
          }
        }
      }
    },
    "schemas": {
      "SendDocumentRequest": {
        "type": "object",
        "required": [
          "recipient",
          "content"
        ],
        "properties": {
          "recipient": {
            "type": "object",
            "required": [
              "identifier"
            ],
            "properties": {
              "identifier": {
                "type": "string",
                "description": "Teléfono del destinatario (código de país + prefijo + número)",
                "example": "5511999999999"
              }
            }
          },
          "content": {
            "type": "object",
            "required": [
              "type",
              "attachments"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Tipo de mensaje",
                "enum": [
                  "DOCUMENT"
                ]
              },
              "attachments": {
                "type": "array",
                "description": "Lista de adjuntos",
                "items": {
                  "type": "object",
                  "required": [
                    "url"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "description": "Dirección `https` del archivo, o el contenido en Base64 con el prefijo del tipo, como `data:application/pdf;base64,`"
                    },
                    "name": {
                      "type": "string",
                      "description": "Nombre del archivo, sin la extensión"
                    },
                    "extension": {
                      "type": "string",
                      "description": "Extensión, sin el punto: `pdf`, `xlsx`, `docx`. Es la que define el ícono. Sin ella, el archivo llega sin nombre"
                    },
                    "caption": {
                      "type": "string",
                      "description": "Leyenda, mostrada junto con el archivo"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "ID del mensaje enviado — hexadecimal de 32 caracteres en mayúsculas"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SendError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora del rechazo, en UTC"
          },
          "code": {
            "type": "string",
            "description": "Categoría del error",
            "example": "BUSINESS_RULE_VIOLATION"
          },
          "subCode": {
            "type": "string",
            "description": "Código del caso. Solo viene cuando el caso tiene un código propio",
            "example": "CHANNEL_DISCONNECTED"
          },
          "message": {
            "type": "string",
            "description": "Descripción del error. El texto puede cambiar: trata el error por `code` y `subCode`",
            "example": "Channel is disconnected"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en el panel de Seguridad de Omni Z-API"
      }
    }
  }
}
