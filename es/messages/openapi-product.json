{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Enviar producto",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages": {
      "post": {
        "summary": "Enviar producto",
        "description": "Manda un producto del catálogo, con foto, nombre y precio.",
        "operationId": "sendSingleProductMessage",
        "tags": [
          "Mensajes"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal",
            "schema": {
              "type": "string",
              "example": "SU_CHANNEL_ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendInteractiveSingleProductRequest"
              },
              "example": {
                "recipient": {
                  "identifier": "5511999999999"
                },
                "content": {
                  "type": "INTERACTIVE_SINGLE_PRODUCT",
                  "body": {
                    "message": "Este é o produto que você perguntou."
                  },
                  "footer": {
                    "message": "Estoque limitado"
                  },
                  "action": {
                    "catalogId": "1234567890",
                    "productRetailerId": "SKU-1042"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MessageSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ChannelDisconnected"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MessageSuccess": {
        "description": "Mensaje enviado correctamente",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "example": {
              "messageId": "01A0C92D0C957FE98B73C8BA0CACF741"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Token no válido o ausente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": 401,
              "message": "Unauthorized"
            }
          }
        }
      },
      "ChannelDisconnected": {
        "description": "Canal desconectado. El mensaje no se envió: conecta el canal de nuevo y repite el envío.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "example": {
              "timestamp": "2026-10-22T14:00:00.123Z",
              "code": "BUSINESS_RULE_VIOLATION",
              "subCode": "CHANNEL_DISCONNECTED",
              "message": "Channel is disconnected"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Cuerpo sin el campo obligatorio del tipo",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "example": {
              "timestamp": "2026-10-22T14:00:00.123Z",
              "code": "VALIDATION_ERROR",
              "message": "Field 'content.body': is required for message type INTERACTIVE_SINGLE_PRODUCT"
            }
          }
        }
      }
    },
    "schemas": {
      "SendInteractiveSingleProductRequest": {
        "type": "object",
        "required": [
          "recipient",
          "content"
        ],
        "properties": {
          "recipient": {
            "type": "object",
            "required": [
              "identifier"
            ],
            "properties": {
              "identifier": {
                "type": "string",
                "description": "Teléfono del destinatario (código de país + prefijo + número)",
                "example": "5511999999999"
              }
            }
          },
          "content": {
            "type": "object",
            "required": [
              "type",
              "body"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Tipo de mensaje",
                "enum": [
                  "INTERACTIVE_SINGLE_PRODUCT"
                ]
              },
              "body": {
                "type": "object",
                "description": "Cuerpo del mensaje. Puede ir vacío (`{}`)",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Texto del mensaje"
                  }
                }
              },
              "footer": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Pie"
                  }
                }
              },
              "action": {
                "type": "object",
                "properties": {
                  "catalogId": {
                    "type": "string",
                    "description": "Id del catálogo en Commerce Manager. Meta lo exige"
                  },
                  "productRetailerId": {
                    "type": "string",
                    "description": "SKU (`retailer_id`) del producto. Meta lo exige"
                  }
                }
              }
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "ID del mensaje enviado — hexadecimal de 32 caracteres en mayúsculas"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SendError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora del rechazo, en UTC"
          },
          "code": {
            "type": "string",
            "description": "Categoría del error",
            "example": "BUSINESS_RULE_VIOLATION"
          },
          "subCode": {
            "type": "string",
            "description": "Código del caso. Solo viene cuando el caso tiene un código propio",
            "example": "CHANNEL_DISCONNECTED"
          },
          "message": {
            "type": "string",
            "description": "Descripción del error. El texto puede cambiar: trata el error por `code` y `subCode`",
            "example": "Channel is disconnected"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en el panel de Seguridad de Omni Z-API"
      }
    }
  }
}
