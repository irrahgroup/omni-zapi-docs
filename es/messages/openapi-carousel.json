{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Enviar carrusel",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages": {
      "post": {
        "summary": "Enviar carrusel",
        "description": "Envía tarjetas con medios y botones, lado a lado.",
        "operationId": "sendCarouselMessage",
        "tags": [
          "Mensajes"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID del canal",
            "schema": {
              "type": "string",
              "example": "SU_CHANNEL_ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendInteractiveCarouselRequest"
              },
              "example": {
                "recipient": {
                  "identifier": "5511999999999"
                },
                "content": {
                  "type": "INTERACTIVE_CAROUSEL",
                  "body": {
                    "message": "Separamos duas ofertas para você."
                  },
                  "attachments": [
                    {
                      "url": "https://exemplo.com/tenis.jpg",
                      "mimeType": "image/jpeg",
                      "message": "Tênis de corrida, de R$ 399 por R$ 299",
                      "list": [
                        {
                          "id": "ver-tenis",
                          "title": "Ver na loja",
                          "name": "URL",
                          "url": "https://exemplo.com/tenis"
                        },
                        {
                          "id": "quero-tenis",
                          "title": "Quero este",
                          "name": "REPLY"
                        }
                      ]
                    },
                    {
                      "url": "https://exemplo.com/mochila.jpg",
                      "mimeType": "image/jpeg",
                      "message": "Mochila impermeável, de R$ 249 por R$ 189",
                      "list": [
                        {
                          "id": "ver-mochila",
                          "title": "Ver na loja",
                          "name": "URL",
                          "url": "https://exemplo.com/mochila"
                        },
                        {
                          "id": "quero-mochila",
                          "title": "Quero esta",
                          "name": "REPLY"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MessageSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/SendRefused"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MessageSuccess": {
        "description": "Mensaje enviado correctamente",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "example": {
              "messageId": "01A0C92D0C957FE98B73C8BA0CACF741"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Token no válido o ausente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": 401,
              "message": "Unauthorized"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Cuerpo sin el campo obligatorio del tipo",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "example": {
              "timestamp": "2026-10-22T14:00:00.123Z",
              "code": "VALIDATION_ERROR",
              "message": "Field 'content.body': is required for message type INTERACTIVE_CAROUSEL"
            }
          }
        }
      },
      "SendRefused": {
        "description": "Canal desconectado, o tipo que el canal no acepta. El mensaje no se envió.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "examples": {
              "channelDisconnected": {
                "summary": "CHANNEL_DISCONNECTED",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "BUSINESS_RULE_VIOLATION",
                  "subCode": "CHANNEL_DISCONNECTED",
                  "message": "Channel is disconnected"
                }
              },
              "unsupportedChannel": {
                "summary": "UNSUPPORTED_CHANNEL_TYPE",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "BUSINESS_RULE_VIOLATION",
                  "message": "[UNSUPPORTED_CHANNEL_TYPE] O canal TELEGRAM nao suporta mensagens do tipo INTERACTIVE_CAROUSEL"
                }
              },
              "unsupportedButton": {
                "summary": "UNSUPPORTED_CAROUSEL_BUTTON",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "BUSINESS_RULE_VIOLATION",
                  "message": "[UNSUPPORTED_CAROUSEL_BUTTON] O botao 1 do cartao 2 do carrossel tem tipo CALL; o carrossel aceita URL ou REPLY"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "SendInteractiveCarouselRequest": {
        "type": "object",
        "required": [
          "recipient",
          "content"
        ],
        "properties": {
          "recipient": {
            "type": "object",
            "required": [
              "identifier"
            ],
            "properties": {
              "identifier": {
                "type": "string",
                "description": "Teléfono del destinatario (código de país + prefijo + número)",
                "example": "5511999999999"
              }
            }
          },
          "content": {
            "type": "object",
            "required": [
              "type",
              "body",
              "attachments"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Tipo de mensaje",
                "enum": [
                  "INTERACTIVE_CAROUSEL"
                ]
              },
              "body": {
                "type": "object",
                "description": "Texto que va antes de las tarjetas",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Texto del mensaje. Meta lo exige"
                  }
                }
              },
              "attachments": {
                "type": "array",
                "description": "Las tarjetas, en el orden en que aparecen",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "description": "URL del medio de la tarjeta"
                    },
                    "mimeType": {
                      "type": "string",
                      "description": "Tipo del medio, como `image/jpeg` o `video/mp4`"
                    },
                    "message": {
                      "type": "string",
                      "description": "Texto de la tarjeta"
                    },
                    "list": {
                      "type": "array",
                      "description": "Botones de la tarjeta",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Identificador del botón"
                          },
                          "title": {
                            "type": "string",
                            "description": "Texto del botón"
                          },
                          "name": {
                            "type": "string",
                            "description": "Tipo del botón: `URL` abre un enlace y `REPLY` vuelve como respuesta del cliente. Mayúsculas y minúsculas no importan"
                          },
                          "url": {
                            "type": "string",
                            "description": "Destino del botón `URL`. En los botones `REPLY`, se ignora"
                          }
                        },
                        "required": [
                          "name"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "ID del mensaje enviado — hexadecimal de 32 caracteres en mayúsculas"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SendError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora del rechazo, en UTC"
          },
          "code": {
            "type": "string",
            "description": "Categoría del error",
            "example": "BUSINESS_RULE_VIOLATION"
          },
          "subCode": {
            "type": "string",
            "description": "Código del caso. Solo viene cuando el caso tiene un código propio",
            "example": "CHANNEL_DISCONNECTED"
          },
          "message": {
            "type": "string",
            "description": "Descripción del error. El texto puede cambiar: trata el error por `code` y `subCode`",
            "example": "Channel is disconnected"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en el panel de Seguridad de Omni Z-API"
      }
    }
  }
}
