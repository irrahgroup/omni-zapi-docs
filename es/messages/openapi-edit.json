{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Editar mensaje",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages/{messageId}": {
      "put": {
        "summary": "Editar mensaje",
        "description": "Cambia el texto de un mensaje de texto que tu canal ya envió, en los canales que permiten edición (WhatsApp Web y Telegram). El destinatario ve el texto nuevo en lugar del anterior, con la marca de editado de la aplicación. No se envía ningún mensaje nuevo. Consulta [Editar mensaje](/es/messages/edit-message).",
        "operationId": "editMessage",
        "tags": [
          "Mensajes"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "El canal que envió el mensaje",
            "schema": {
              "type": "string",
              "example": "TU_CHANNEL_ID"
            }
          },
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "description": "El `messageId` que devolvió el envío. También se acepta el `contents[].identifier` recibido en el webhook",
            "schema": {
              "type": "string",
              "example": "01A0C92D0C957FE98B73C8BA0CACF741"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditMessageRequest"
              },
              "example": {
                "content": {
                  "type": "TEXT",
                  "body": {
                    "message": "Texto corregido"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Edición aceptada y enviada al canal. No garantiza que la aplicación del contacto ya muestre el texto nuevo: si el canal la rechaza después, el texto del contacto no cambia y la API no envía aviso de ese rechazo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "messageId": "01A0C92D0C957FE98B73C8BA0CACF741"
                }
              }
            }
          },
          "400": {
            "description": "Cuerpo ausente o vacío, `content.type` distinto de `TEXT` o `content.body.message` vacío.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendError"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "El `messageId` no existe o no es de este canal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendError"
                }
              }
            }
          },
          "422": {
            "description": "Edición rechazada. Trátala por el `subCode`: `EDIT_NOT_SUPPORTED` (el canal no permite edición), `CHANNEL_DISCONNECTED` (el canal está desconectado), `MESSAGE_NOT_EDITABLE` (el mensaje no es texto, incluido el pie de foto de un medio, no fue enviado por tu canal, el canal aún no lo aceptó o falló en el envío) y `EDIT_WINDOW_EXPIRED` (pasó el plazo en que el canal acepta edición).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendError"
                },
                "examples": {
                  "notSupported": {
                    "summary": "Canal sin edición",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "EDIT_NOT_SUPPORTED"
                    }
                  },
                  "channelDisconnected": {
                    "summary": "Canal desconectado",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "CHANNEL_DISCONNECTED"
                    }
                  },
                  "notEditable": {
                    "summary": "Mensaje no editable",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "MESSAGE_NOT_EDITABLE"
                    }
                  },
                  "windowExpired": {
                    "summary": "Plazo de edición vencido",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "EDIT_WINDOW_EXPIRED"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Token no válido o ausente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": 401,
              "message": "Unauthorized"
            }
          }
        }
      },
      "Forbidden": {
        "description": "IP fuera de la lista del workspace (ver [Restricción de IP](/es/security/ip-restriction))",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "ip_not_allowed",
              "message": "203.0.113.10 not allowed: this workspace only accepts API calls from the IPs on its allow list. The workspace Owner can add this IP under Administration > Security > IP Restriction in the panel (changes take up to 10 minutes to apply), or call from an allowed IP. See https://developer.omni.z-api.io/en/security/ip-restriction"
            }
          }
        }
      }
    },
    "schemas": {
      "SendError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora del rechazo, en UTC"
          },
          "code": {
            "type": "string",
            "description": "Categoría del error",
            "example": "BUSINESS_RULE_VIOLATION"
          },
          "subCode": {
            "type": "string",
            "description": "Código del caso. Solo viene cuando el caso tiene un código propio",
            "example": "CHANNEL_DISCONNECTED"
          },
          "message": {
            "type": "string",
            "description": "Descripción del error. El texto puede cambiar: trata el error por `code` y `subCode`",
            "example": "Channel is disconnected"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "`messageId` del mensaje editado"
          }
        }
      },
      "EditMessageRequest": {
        "type": "object",
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "type",
              "body"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Tipo del contenido. Solo se puede editar texto",
                "enum": [
                  "TEXT"
                ]
              },
              "body": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Texto nuevo del mensaje"
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key generada en el panel de Seguridad de Omni Z-API"
      }
    }
  }
}
