    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Secret Key recusada. Vem com o header `WWW-Authenticate: Bearer`; o `message` muda com o motivo (ver [Autenticação](/authentication)).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Authorization invalid",
              "message": "Authorization invalid: the Authorization header is missing or empty. Send the workspace Secret Key as \"Authorization: Bearer <secret-key>\". See https://developer.omni.z-api.io/en/authentication"
            }
          }
        },
        "headers": {
          "WWW-Authenticate": {
            "description": "Sempre `Bearer`",
            "schema": {
              "type": "string",
              "example": "Bearer"
            }
          }
        }
      },
      "Forbidden": {
        "description": "IP fora da lista do workspace (ver [Restrição de IP](/security/ip-restriction))",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "ip_not_allowed",
              "message": "203.0.113.10 not allowed: this workspace only accepts API calls from the IPs on its allow list. The workspace Owner can add this IP under Administration > Security > IP Restriction in the panel (changes take up to 10 minutes to apply), or call from an allowed IP. See https://developer.omni.z-api.io/en/security/ip-restriction"
            }
          }
        }
      },
      "InstanceNotFound": {
        "description": "Instância (canal) não encontrada",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "instance not found"
            }
          }
        }
      },
      "ProviderRateLimited": {
        "description": "O canal pediu para esperar. O header `Retry-After` traz o tempo em segundos quando o canal o manda. Outras recusas do canal (`4xx`) chegam com o mesmo status que ele deu e o mesmo corpo",
        "headers": {
          "Retry-After": {
            "description": "Segundos a esperar antes de repetir. Só vem quando o canal manda o tempo em segundos",
            "schema": {
              "type": "string"
            },
            "example": "30"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "provider_error"
            }
          }
        }
      },
      "IntegrationTimeout": {
        "description": "O canal passou do prazo para responder. A rota só lê dados: você pode repetir a chamada",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "integration_timeout",
              "message": "The operation took too long to complete. Try again in a few moments."
            }
          }
        }
      }
    }
  }
