{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Webhooks API",
    "description": "API para criar e gerenciar endpoints de webhook por canal. Qualquer secret key válida de um workspace ativo pode usar estas rotas.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/webhooks": {
      "post": {
        "summary": "Criar webhook",
        "description": "Registra um novo endpoint de webhook no canal. A partir da criação, os eventos configurados passam a ser entregues na URL informada.",
        "operationId": "createWebhook",
        "tags": [
          "Webhook de canal"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWebhookRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Básico — receber mensagens",
                  "value": {
                    "url": "https://app.suaempresa.com/webhooks/omni-zapi",
                    "events": [
                      "MESSAGE_RECEIVED"
                    ]
                  }
                },
                "withSignature": {
                  "summary": "Com assinatura HMAC",
                  "value": {
                    "url": "https://app.suaempresa.com/webhooks/omni-zapi",
                    "events": [
                      "MESSAGE_RECEIVED",
                      "MESSAGE_STATUS"
                    ],
                    "signing": true
                  }
                },
                "withBearerAuth": {
                  "summary": "Com autenticação Bearer",
                  "value": {
                    "url": "https://app.suaempresa.com/webhooks/omni-zapi",
                    "events": [
                      "MESSAGE_RECEIVED",
                      "CONNECTED",
                      "DISCONNECTED"
                    ],
                    "auth": {
                      "type": "BEARER",
                      "token": "meu-token-secreto"
                    }
                  }
                },
                "withBasicAuth": {
                  "summary": "Com autenticação Basic",
                  "value": {
                    "url": "https://app.suaempresa.com/webhooks/omni-zapi",
                    "events": [
                      "MESSAGE_RECEIVED"
                    ],
                    "auth": {
                      "type": "BASIC",
                      "username": "webhook-user",
                      "password": "senha-secreta"
                    }
                  }
                },
                "withCustomHeader": {
                  "summary": "Com header customizado",
                  "value": {
                    "url": "https://app.suaempresa.com/webhooks/omni-zapi",
                    "events": [
                      "MESSAGE_RECEIVED",
                      "MESSAGE_STATUS"
                    ],
                    "auth": {
                      "type": "CUSTOM_HEADER",
                      "headerName": "X-Api-Key",
                      "headerValue": "minha-chave-api"
                    }
                  }
                },
                "allEvents": {
                  "summary": "Todos os eventos com HMAC + Bearer",
                  "value": {
                    "url": "https://app.suaempresa.com/webhooks/omni-zapi",
                    "description": "Webhook principal de produção",
                    "events": [
                      "MESSAGE_RECEIVED",
                      "MESSAGE_DELIVERY",
                      "MESSAGE_STATUS",
                      "CONNECTED",
                      "DISCONNECTED"
                    ],
                    "signing": true,
                    "auth": {
                      "type": "BEARER",
                      "token": "meu-token-secreto"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Webhook criado com sucesso. O campo `secret` é retornado **apenas nesta resposta** quando `signing` é `true` — armazene-o com segurança.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookCreatedResponse"
                },
                "examples": {
                  "withSigning": {
                    "summary": "Com assinatura HMAC habilitada",
                    "value": {
                      "id": "A1B2C3D4E5F6789012345678901234AB",
                      "channelId": "019E4C54B1B375A28970B605CA9B03C3",
                      "instanceId": "019E4C54B1B375A28970B605CA9B03C3",
                      "url": "https://app.suaempresa.com/webhooks/omni-zapi",
                      "description": null,
                      "events": [
                        "MESSAGE_RECEIVED",
                        "MESSAGE_STATUS"
                      ],
                      "status": "ENABLED",
                      "signing": true,
                      "secret": "a3f1c2d4e5b6789012345678901234abcdef0123456789abcdef0123456789ab",
                      "auth": {
                        "type": "NONE",
                        "configured": false
                      },
                      "payloadFormat": "DEFAULT",
                      "customAttributes": {},
                      "createdAt": "2025-01-15T10:30:00.000+0000",
                      "updatedAt": "2025-01-15T10:30:00.000+0000"
                    }
                  },
                  "withoutSigning": {
                    "summary": "Sem assinatura HMAC",
                    "value": {
                      "id": "B2C3D4E5F6789012345678901234AB12",
                      "channelId": "019E4C54B1B375A28970B605CA9B03C3",
                      "instanceId": "019E4C54B1B375A28970B605CA9B03C3",
                      "url": "https://app.suaempresa.com/webhooks/omni-zapi",
                      "description": "Webhook principal de produção",
                      "events": [
                        "MESSAGE_RECEIVED",
                        "CONNECTED",
                        "DISCONNECTED"
                      ],
                      "status": "ENABLED",
                      "signing": false,
                      "secret": null,
                      "auth": {
                        "type": "BEARER",
                        "configured": true
                      },
                      "payloadFormat": "DEFAULT",
                      "customAttributes": {},
                      "createdAt": "2025-01-15T10:30:00.000+0000",
                      "updatedAt": "2025-01-15T10:30:00.000+0000"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Corpo inválido: `url` ou `events` ausentes, nome de evento inexistente, `url` fora do formato ou com destino não público, ou autenticação incompleta. Nada é gravado. Também: formato `CHATWOOT` sem `chatwoot_account_id` e `chatwoot_inbox_id` numéricos maiores que zero ou sem autenticação `API_KEY`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorizationInvalid": {
                    "summary": "Header `Authorization` ausente ou inválido",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP de origem fora da lista de IPs do workspace",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  },
                  "urlRequired": {
                    "summary": "`url` ausente ou em branco",
                    "value": {
                      "error": "URL is required"
                    }
                  },
                  "eventsRequired": {
                    "summary": "`events` ausente ou vazio",
                    "value": {
                      "error": "At least one event is required"
                    }
                  },
                  "unknownEvent": {
                    "summary": "Nome de evento inexistente, nulo ou em branco",
                    "value": {
                      "error": "events contains an unknown or empty event name"
                    }
                  },
                  "invalidUrl": {
                    "summary": "URL fora do formato",
                    "value": {
                      "error": "Invalid webhook URL: use an absolute http or https URL up to 2048 characters"
                    }
                  },
                  "urlNotAllowed": {
                    "summary": "Host que não resolve só para endereços públicos",
                    "value": {
                      "error": "Webhook URL not allowed: the host must resolve only to public addresses"
                    }
                  },
                  "headerNameRequired": {
                    "summary": "`CUSTOM_HEADER` sem `headerName`",
                    "value": {
                      "error": "Header name is required for CUSTOM_HEADER auth type"
                    }
                  },
                  "credentialsRequired": {
                    "summary": "Autenticação sem a credencial do tipo",
                    "value": {
                      "error": "Credentials are required when auth type is not NONE"
                    }
                  },
                  "chatwootAccountId": {
                    "summary": "`CHATWOOT` sem `chatwoot_account_id` numérico maior que zero",
                    "value": {
                      "error": "Chatwoot Account ID e obrigatorio (numero > 0) quando o formato e CHATWOOT"
                    }
                  },
                  "chatwootInboxId": {
                    "summary": "`CHATWOOT` sem `chatwoot_inbox_id` numérico maior que zero",
                    "value": {
                      "error": "Chatwoot Inbox ID e obrigatorio (numero > 0) quando o formato e CHATWOOT"
                    }
                  },
                  "chatwootAuth": {
                    "summary": "`CHATWOOT` com autenticação diferente de `API_KEY`",
                    "value": {
                      "error": "Formato CHATWOOT exige autenticacao API_KEY (selecione 'API Key' no tipo de autenticacao)"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Canal inexistente ou de outro workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "422": {
            "description": "Workspace sem configuração ativa, ou evento que o webhook de canal não aceita",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "inactiveWorkspace": {
                    "summary": "Workspace sem configuração ativa",
                    "value": {
                      "error": "Webhook management requires an active workspace"
                    }
                  },
                  "templateEvent": {
                    "summary": "Evento de template no webhook de canal",
                    "value": {
                      "error": "Instance webhooks cannot subscribe to template events"
                    }
                  },
                  "unsupportedEvent": {
                    "summary": "Evento que o canal não emite",
                    "value": {
                      "error": "Events [PRESENCE_CHAT] are not supported by middleware META_WHATSAPP"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Não foi possível consultar o DNS do host da `url` agora. Nada é gravado: tente de novo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Could not verify the webhook URL now, try again"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Listar webhooks",
        "description": "Retorna todos os webhooks cadastrados no canal. Credenciais de autenticação e o `secret` HMAC não são retornados por segurança.",
        "operationId": "listWebhooks",
        "tags": [
          "Webhook de canal"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de webhooks do canal",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WebhookResponse"
                  }
                },
                "example": [
                  {
                    "id": "A1B2C3D4E5F6789012345678901234AB",
                    "channelId": "019E4C54B1B375A28970B605CA9B03C3",
                    "instanceId": "019E4C54B1B375A28970B605CA9B03C3",
                    "url": "https://app.suaempresa.com/webhooks/omni-zapi",
                    "description": "Webhook principal de produção",
                    "events": [
                      "MESSAGE_RECEIVED",
                      "MESSAGE_STATUS"
                    ],
                    "status": "ENABLED",
                    "signing": true,
                    "auth": {
                      "type": "BEARER",
                      "configured": true
                    },
                    "payloadFormat": "DEFAULT",
                    "customAttributes": {},
                    "createdAt": "2025-01-15T10:30:00.000+0000",
                    "updatedAt": "2025-01-15T10:30:00.000+0000"
                  },
                  {
                    "id": "B2C3D4E5F6789012345678901234AB12",
                    "channelId": "019E4C54B1B375A28970B605CA9B03C3",
                    "instanceId": "019E4C54B1B375A28970B605CA9B03C3",
                    "url": "https://app.suaempresa.com/webhooks/eventos-conexao",
                    "description": "Eventos de conexão",
                    "events": [
                      "CONNECTED",
                      "DISCONNECTED"
                    ],
                    "status": "ENABLED",
                    "signing": false,
                    "auth": {
                      "type": "NONE",
                      "configured": false
                    },
                    "payloadFormat": "DEFAULT",
                    "customAttributes": {},
                    "createdAt": "2025-01-16T08:00:00.000+0000",
                    "updatedAt": "2025-01-16T08:00:00.000+0000"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Header `Authorization` ausente ou inválido, ou IP de origem fora da lista do workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorizationInvalid": {
                    "summary": "Header `Authorization` ausente ou inválido",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP de origem fora da lista de IPs do workspace",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Workspace sem configuração ativa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Webhook management requires an active workspace"
                }
              }
            }
          }
        }
      }
    },
    "/v1/channels/{channelId}/webhooks/{webhookId}": {
      "get": {
        "summary": "Detalhar webhook",
        "description": "Retorna os dados de um webhook específico. Credenciais e `secret` não são retornados.",
        "operationId": "getWebhook",
        "tags": [
          "Webhook de canal"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          },
          {
            "name": "webhookId",
            "in": "path",
            "required": true,
            "description": "ID do webhook",
            "schema": {
              "type": "string",
              "example": "A1B2C3D4E5F6789012345678901234AB"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do webhook",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookResponse"
                },
                "example": {
                  "id": "A1B2C3D4E5F6789012345678901234AB",
                  "channelId": "019E4C54B1B375A28970B605CA9B03C3",
                  "instanceId": "019E4C54B1B375A28970B605CA9B03C3",
                  "url": "https://app.suaempresa.com/webhooks/omni-zapi",
                  "description": "Webhook principal de produção",
                  "events": [
                    "MESSAGE_RECEIVED",
                    "MESSAGE_STATUS"
                  ],
                  "status": "ENABLED",
                  "signing": true,
                  "auth": {
                    "type": "BEARER",
                    "configured": true
                  },
                  "payloadFormat": "DEFAULT",
                  "customAttributes": {},
                  "createdAt": "2025-01-15T10:30:00.000+0000",
                  "updatedAt": "2025-01-15T10:30:00.000+0000"
                }
              }
            }
          },
          "400": {
            "description": "Header `Authorization` ausente ou inválido, ou IP de origem fora da lista do workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorizationInvalid": {
                    "summary": "Header `Authorization` ausente ou inválido",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP de origem fora da lista de IPs do workspace",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Webhook não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Webhook not found"
                }
              }
            }
          },
          "422": {
            "description": "Workspace sem configuração ativa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Webhook management requires an active workspace"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Atualizar webhook",
        "description": "Atualiza parcialmente a configuração do webhook. Apenas os campos enviados são atualizados.",
        "operationId": "updateWebhook",
        "tags": [
          "Webhook de canal"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          },
          {
            "name": "webhookId",
            "in": "path",
            "required": true,
            "description": "ID do webhook",
            "schema": {
              "type": "string",
              "example": "A1B2C3D4E5F6789012345678901234AB"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateWebhookRequest"
              },
              "examples": {
                "disable": {
                  "summary": "Desabilitar webhook",
                  "value": {
                    "status": "DISABLED"
                  }
                },
                "reenable": {
                  "summary": "Reabilitar webhook",
                  "value": {
                    "status": "ENABLED"
                  }
                },
                "updateUrlAndEvents": {
                  "summary": "Atualizar URL e eventos",
                  "value": {
                    "url": "https://nova-url.suaempresa.com/webhooks/omni-zapi",
                    "events": [
                      "MESSAGE_RECEIVED",
                      "MESSAGE_STATUS",
                      "CONNECTED",
                      "DISCONNECTED"
                    ]
                  }
                },
                "enableSignature": {
                  "summary": "Habilitar / rotacionar assinatura HMAC",
                  "value": {
                    "signing": true
                  }
                },
                "updateAuth": {
                  "summary": "Atualizar autenticação para Bearer",
                  "value": {
                    "auth": {
                      "type": "BEARER",
                      "token": "novo-token-secreto"
                    }
                  }
                },
                "disableSignature": {
                  "summary": "Remover a assinatura HMAC",
                  "value": {
                    "signing": false
                  }
                },
                "updateAuthFlat": {
                  "summary": "Atualizar autenticação (forma plana)",
                  "value": {
                    "authType": "API_KEY",
                    "key": "nova-chave"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook atualizado com sucesso. O campo `secret` é retornado **apenas** quando `signing` foi habilitado nesta atualização.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookCreatedResponse"
                },
                "examples": {
                  "afterEnableSigning": {
                    "summary": "Após habilitar assinatura (secret retornado)",
                    "value": {
                      "id": "A1B2C3D4E5F6789012345678901234AB",
                      "channelId": "019E4C54B1B375A28970B605CA9B03C3",
                      "instanceId": "019E4C54B1B375A28970B605CA9B03C3",
                      "url": "https://app.suaempresa.com/webhooks/omni-zapi",
                      "description": "Webhook principal de produção",
                      "events": [
                        "MESSAGE_RECEIVED",
                        "MESSAGE_STATUS"
                      ],
                      "status": "ENABLED",
                      "signing": true,
                      "secret": "d4e5f6789012345678901234abcdef0123456789abcdef0123456789ab12c3d4",
                      "auth": {
                        "type": "BEARER",
                        "configured": true
                      },
                      "payloadFormat": "DEFAULT",
                      "customAttributes": {},
                      "createdAt": "2025-01-15T10:30:00.000+0000",
                      "updatedAt": "2025-01-20T14:00:00.000+0000"
                    }
                  },
                  "afterDisable": {
                    "summary": "Após desabilitar (sem secret)",
                    "value": {
                      "id": "A1B2C3D4E5F6789012345678901234AB",
                      "channelId": "019E4C54B1B375A28970B605CA9B03C3",
                      "instanceId": "019E4C54B1B375A28970B605CA9B03C3",
                      "url": "https://app.suaempresa.com/webhooks/omni-zapi",
                      "description": "Webhook principal de produção",
                      "events": [
                        "MESSAGE_RECEIVED",
                        "MESSAGE_STATUS"
                      ],
                      "status": "DISABLED",
                      "signing": true,
                      "secret": null,
                      "auth": {
                        "type": "BEARER",
                        "configured": true
                      },
                      "payloadFormat": "DEFAULT",
                      "customAttributes": {},
                      "createdAt": "2025-01-15T10:30:00.000+0000",
                      "updatedAt": "2025-01-20T15:00:00.000+0000"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Corpo inválido: `events` vazio, nome de evento inexistente, `status` fora de `ENABLED` e `DISABLED`, nova `url` fora do formato ou com destino não público, ou autenticação incompleta. Nada é alterado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorizationInvalid": {
                    "summary": "Header `Authorization` ausente ou inválido",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP de origem fora da lista de IPs do workspace",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  },
                  "emptyEvents": {
                    "summary": "`events` enviado vazio",
                    "value": {
                      "error": "Events cannot be empty when provided"
                    }
                  },
                  "unknownEvent": {
                    "summary": "Nome de evento inexistente, nulo ou em branco",
                    "value": {
                      "error": "events contains an unknown or empty event name"
                    }
                  },
                  "invalidStatus": {
                    "summary": "`status` diferente de `ENABLED` e `DISABLED`",
                    "value": {
                      "error": "status must be one of [ENABLED, DISABLED]"
                    }
                  },
                  "invalidUrl": {
                    "summary": "URL fora do formato",
                    "value": {
                      "error": "Invalid webhook URL: use an absolute http or https URL up to 2048 characters"
                    }
                  },
                  "urlNotAllowed": {
                    "summary": "Host que não resolve só para endereços públicos",
                    "value": {
                      "error": "Webhook URL not allowed: the host must resolve only to public addresses"
                    }
                  },
                  "headerNameRequired": {
                    "summary": "`CUSTOM_HEADER` sem `headerName`",
                    "value": {
                      "error": "Header name is required for CUSTOM_HEADER auth type"
                    }
                  },
                  "credentialsRequired": {
                    "summary": "Autenticação sem a credencial do tipo",
                    "value": {
                      "error": "Credentials are required when auth type is not NONE"
                    }
                  },
                  "chatwootAttributes": {
                    "summary": "Troca para `CHATWOOT` sem `customAttributes`",
                    "value": {
                      "error": "Account ID e Inbox ID do Chatwoot sao obrigatorios ao trocar para o formato CHATWOOT"
                    }
                  },
                  "chatwootAccountId": {
                    "summary": "`CHATWOOT` sem `chatwoot_account_id` numérico maior que zero",
                    "value": {
                      "error": "Chatwoot Account ID e obrigatorio (numero > 0) quando o formato e CHATWOOT"
                    }
                  },
                  "chatwootInboxId": {
                    "summary": "`CHATWOOT` sem `chatwoot_inbox_id` numérico maior que zero",
                    "value": {
                      "error": "Chatwoot Inbox ID e obrigatorio (numero > 0) quando o formato e CHATWOOT"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Webhook não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Webhook not found"
                }
              }
            }
          },
          "422": {
            "description": "Workspace sem configuração ativa, ou evento que o webhook de canal não aceita",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "inactiveWorkspace": {
                    "summary": "Workspace sem configuração ativa",
                    "value": {
                      "error": "Webhook management requires an active workspace"
                    }
                  },
                  "templateEvent": {
                    "summary": "Evento de template no webhook de canal",
                    "value": {
                      "error": "Instance webhooks cannot subscribe to template events"
                    }
                  },
                  "unsupportedEvent": {
                    "summary": "Evento que o canal não emite",
                    "value": {
                      "error": "Events [PRESENCE_CHAT] are not supported by middleware META_WHATSAPP"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Não foi possível consultar o DNS do host da `url` agora. Nada é gravado: tente de novo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Could not verify the webhook URL now, try again"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remover webhook",
        "description": "Remove permanentemente o webhook. A partir da exclusão, nenhum evento é mais entregue na URL configurada.",
        "operationId": "deleteWebhook",
        "tags": [
          "Webhook de canal"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          },
          {
            "name": "webhookId",
            "in": "path",
            "required": true,
            "description": "ID do webhook",
            "schema": {
              "type": "string",
              "example": "A1B2C3D4E5F6789012345678901234AB"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Webhook deletado com sucesso. Nenhum conteúdo retornado."
          },
          "400": {
            "description": "Header `Authorization` ausente ou inválido, ou IP de origem fora da lista do workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorizationInvalid": {
                    "summary": "Header `Authorization` ausente ou inválido",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP de origem fora da lista de IPs do workspace",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Webhook não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Webhook not found"
                }
              }
            }
          },
          "422": {
            "description": "Workspace sem configuração ativa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Webhook management requires an active workspace"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateWebhookRequest": {
        "type": "object",
        "required": [
          "url",
          "events"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "URL de destino dos eventos: absoluta, `http` ou `https`, com até 2048 caracteres. O host precisa existir no DNS e resolver só para endereços públicos; senão, `400`.",
            "example": "https://app.suaempresa.com/webhooks/omni-zapi"
          },
          "description": {
            "type": "string",
            "description": "Descrição opcional do webhook",
            "example": "Webhook principal de produção"
          },
          "events": {
            "type": "array",
            "description": "Tipos de evento a receber. Pelo menos um obrigatório. O nome é aceito em maiúsculas ou minúsculas; nome inexistente, nulo ou em branco retorna `400`. Cada evento precisa ser emitido pelo tipo do canal; senão, `422`. Veja a matriz em Webhooks de canal.",
            "items": {
              "type": "string",
              "enum": [
                "MESSAGE_RECEIVED",
                "MESSAGE_DELIVERY",
                "MESSAGE_STATUS",
                "RECEIVED_STATUS",
                "RECEIVED_AND_DELIVERY",
                "CONNECTED",
                "DISCONNECTED",
                "PRESENCE_CHAT",
                "INITIAL_DATA",
                "BLOCK"
              ]
            },
            "example": [
              "MESSAGE_RECEIVED",
              "MESSAGE_STATUS"
            ]
          },
          "signing": {
            "type": "boolean",
            "description": "Habilita assinatura HMAC-SHA256. Quando `true`, um `secret` de 64 caracteres hex é gerado e retornado **apenas na criação/atualização**. Use-o para verificar a autenticidade das requisições recebidas.",
            "default": false,
            "example": true
          },
          "authType": {
            "type": "string",
            "enum": [
              "NONE",
              "BEARER",
              "API_KEY",
              "BASIC",
              "CUSTOM_HEADER"
            ],
            "description": "Tipo de autenticação (forma plana). Alternativa a `auth.type`. `NONE` limpa a autenticação."
          },
          "token": {
            "type": "string",
            "description": "Credencial para `BEARER` (forma plana)."
          },
          "key": {
            "type": "string",
            "description": "Credencial para `API_KEY` (forma plana)."
          },
          "auth": {
            "$ref": "#/components/schemas/WebhookAuth"
          },
          "payloadFormat": {
            "type": "string",
            "enum": [
              "DEFAULT",
              "Z_API",
              "CHATWOOT"
            ],
            "description": "Formato do payload entregue ao webhook. `DEFAULT` é o formato do Z-API Omni; `Z_API` mantém a estrutura da Z-API para quem está migrando; `CHATWOOT` entrega no formato esperado pelo Chatwoot.",
            "default": "DEFAULT",
            "example": "DEFAULT"
          },
          "customAttributes": {
            "type": "object",
            "description": "Atributos extras. No formato `CHATWOOT`, obrigatório com `chatwoot_account_id` e `chatwoot_inbox_id` numéricos maiores que zero; a autenticação precisa ser `API_KEY`, com a API Key do Chatwoot.",
            "additionalProperties": true,
            "example": {}
          }
        }
      },
      "UpdateWebhookRequest": {
        "type": "object",
        "description": "Todos os campos são opcionais — apenas os campos enviados são atualizados.",
        "properties": {
          "url": {
            "type": "string",
            "description": "Nova URL de destino, com as mesmas regras da criação. Só é conferida quando muda.",
            "example": "https://nova-url.suaempresa.com/webhooks/omni-zapi"
          },
          "description": {
            "type": "string",
            "description": "Nova descrição"
          },
          "events": {
            "type": "array",
            "description": "Nova lista de eventos. Substitui os eventos que a API conhece; um evento gravado que a API ainda não conhece é mantido. Não pode ser vazia (`400`). Cada evento precisa ser emitido pelo tipo do canal (senão `422`); um evento já gravado no webhook continua aceito.",
            "items": {
              "type": "string",
              "enum": [
                "MESSAGE_RECEIVED",
                "MESSAGE_DELIVERY",
                "MESSAGE_STATUS",
                "RECEIVED_STATUS",
                "RECEIVED_AND_DELIVERY",
                "CONNECTED",
                "DISCONNECTED",
                "PRESENCE_CHAT",
                "INITIAL_DATA",
                "BLOCK"
              ]
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ENABLED",
              "DISABLED"
            ],
            "description": "`DISABLED` pausa a entrega de eventos sem excluir o webhook Outro valor retorna `400`."
          },
          "signing": {
            "type": "boolean",
            "description": "`true` gera um novo `secret`, retornado só nesta resposta (rotaciona toda vez). `false` remove a assinatura. Omita para não mudar."
          },
          "authType": {
            "type": "string",
            "enum": [
              "NONE",
              "BEARER",
              "API_KEY",
              "BASIC",
              "CUSTOM_HEADER"
            ],
            "description": "Tipo de autenticação (forma plana). Alternativa a `auth.type`. `NONE` limpa a autenticação."
          },
          "token": {
            "type": "string",
            "description": "Credencial para `BEARER` (forma plana)."
          },
          "key": {
            "type": "string",
            "description": "Credencial para `API_KEY` (forma plana)."
          },
          "auth": {
            "$ref": "#/components/schemas/WebhookAuth"
          },
          "payloadFormat": {
            "type": "string",
            "enum": [
              "DEFAULT",
              "Z_API",
              "CHATWOOT"
            ]
          },
          "customAttributes": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "WebhookAuth": {
        "type": "object",
        "description": "Configura como o Z-API Omni se autentica ao chamar sua URL",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "NONE",
              "BEARER",
              "API_KEY",
              "BASIC",
              "CUSTOM_HEADER"
            ],
            "description": "Tipo de autenticação",
            "example": "BEARER"
          },
          "token": {
            "type": "string",
            "description": "Token para autenticação `BEARER` — enviado no header `Authorization: Bearer <token>`",
            "example": "meu-token-secreto"
          },
          "key": {
            "type": "string",
            "description": "Chave para autenticação `API_KEY`"
          },
          "username": {
            "type": "string",
            "description": "Usuário para autenticação `BASIC`"
          },
          "password": {
            "type": "string",
            "description": "Senha para autenticação `BASIC`"
          },
          "headerName": {
            "type": "string",
            "description": "Nome do header para `CUSTOM_HEADER`",
            "example": "X-Api-Key"
          },
          "headerValue": {
            "type": "string",
            "description": "Valor do header para `CUSTOM_HEADER`"
          }
        }
      },
      "WebhookAuthInfo": {
        "type": "object",
        "description": "Resumo da autenticação configurada — credenciais não são retornadas por segurança",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "NONE",
              "BEARER",
              "API_KEY",
              "BASIC",
              "CUSTOM_HEADER"
            ],
            "example": "BEARER"
          },
          "configured": {
            "type": "boolean",
            "description": "`true` quando credenciais estão configuradas",
            "example": true
          }
        }
      },
      "WebhookResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID único do webhook",
            "example": "A1B2C3D4E5F6789012345678901234AB"
          },
          "channelId": {
            "type": "string",
            "description": "ID do canal ao qual o webhook pertence",
            "example": "019E4C54B1B375A28970B605CA9B03C3"
          },
          "instanceId": {
            "type": "string",
            "deprecated": true,
            "description": "Descontinuado — use `channelId`",
            "example": "019E4C54B1B375A28970B605CA9B03C3"
          },
          "url": {
            "type": "string",
            "description": "URL de destino dos eventos",
            "example": "https://app.suaempresa.com/webhooks/omni-zapi"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Descrição do webhook",
            "example": "Webhook principal de produção"
          },
          "events": {
            "type": "array",
            "description": "Tipos de evento configurados Evento gravado que a API ainda não conhece não aparece aqui.",
            "items": {
              "type": "string"
            },
            "example": [
              "MESSAGE_RECEIVED",
              "MESSAGE_STATUS"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ENABLED",
              "DISABLED"
            ],
            "description": "Status atual do webhook",
            "example": "ENABLED"
          },
          "signing": {
            "type": "boolean",
            "description": "Indica se a assinatura HMAC está habilitada",
            "example": true
          },
          "auth": {
            "$ref": "#/components/schemas/WebhookAuthInfo"
          },
          "payloadFormat": {
            "type": "string",
            "enum": [
              "DEFAULT",
              "Z_API",
              "CHATWOOT"
            ],
            "description": "Formato do payload entregue",
            "example": "DEFAULT"
          },
          "customAttributes": {
            "type": "object",
            "additionalProperties": true,
            "description": "Atributos extras configurados",
            "example": {}
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Data de criação",
            "example": "2025-01-15T10:30:00.000+0000"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Data da última atualização",
            "example": "2025-01-15T10:30:00.000+0000"
          }
        }
      },
      "WebhookCreatedResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/WebhookResponse"
          },
          {
            "type": "object",
            "properties": {
              "secret": {
                "type": "string",
                "description": "Segredo HMAC de 64 caracteres hex — retornado **apenas** quando `signing` é habilitado no create ou update. Armazene-o com segurança; não poderá ser recuperado depois.",
                "example": "a3f1c2d4e5b6789012345678901234abcdef0123456789abcdef0123456789ab"
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Mensagem do erro"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key gerada no painel de Segurança do Z-API Omni"
      }
    }
  }
}
