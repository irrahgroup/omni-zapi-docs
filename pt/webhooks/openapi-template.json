{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Webhook global (eventos da conta)",
    "description": "API para criar e gerenciar o webhook global do workspace: endpoints que recebem os eventos da conta (templates do WhatsApp, cobrança, restrição da conta e desconexão de canal) e não dependem de uma instância (`instanceId` gravado como `null`). O webhook global é entregue no formato `DEFAULT`. Qualquer secret key válida de um workspace ativo pode usar estas rotas.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/webhooks": {
      "post": {
        "summary": "Criar webhook global",
        "description": "Cria um webhook global. Não depende de instância (`instanceId` gravado como `null`) e aceita **somente** eventos da conta. É entregue no formato `DEFAULT`: use sempre `DEFAULT`. Com `ACCOUNT_RESTRICTION`, `payloadFormat` `Z_API` ou `CHATWOOT` responde `422`.",
        "operationId": "createTemplateWebhook",
        "tags": [
          "Webhook global (eventos da conta)"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTemplateWebhookRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Básico — eventos de template",
                  "value": {
                    "url": "https://app.suaempresa.com/webhooks/templates",
                    "description": "Webhook de template",
                    "events": [
                      "UPDATE_TEMPLATE_STATUS",
                      "UPDATE_TEMPLATE_CATEGORY"
                    ],
                    "signing": false,
                    "authType": "NONE"
                  }
                },
                "withSignature": {
                  "summary": "Com assinatura HMAC",
                  "value": {
                    "url": "https://app.suaempresa.com/webhooks/templates",
                    "events": [
                      "UPDATE_TEMPLATE_STATUS"
                    ],
                    "signing": true
                  }
                },
                "withBearerAuth": {
                  "summary": "Com autenticação Bearer",
                  "value": {
                    "url": "https://app.suaempresa.com/webhooks/templates",
                    "events": [
                      "UPDATE_TEMPLATE_STATUS",
                      "UPDATE_TEMPLATE_CATEGORY"
                    ],
                    "auth": {
                      "type": "BEARER",
                      "token": "meu-token-secreto"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Webhook de template criado com sucesso. `channelId` e `instanceId` vêm `null`. O campo `secret` é retornado **apenas nesta resposta** quando `signing` é `true`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateWebhookCreatedResponse"
                },
                "example": {
                  "id": "8F2C00000000000000000000000000A1",
                  "channelId": null,
                  "instanceId": null,
                  "url": "https://app.suaempresa.com/webhooks/templates",
                  "description": "Webhook de template",
                  "events": [
                    "UPDATE_TEMPLATE_STATUS",
                    "UPDATE_TEMPLATE_CATEGORY"
                  ],
                  "status": "ENABLED",
                  "signing": false,
                  "secret": null,
                  "auth": {
                    "type": "NONE",
                    "configured": false
                  },
                  "payloadFormat": "DEFAULT",
                  "customAttributes": {},
                  "createdAt": "2026-07-15T19:00:00.000+00:00",
                  "updatedAt": "2026-07-15T19:00:00.000+00:00"
                }
              }
            }
          },
          "400": {
            "description": "Header `Authorization` ausente ou inválido, ou corpo inválido: `url` ou `events` ausentes, nome de evento inexistente, `url` fora do formato ou com destino não público, ou autenticação incompleta. Nada é gravado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "ipNotAllowed": {
                    "summary": "IP de origem fora da lista de IPs do workspace",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  },
                  "authorizationInvalid": {
                    "summary": "Header `Authorization` ausente ou inválido",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "urlRequired": {
                    "summary": "`url` ausente ou em branco",
                    "value": {
                      "error": "URL is required"
                    }
                  },
                  "eventsRequired": {
                    "summary": "`events` ausente ou vazio",
                    "value": {
                      "error": "At least one event is required"
                    }
                  },
                  "unknownEvent": {
                    "summary": "Nome de evento inexistente, nulo ou em branco",
                    "value": {
                      "error": "events contains an unknown or empty event name"
                    }
                  },
                  "invalidUrl": {
                    "summary": "URL fora do formato",
                    "value": {
                      "error": "Invalid webhook URL: use an absolute http or https URL up to 2048 characters"
                    }
                  },
                  "urlNotAllowed": {
                    "summary": "Host que não resolve só para endereços públicos",
                    "value": {
                      "error": "Webhook URL not allowed: the host must resolve only to public addresses"
                    }
                  },
                  "headerNameRequired": {
                    "summary": "`CUSTOM_HEADER` sem `headerName`",
                    "value": {
                      "error": "Header name is required for CUSTOM_HEADER auth type"
                    }
                  },
                  "credentialsRequired": {
                    "summary": "Autenticação sem a credencial do tipo",
                    "value": {
                      "error": "Credentials are required when auth type is not NONE"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Workspace sem configuração ativa; ou escopo de eventos inválido (evento não-template); ou formato diferente de `DEFAULT` com `ACCOUNT_RESTRICTION` ou eventos da plataforma.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "inactiveWorkspace": {
                    "summary": "Workspace sem configuração ativa",
                    "value": {
                      "error": "Webhook management requires an active workspace"
                    }
                  },
                  "invalidScope": {
                    "summary": "Evento não-template",
                    "value": {
                      "error": "Global webhooks (without instance) accept only template events"
                    }
                  },
                  "accountRestrictionFormat": {
                    "summary": "`ACCOUNT_RESTRICTION` com `payloadFormat` `Z_API` ou `CHATWOOT`",
                    "value": {
                      "error": "ACCOUNT_RESTRICTION only supports DEFAULT payload format"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Não foi possível consultar o DNS do host da `url` agora. Nada é gravado: tente de novo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Could not verify the webhook URL now, try again"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Listar webhooks globais",
        "description": "Retorna os webhooks de template habilitados do tenant. As credenciais de autenticação e o `secret` HMAC **não** são retornados por segurança.",
        "operationId": "listTemplateWebhooks",
        "tags": [
          "Webhook global (eventos da conta)"
        ],
        "responses": {
          "200": {
            "description": "Lista de webhooks de template do tenant",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TemplateWebhookResponse"
                  }
                },
                "example": [
                  {
                    "id": "8F2C00000000000000000000000000A1",
                    "channelId": null,
                    "instanceId": null,
                    "url": "https://app.suaempresa.com/webhooks/templates",
                    "description": "Webhook de template",
                    "events": [
                      "UPDATE_TEMPLATE_STATUS",
                      "UPDATE_TEMPLATE_CATEGORY"
                    ],
                    "status": "ENABLED",
                    "signing": false,
                    "auth": {
                      "type": "NONE",
                      "configured": false
                    },
                    "payloadFormat": "DEFAULT",
                    "customAttributes": {},
                    "createdAt": "2026-07-15T19:00:00.000+00:00",
                    "updatedAt": "2026-07-15T19:00:00.000+00:00"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Header `Authorization` ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorizationInvalid": {
                    "summary": "Header `Authorization` ausente ou inválido",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP de origem fora da lista de IPs do workspace",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Workspace sem configuração ativa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Webhook management requires an active workspace"
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks/{webhookId}": {
      "get": {
        "summary": "Detalhar webhook global",
        "description": "Retorna os dados de um webhook de template específico do tenant. Credenciais e `secret` não são retornados.",
        "operationId": "getTemplateWebhook",
        "tags": [
          "Webhook global (eventos da conta)"
        ],
        "parameters": [
          {
            "name": "webhookId",
            "in": "path",
            "required": true,
            "description": "ID do webhook de template",
            "schema": {
              "type": "string",
              "example": "8F2C00000000000000000000000000A1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do webhook de template",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateWebhookResponse"
                },
                "example": {
                  "id": "8F2C00000000000000000000000000A1",
                  "channelId": null,
                  "instanceId": null,
                  "url": "https://app.suaempresa.com/webhooks/templates",
                  "description": "Webhook de template",
                  "events": [
                    "UPDATE_TEMPLATE_STATUS"
                  ],
                  "status": "ENABLED",
                  "signing": false,
                  "auth": {
                    "type": "NONE",
                    "configured": false
                  },
                  "payloadFormat": "DEFAULT",
                  "customAttributes": {},
                  "createdAt": "2026-07-15T19:00:00.000+00:00",
                  "updatedAt": "2026-07-15T19:00:00.000+00:00"
                }
              }
            }
          },
          "400": {
            "description": "Header `Authorization` ausente ou inválido, ou IP de origem fora da lista do workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorizationInvalid": {
                    "summary": "Header `Authorization` ausente ou inválido",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP de origem fora da lista de IPs do workspace",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Webhook não encontrado para o tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Webhook not found"
                }
              }
            }
          },
          "422": {
            "description": "Workspace sem configuração ativa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Webhook management requires an active workspace"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Atualizar webhook global",
        "description": "Atualiza parcialmente o webhook global. Apenas os campos enviados são alterados; os omitidos permanecem inalterados. Se `events` for enviado, deve conter **somente** eventos da conta. Um `PATCH` que deixaria o webhook com `ACCOUNT_RESTRICTION` ou com eventos da plataforma (cobrança, `CHANNEL_DISCONNECTED`) em formato diferente de `DEFAULT` responde `422`.",
        "operationId": "updateTemplateWebhook",
        "tags": [
          "Webhook global (eventos da conta)"
        ],
        "parameters": [
          {
            "name": "webhookId",
            "in": "path",
            "required": true,
            "description": "ID do webhook de template",
            "schema": {
              "type": "string",
              "example": "8F2C00000000000000000000000000A1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTemplateWebhookRequest"
              },
              "examples": {
                "updateUrlAndStatus": {
                  "summary": "Atualizar URL e desabilitar",
                  "value": {
                    "url": "https://nova-url.suaempresa.com/webhooks/templates",
                    "status": "DISABLED"
                  }
                },
                "updateEvents": {
                  "summary": "Atualizar eventos de template",
                  "value": {
                    "events": [
                      "UPDATE_TEMPLATE_STATUS",
                      "UPDATE_TEMPLATE_CATEGORY"
                    ]
                  }
                },
                "enableSignature": {
                  "summary": "Habilitar / rotacionar assinatura HMAC",
                  "value": {
                    "signing": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook de template atualizado. O campo `secret` é retornado **apenas** quando `signing = true` nesta atualização.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateWebhookCreatedResponse"
                },
                "example": {
                  "id": "8F2C00000000000000000000000000A1",
                  "channelId": null,
                  "instanceId": null,
                  "url": "https://nova-url.suaempresa.com/webhooks/templates",
                  "description": "Webhook de template",
                  "events": [
                    "UPDATE_TEMPLATE_STATUS",
                    "UPDATE_TEMPLATE_CATEGORY"
                  ],
                  "status": "DISABLED",
                  "signing": false,
                  "secret": null,
                  "auth": {
                    "type": "NONE",
                    "configured": false
                  },
                  "payloadFormat": "DEFAULT",
                  "customAttributes": {},
                  "createdAt": "2026-07-15T19:00:00.000+00:00",
                  "updatedAt": "2026-07-15T19:30:00.000+00:00"
                }
              }
            }
          },
          "400": {
            "description": "Corpo inválido: `events` vazio, nome de evento inexistente, `status` fora de `ENABLED` e `DISABLED`, nova `url` fora do formato ou com destino não público, ou autenticação incompleta. Nada é alterado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorizationInvalid": {
                    "summary": "Header `Authorization` ausente ou inválido",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP de origem fora da lista de IPs do workspace",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  },
                  "emptyEvents": {
                    "summary": "`events` enviado vazio",
                    "value": {
                      "error": "Events cannot be empty when provided"
                    }
                  },
                  "unknownEvent": {
                    "summary": "Nome de evento inexistente, nulo ou em branco",
                    "value": {
                      "error": "events contains an unknown or empty event name"
                    }
                  },
                  "invalidStatus": {
                    "summary": "`status` diferente de `ENABLED` e `DISABLED`",
                    "value": {
                      "error": "status must be one of [ENABLED, DISABLED]"
                    }
                  },
                  "invalidUrl": {
                    "summary": "URL fora do formato",
                    "value": {
                      "error": "Invalid webhook URL: use an absolute http or https URL up to 2048 characters"
                    }
                  },
                  "urlNotAllowed": {
                    "summary": "Host que não resolve só para endereços públicos",
                    "value": {
                      "error": "Webhook URL not allowed: the host must resolve only to public addresses"
                    }
                  },
                  "headerNameRequired": {
                    "summary": "`CUSTOM_HEADER` sem `headerName`",
                    "value": {
                      "error": "Header name is required for CUSTOM_HEADER auth type"
                    }
                  },
                  "credentialsRequired": {
                    "summary": "Autenticação sem a credencial do tipo",
                    "value": {
                      "error": "Credentials are required when auth type is not NONE"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Webhook não encontrado para o tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Webhook not found"
                }
              }
            }
          },
          "422": {
            "description": "Workspace sem configuração ativa; ou escopo de eventos inválido; ou formato diferente de `DEFAULT` com `ACCOUNT_RESTRICTION` ou eventos da plataforma.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "inactiveWorkspace": {
                    "summary": "Workspace sem configuração ativa",
                    "value": {
                      "error": "Webhook management requires an active workspace"
                    }
                  },
                  "invalidScope": {
                    "summary": "Evento não-template",
                    "value": {
                      "error": "Global webhooks (without instance) accept only template events"
                    }
                  },
                  "accountRestrictionFormat": {
                    "summary": "`ACCOUNT_RESTRICTION` com `payloadFormat` `Z_API` ou `CHATWOOT`",
                    "value": {
                      "error": "ACCOUNT_RESTRICTION only supports DEFAULT payload format"
                    }
                  },
                  "platformEventsFormat": {
                    "summary": "Eventos da plataforma (cobrança, `CHANNEL_DISCONNECTED`) em formato diferente de `DEFAULT`",
                    "value": {
                      "error": "Platform events are delivered only in DEFAULT payload format"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Não foi possível consultar o DNS do host da `url` agora. Nada é gravado: tente de novo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Could not verify the webhook URL now, try again"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remover webhook global",
        "description": "Remove permanentemente o webhook de template. Após a exclusão, nenhum evento de template é mais entregue na URL configurada.",
        "operationId": "deleteTemplateWebhook",
        "tags": [
          "Webhook global (eventos da conta)"
        ],
        "parameters": [
          {
            "name": "webhookId",
            "in": "path",
            "required": true,
            "description": "ID do webhook de template",
            "schema": {
              "type": "string",
              "example": "8F2C00000000000000000000000000A1"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Webhook removido com sucesso. Nenhum conteúdo retornado."
          },
          "400": {
            "description": "Header `Authorization` ausente ou inválido, ou IP de origem fora da lista do workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorizationInvalid": {
                    "summary": "Header `Authorization` ausente ou inválido",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP de origem fora da lista de IPs do workspace",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Webhook não encontrado para o tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Webhook not found"
                }
              }
            }
          },
          "422": {
            "description": "Workspace sem configuração ativa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Webhook management requires an active workspace"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateTemplateWebhookRequest": {
        "type": "object",
        "required": [
          "url",
          "events"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "URL de destino dos eventos: absoluta, `http` ou `https`, com até 2048 caracteres. O host precisa existir no DNS e resolver só para endereços públicos; senão, `400`.",
            "example": "https://app.suaempresa.com/webhooks/templates"
          },
          "description": {
            "type": "string",
            "description": "Descrição opcional do webhook",
            "example": "Webhook de template"
          },
          "events": {
            "type": "array",
            "description": "Somente eventos da conta: `UPDATE_TEMPLATE_STATUS`, `UPDATE_TEMPLATE_CATEGORY`, os cinco `BILLING_*`, `ACCOUNT_RESTRICTION` e `CHANNEL_DISCONNECTED`. Evento de canal resulta em `422`; nome inexistente, nulo ou em branco resulta em `400`.",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/TemplateEvent"
            },
            "example": [
              "UPDATE_TEMPLATE_STATUS",
              "UPDATE_TEMPLATE_CATEGORY"
            ]
          },
          "signing": {
            "type": "boolean",
            "description": "Habilita assinatura HMAC-SHA256. Quando `true`, gera e retorna um `secret` de 64 caracteres hex **apenas na criação/atualização**.",
            "default": false,
            "example": false
          },
          "authType": {
            "type": "string",
            "enum": [
              "NONE",
              "BEARER",
              "API_KEY",
              "BASIC",
              "CUSTOM_HEADER"
            ],
            "description": "Tipo de autenticação (forma plana). Alternativa ao objeto `auth`.",
            "default": "NONE",
            "example": "NONE"
          },
          "token": {
            "type": "string",
            "description": "Credencial para `BEARER` (forma plana)"
          },
          "key": {
            "type": "string",
            "description": "Credencial para `API_KEY` (forma plana)"
          },
          "auth": {
            "$ref": "#/components/schemas/WebhookAuth"
          },
          "payloadFormat": {
            "type": "string",
            "enum": [
              "DEFAULT",
              "Z_API",
              "CHATWOOT"
            ],
            "description": "O webhook global é entregue em `DEFAULT`: use sempre `DEFAULT`. Com `ACCOUNT_RESTRICTION`, `Z_API` ou `CHATWOOT` respondem `422` (`ACCOUNT_RESTRICTION only supports DEFAULT payload format`). Os eventos da plataforma (cobrança e `CHANNEL_DISCONNECTED`) também só são entregues em `DEFAULT`.",
            "default": "DEFAULT",
            "example": "DEFAULT"
          },
          "customAttributes": {
            "type": "object",
            "description": "Mapa livre de atributos extras",
            "additionalProperties": true,
            "example": {}
          }
        }
      },
      "UpdateTemplateWebhookRequest": {
        "type": "object",
        "description": "Todos os campos são opcionais — apenas os campos enviados são atualizados.",
        "properties": {
          "url": {
            "type": "string",
            "description": "Nova URL de destino, com as mesmas regras da criação. Só é conferida quando muda.",
            "example": "https://nova-url.suaempresa.com/webhooks/templates"
          },
          "description": {
            "type": "string",
            "description": "Nova descrição"
          },
          "events": {
            "type": "array",
            "description": "Somente eventos da conta: `UPDATE_TEMPLATE_STATUS`, `UPDATE_TEMPLATE_CATEGORY`, os cinco `BILLING_*`, `ACCOUNT_RESTRICTION` e `CHANNEL_DISCONNECTED`. Evento de canal resulta em `422`; nome inexistente, nulo ou em branco resulta em `400`. Se enviado, substitui os eventos que a API conhece; não pode ser vazio (`400`).",
            "items": {
              "$ref": "#/components/schemas/TemplateEvent"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ENABLED",
              "DISABLED"
            ],
            "description": "`DISABLED` pausa a entrega de eventos sem excluir o webhook Outro valor retorna `400`."
          },
          "signing": {
            "type": "boolean",
            "description": "`true` gera um novo `secret`; `false` remove a assinatura"
          },
          "authType": {
            "type": "string",
            "enum": [
              "NONE",
              "BEARER",
              "API_KEY",
              "BASIC",
              "CUSTOM_HEADER"
            ],
            "description": "`NONE` limpa a autenticação; os demais reconfiguram"
          },
          "token": {
            "type": "string",
            "description": "Credencial para `BEARER`"
          },
          "key": {
            "type": "string",
            "description": "Credencial para `API_KEY`"
          },
          "auth": {
            "$ref": "#/components/schemas/WebhookAuth"
          },
          "payloadFormat": {
            "type": "string",
            "enum": [
              "DEFAULT",
              "Z_API",
              "CHATWOOT"
            ],
            "description": "O webhook global é entregue em `DEFAULT`: use sempre `DEFAULT`. Com `ACCOUNT_RESTRICTION`, `Z_API` ou `CHATWOOT` respondem `422` (`ACCOUNT_RESTRICTION only supports DEFAULT payload format`). Os eventos da plataforma (cobrança e `CHANNEL_DISCONNECTED`) também só são entregues em `DEFAULT`. No `PATCH`, deixar o webhook com eventos da plataforma em outro formato responde `422` (`Platform events are delivered only in DEFAULT payload format`).",
            "default": "DEFAULT",
            "example": "DEFAULT"
          },
          "customAttributes": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "WebhookAuth": {
        "type": "object",
        "description": "Forma aninhada da autenticação. Para `BASIC` use `username`+`password`; para `CUSTOM_HEADER` use `headerName`+`headerValue`.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "NONE",
              "BEARER",
              "API_KEY",
              "BASIC",
              "CUSTOM_HEADER"
            ],
            "example": "BEARER"
          },
          "token": {
            "type": "string",
            "description": "Token para `BEARER`",
            "example": "meu-token-secreto"
          },
          "key": {
            "type": "string",
            "description": "Chave para `API_KEY`"
          },
          "username": {
            "type": "string",
            "description": "Usuário para `BASIC`"
          },
          "password": {
            "type": "string",
            "description": "Senha para `BASIC`"
          },
          "headerName": {
            "type": "string",
            "description": "Nome do header para `CUSTOM_HEADER`",
            "example": "X-Api-Key"
          },
          "headerValue": {
            "type": "string",
            "description": "Valor do header para `CUSTOM_HEADER`"
          }
        }
      },
      "WebhookAuthInfo": {
        "type": "object",
        "description": "Resumo da autenticação configurada — credenciais não são retornadas por segurança",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "NONE",
              "BEARER",
              "API_KEY",
              "BASIC",
              "CUSTOM_HEADER"
            ],
            "example": "NONE"
          },
          "configured": {
            "type": "boolean",
            "description": "`true` quando credenciais estão configuradas",
            "example": false
          }
        }
      },
      "TemplateEvent": {
        "type": "string",
        "enum": [
          "UPDATE_TEMPLATE_STATUS",
          "UPDATE_TEMPLATE_CATEGORY",
          "CHANNEL_DISCONNECTED",
          "BILLING_PAYMENT_FAILED",
          "BILLING_PAYMENT_RECOVERED",
          "BILLING_SUBSCRIPTION_CANCELED",
          "BILLING_INSTANCE_SUSPENDED",
          "BILLING_INSTANCE_RELEASED",
          "ACCOUNT_RESTRICTION"
        ],
        "description": "Eventos de conta aceitos: `UPDATE_TEMPLATE_STATUS` (atualização de status do template — aprovado/rejeitado etc.), `UPDATE_TEMPLATE_CATEGORY` (atualização de categoria do template) e `CHANNEL_DISCONNECTED` (aviso de desconexão de canal, com o motivo em código; veja a página Aviso de desconexão de canal). Também: os eventos de cobrança (`BILLING_PAYMENT_FAILED`, `BILLING_PAYMENT_RECOVERED`, `BILLING_SUBSCRIPTION_CANCELED`, `BILLING_INSTANCE_SUSPENDED`, `BILLING_INSTANCE_RELEASED`) e a restrição da conta na Meta (`ACCOUNT_RESTRICTION`); veja a página Eventos de cobrança e de restrição da conta."
      },
      "TemplateWebhookResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID único do webhook de template",
            "example": "8F2C00000000000000000000000000A1"
          },
          "channelId": {
            "type": "string",
            "nullable": true,
            "description": "Sempre `null` para webhooks de template",
            "example": null
          },
          "instanceId": {
            "type": "string",
            "nullable": true,
            "deprecated": true,
            "description": "Descontinuado e sempre `null` para webhooks de template",
            "example": null
          },
          "url": {
            "type": "string",
            "description": "URL de destino dos eventos",
            "example": "https://app.suaempresa.com/webhooks/templates"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Descrição do webhook",
            "example": "Webhook de template"
          },
          "events": {
            "type": "array",
            "description": "Eventos de template configurados Evento gravado que a API ainda não conhece não aparece aqui.",
            "items": {
              "$ref": "#/components/schemas/TemplateEvent"
            },
            "example": [
              "UPDATE_TEMPLATE_STATUS",
              "UPDATE_TEMPLATE_CATEGORY"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ENABLED",
              "DISABLED"
            ],
            "description": "Status atual do webhook",
            "example": "ENABLED"
          },
          "signing": {
            "type": "boolean",
            "description": "Indica se a assinatura HMAC está habilitada",
            "example": false
          },
          "auth": {
            "$ref": "#/components/schemas/WebhookAuthInfo"
          },
          "payloadFormat": {
            "type": "string",
            "enum": [
              "DEFAULT",
              "Z_API",
              "CHATWOOT"
            ],
            "description": "Formato de entrega. `DEFAULT` nos webhooks globais criados pela API.",
            "example": "DEFAULT"
          },
          "customAttributes": {
            "type": "object",
            "additionalProperties": true,
            "example": {}
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-15T19:00:00.000+00:00"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-15T19:00:00.000+00:00"
          }
        }
      },
      "TemplateWebhookCreatedResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TemplateWebhookResponse"
          },
          {
            "type": "object",
            "properties": {
              "secret": {
                "type": "string",
                "nullable": true,
                "description": "Segredo HMAC de 64 caracteres hex — retornado **apenas** quando `signing = true` no create/update. `null` quando a assinatura está desabilitada. Não poderá ser recuperado depois.",
                "example": null
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key gerada no painel de Segurança do Z-API Omni"
      }
    }
  }
}
