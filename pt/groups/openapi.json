{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Grupos",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/groups/capabilities": {
      "get": {
        "summary": "Capacidades de grupo",
        "description": "Lista as operações de grupo disponíveis no canal. No canal Meta, a lista vem vazia.",
        "operationId": "groupCapabilities",
        "tags": [
          "Grupos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Capacidades de grupo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "operations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "examples": {
                  "whatsappWeb": {
                    "value": {
                      "type": "Z_API_WHATSAPP",
                      "operations": [
                        "LIST_GROUPS",
                        "GET_GROUP",
                        "GET_INVITE_LINK",
                        "PREVIEW_INVITE"
                      ]
                    }
                  },
                  "meta": {
                    "value": {
                      "type": "META_WHATSAPP",
                      "operations": []
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/InstanceNotFound"
          }
        }
      }
    },
    "/v1/channels/{channelId}/groups": {
      "get": {
        "summary": "Listar grupos",
        "description": "Lista os grupos do número, paginada por cursor. Só no canal WhatsApp Web (`Z_API_WHATSAPP`).",
        "operationId": "listGroups",
        "tags": [
          "Grupos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Quantidade por página. Padrão 20, sem máximo, inteiro positivo de até 9 dígitos.",
            "schema": {
              "type": "integer",
              "example": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Cursor opaco da próxima página. Devolva exatamente o `nextCursor` recebido.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listar grupos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupList"
                },
                "example": {
                  "content": [
                    {
                      "id": "120363430328583007-group",
                      "name": "Teste ZAPI-8975"
                    }
                  ],
                  "nextCursor": "8xkQ2"
                }
              }
            }
          },
          "400": {
            "description": "Cursor fora do formato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "cursor",
                  "message": "cursor is not valid: send back exactly the nextCursor returned by the previous page, or leave it out to start from the first page"
                }
              }
            }
          },
          "422": {
            "description": "Operação indisponível no canal, instância não provisionada, assinatura inativa ou workspace bloqueado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "operationNotSupported": {
                    "summary": "Canal sem suporte a grupos nesta API",
                    "value": {
                      "error": "operation not supported for this instance"
                    }
                  },
                  "instanceNotProvisioned": {
                    "summary": "Instância não provisionada",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Assinatura inativa",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "workspaceBlocked": {
                    "summary": "Workspace bloqueado",
                    "value": {
                      "error": "You are blocked, contact support.",
                      "message": "You are blocked, contact support. This workspace is blocked on the platform, so sending, editing and group calls are refused until it is unblocked. Talk to support through the panel at https://app.omni.z-api.io."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/InstanceNotFound"
          },
          "502": {
            "$ref": "#/components/responses/ProviderResponseTooLarge"
          }
        }
      }
    },
    "/v1/channels/{channelId}/groups/{groupId}": {
      "get": {
        "summary": "Consultar grupo",
        "description": "Retorna os dados de um grupo: nome, descrição, dono, participantes e configurações.",
        "operationId": "getGroup",
        "tags": [
          "Grupos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "description": "Identificador do grupo.",
            "schema": {
              "type": "string",
              "example": "120363430328583007-group"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consultar grupo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Group"
                },
                "example": {
                  "id": "120363430328583007-group",
                  "name": "Teste ZAPI-8975",
                  "description": "Grupo de teste",
                  "createdAt": "2026-10-06T19:09:18.429Z",
                  "owner": "5544936180923",
                  "participants": [
                    {
                      "id": "5544936180923",
                      "name": null,
                      "role": "ADMIN"
                    }
                  ],
                  "participantCount": 3,
                  "settings": {
                    "onlyAdminsSendMessages": false,
                    "onlyAdminsEditInfo": true,
                    "joinApprovalRequired": false,
                    "onlyAdminsAddParticipants": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Id do grupo fora do formato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "groupId"
                }
              }
            }
          },
          "404": {
            "description": "Grupo ou canal não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "groupNotFound": {
                    "summary": "Grupo não encontrado",
                    "value": {
                      "error": "provider_error",
                      "message": "Error on get group"
                    }
                  },
                  "instanceNotFound": {
                    "summary": "Canal (instância) não encontrado",
                    "value": {
                      "error": "instance not found"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Operação indisponível no canal, instância não provisionada, assinatura inativa ou workspace bloqueado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "operationNotSupported": {
                    "summary": "Canal sem suporte a grupos nesta API",
                    "value": {
                      "error": "operation not supported for this instance"
                    }
                  },
                  "instanceNotProvisioned": {
                    "summary": "Instância não provisionada",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Assinatura inativa",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "workspaceBlocked": {
                    "summary": "Workspace bloqueado",
                    "value": {
                      "error": "You are blocked, contact support.",
                      "message": "You are blocked, contact support. This workspace is blocked on the platform, so sending, editing and group calls are refused until it is unblocked. Talk to support through the panel at https://app.omni.z-api.io."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "502": {
            "$ref": "#/components/responses/ProviderResponseTooLarge"
          }
        }
      }
    },
    "/v1/channels/{channelId}/groups/{groupId}/invite-link": {
      "get": {
        "summary": "Link de convite",
        "description": "Retorna o link de convite do grupo. O canal precisa ser administrador.",
        "operationId": "getGroupInviteLink",
        "tags": [
          "Grupos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "description": "Identificador do grupo.",
            "schema": {
              "type": "string",
              "example": "120363430328583007-group"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Link de convite",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "inviteLink": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "inviteLink": "https://chat.whatsapp.com/XXXXXXXXXXX"
                }
              }
            }
          },
          "400": {
            "description": "Id do grupo fora do formato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "groupId"
                }
              }
            }
          },
          "404": {
            "description": "Grupo ou canal não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "groupNotFound": {
                    "summary": "Grupo não encontrado",
                    "value": {
                      "error": "provider_error",
                      "message": "Group not found"
                    }
                  },
                  "instanceNotFound": {
                    "summary": "Canal (instância) não encontrado",
                    "value": {
                      "error": "instance not found"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Canal não é administrador do grupo, operação indisponível no canal, instância não provisionada, assinatura inativa ou workspace bloqueado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "notGroupAdmin": {
                    "summary": "O canal não é administrador do grupo",
                    "value": {
                      "error": "provider_error",
                      "message": "The channel is not an admin of this group, so WhatsApp does not return its invite link. Make the channel an admin of the group, or ask a group admin for the link."
                    }
                  },
                  "operationNotSupported": {
                    "summary": "Canal sem suporte a grupos nesta API",
                    "value": {
                      "error": "operation not supported for this instance"
                    }
                  },
                  "instanceNotProvisioned": {
                    "summary": "Instância não provisionada",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Assinatura inativa",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "workspaceBlocked": {
                    "summary": "Workspace bloqueado",
                    "value": {
                      "error": "You are blocked, contact support.",
                      "message": "You are blocked, contact support. This workspace is blocked on the platform, so sending, editing and group calls are refused until it is unblocked. Talk to support through the panel at https://app.omni.z-api.io."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v1/channels/{channelId}/group-invites/preview": {
      "get": {
        "summary": "Prévia por link",
        "description": "Retorna a prévia de um grupo (nome e dados) a partir do link de convite, sem entrar nele.",
        "operationId": "previewGroupInvite",
        "tags": [
          "Grupos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "link",
            "in": "query",
            "required": true,
            "description": "Link de convite do grupo.",
            "schema": {
              "type": "string",
              "example": "https://chat.whatsapp.com/XXXXXXXXXXX"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Prévia por link",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "participantCount": {
                      "type": "integer"
                    }
                  }
                },
                "example": {
                  "id": "120363430328583007-group",
                  "name": "Teste ZAPI-8975",
                  "description": "Grupo de teste",
                  "participantCount": 3
                }
              }
            }
          },
          "400": {
            "description": "Link ausente ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "link"
                }
              }
            }
          },
          "422": {
            "description": "Operação indisponível no canal, instância não provisionada, assinatura inativa ou workspace bloqueado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "operationNotSupported": {
                    "summary": "Canal sem suporte a grupos nesta API",
                    "value": {
                      "error": "operation not supported for this instance"
                    }
                  },
                  "instanceNotProvisioned": {
                    "summary": "Instância não provisionada",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Assinatura inativa",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "workspaceBlocked": {
                    "summary": "Workspace bloqueado",
                    "value": {
                      "error": "You are blocked, contact support.",
                      "message": "You are blocked, contact support. This workspace is blocked on the platform, so sending, editing and group calls are refused until it is unblocked. Talk to support through the panel at https://app.omni.z-api.io."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/InstanceNotFound"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "GroupSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Participant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "MEMBER",
              "ADMIN",
              "OWNER"
            ]
          }
        }
      },
      "Group": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "owner": {
            "type": "string"
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Participant"
            }
          },
          "participantCount": {
            "type": "integer"
          },
          "settings": {
            "type": "object",
            "properties": {
              "onlyAdminsSendMessages": {
                "type": "boolean",
                "nullable": true
              },
              "onlyAdminsEditInfo": {
                "type": "boolean",
                "nullable": true
              },
              "joinApprovalRequired": {
                "type": "boolean",
                "nullable": true
              },
              "onlyAdminsAddParticipants": {
                "type": "boolean",
                "nullable": true
              }
            }
          }
        }
      },
      "GroupList": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroupSummary"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Cursor da próxima página. Só vem nulo quando a página tem menos itens que pageSize; uma última página com exatamente pageSize itens é seguida por uma página vazia. O cursor de grupos (g1:) não serve para contatos."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Secret Key ausente ou inválida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Authorization invalid",
              "message": "Authorization invalid: the Authorization header is missing or empty. Send the workspace Secret Key as \"Authorization: Bearer <secret-key>\". See https://developer.omni.z-api.io/en/authentication"
            }
          }
        },
        "headers": {
          "WWW-Authenticate": {
            "description": "Sempre `Bearer`",
            "schema": {
              "type": "string"
            },
            "example": "Bearer"
          }
        }
      },
      "Forbidden": {
        "description": "IP fora da lista de IPs do workspace",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "ip_not_allowed",
              "message": "203.0.113.10 not allowed: this workspace only accepts API calls from the IPs on its allow list. The workspace Owner can add this IP under Administration > Security > IP Restriction in the panel (changes take up to 10 minutes to apply), or call from an allowed IP. See https://developer.omni.z-api.io/en/security/ip-restriction"
            }
          }
        }
      },
      "InstanceNotFound": {
        "description": "Canal (instância) não encontrado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "instance not found"
            }
          }
        }
      },
      "InstanceUnprocessable": {
        "description": "Instância não provisionada, assinatura inativa ou workspace bloqueado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "instanceNotProvisioned": {
                "summary": "Instância não provisionada",
                "value": {
                  "error": "instance is not provisioned"
                }
              },
              "subscriptionInactive": {
                "summary": "Assinatura inativa",
                "value": {
                  "error": "instance subscription is not active"
                }
              },
              "workspaceBlocked": {
                "summary": "Workspace bloqueado",
                "value": {
                  "error": "You are blocked, contact support.",
                  "message": "You are blocked, contact support. This workspace is blocked on the platform, so sending, editing and group calls are refused until it is unblocked. Talk to support through the panel at https://app.omni.z-api.io."
                }
              }
            }
          }
        }
      },
      "ProviderResponseTooLarge": {
        "description": "Resposta do canal grande demais",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "provider_response_too_large",
              "message": "The channel answer is too large. Use a smaller pageSize."
            }
          }
        }
      }
    }
  }
}
