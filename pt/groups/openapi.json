{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Grupos",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/groups/capabilities": {
      "get": {
        "summary": "Capacidades de grupo",
        "description": "Lista as operações de grupo disponíveis no canal. No canal Meta, a lista vem vazia.",
        "operationId": "groupCapabilities",
        "tags": [
          "Grupos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Capacidades de grupo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "operations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "examples": {
                  "whatsappWeb": {
                    "value": {
                      "type": "Z_API_WHATSAPP",
                      "operations": [
                        "LIST_GROUPS",
                        "GET_GROUP",
                        "GET_INVITE_LINK",
                        "PREVIEW_INVITE"
                      ]
                    }
                  },
                  "meta": {
                    "value": {
                      "type": "META_WHATSAPP",
                      "operations": []
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/channels/{channelId}/groups": {
      "get": {
        "summary": "Listar grupos",
        "description": "Lista os grupos do número, paginada por cursor. Só no canal WhatsApp Web (`Z_API_WHATSAPP`).",
        "operationId": "listGroups",
        "tags": [
          "Grupos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Quantidade por página.",
            "schema": {
              "type": "integer",
              "example": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Cursor opaco da próxima página. Devolva exatamente o `nextCursor` recebido.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listar grupos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupList"
                },
                "example": {
                  "content": [
                    {
                      "id": "120363430328583007-group",
                      "name": "Teste ZAPI-8975"
                    }
                  ],
                  "nextCursor": "8xkQ2"
                }
              }
            }
          },
          "400": {
            "description": "Cursor fora do formato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "cursor",
                  "message": "cursor is not valid: send back exactly the nextCursor returned by the previous page, or leave it out to start from the first page"
                }
              }
            }
          },
          "422": {
            "description": "Operação indisponível no canal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "operation_not_supported",
                  "message": "operation not supported for this instance"
                }
              }
            }
          }
        }
      }
    },
    "/v1/channels/{channelId}/groups/{groupId}": {
      "get": {
        "summary": "Consultar grupo",
        "description": "Retorna os dados de um grupo: nome, descrição, dono, participantes e configurações.",
        "operationId": "getGroup",
        "tags": [
          "Grupos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "description": "Identificador do grupo.",
            "schema": {
              "type": "string",
              "example": "120363430328583007-group"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consultar grupo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Group"
                },
                "example": {
                  "id": "120363430328583007-group",
                  "name": "Teste ZAPI-8975",
                  "description": "Grupo de teste",
                  "createdAt": "2026-10-06T19:09:18.429Z",
                  "owner": "5544936180923",
                  "participants": [
                    {
                      "id": "5544936180923",
                      "name": null,
                      "role": "ADMIN"
                    }
                  ],
                  "participantCount": 3,
                  "settings": {
                    "onlyAdminsMessage": false,
                    "onlyAdminsEdit": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "Id do grupo fora do formato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "groupId",
                  "message": "groupId is not valid"
                }
              }
            }
          },
          "404": {
            "description": "Grupo não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "provider_error",
                  "message": "Error on get group"
                }
              }
            }
          },
          "422": {
            "description": "Operação indisponível no canal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "operation_not_supported",
                  "message": "operation not supported for this instance"
                }
              }
            }
          }
        }
      }
    },
    "/v1/channels/{channelId}/groups/{groupId}/invite-link": {
      "get": {
        "summary": "Link de convite",
        "description": "Retorna o link de convite do grupo. A instância precisa ser administradora.",
        "operationId": "getGroupInviteLink",
        "tags": [
          "Grupos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "description": "Identificador do grupo.",
            "schema": {
              "type": "string",
              "example": "120363430328583007-group"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Link de convite",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "inviteLink": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "inviteLink": "https://chat.whatsapp.com/XXXXXXXXXXX"
                }
              }
            }
          },
          "400": {
            "description": "Id do grupo fora do formato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "groupId",
                  "message": "groupId is not valid"
                }
              }
            }
          },
          "404": {
            "description": "Grupo não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "provider_error",
                  "message": "Group not found"
                }
              }
            }
          },
          "422": {
            "description": "A instância não é administradora do grupo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "provider_error",
                  "message": "The instance is not an admin of this group"
                }
              }
            }
          }
        }
      }
    },
    "/v1/channels/{channelId}/group-invites/preview": {
      "get": {
        "summary": "Prévia por link",
        "description": "Retorna a prévia de um grupo (nome e dados) a partir do link de convite, sem entrar nele.",
        "operationId": "previewGroupInvite",
        "tags": [
          "Grupos"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "link",
            "in": "query",
            "required": true,
            "description": "Link de convite do grupo.",
            "schema": {
              "type": "string",
              "example": "https://chat.whatsapp.com/XXXXXXXXXXX"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Prévia por link",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "participantCount": {
                      "type": "integer"
                    }
                  }
                },
                "example": {
                  "id": "120363430328583007-group",
                  "name": "Teste ZAPI-8975",
                  "description": "Grupo de teste",
                  "participantCount": 3
                }
              }
            }
          },
          "400": {
            "description": "Link ausente ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "link",
                  "message": "link is required and must be a valid WhatsApp group invite link"
                }
              }
            }
          },
          "422": {
            "description": "Operação indisponível no canal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "operation_not_supported",
                  "message": "operation not supported for this instance"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "GroupSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Participant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "MEMBER",
              "ADMIN"
            ]
          }
        }
      },
      "Group": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "owner": {
            "type": "string"
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Participant"
            }
          },
          "participantCount": {
            "type": "integer"
          },
          "settings": {
            "type": "object"
          }
        }
      },
      "GroupList": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroupSummary"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key"
      }
    }
  }
}