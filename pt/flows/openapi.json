{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Flows do WhatsApp",
    "description": "API para criar e gerenciar WhatsApp Flows (formulários nativos dentro da conversa)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/whatsapp/businesses/{wabaId}/flows": {
      "get": {
        "summary": "Listar flows",
        "description": "Retorna todos os flows do WABA de uma vez, com nome, categorias e status de publicação. Não há paginação. Com `sync=true`, sincroniza com a Meta antes de listar.",
        "operationId": "listFlows",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "ID do WABA (obtido via Listar WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "sync",
            "in": "query",
            "required": false,
            "description": "Quando `true`, sincroniza os flows com a Meta antes de listar. Sem ele, a lista sai do registro da plataforma. A lista vem inteira, sem paginação",
            "schema": {
              "type": "boolean",
              "default": false,
              "example": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de flows",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlowListResponse"
                },
                "example": {
                  "data": [
                    {
                      "id": "1122334455667788",
                      "name": "agendamento_consulta",
                      "categories": [
                        "APPOINTMENT_BOOKING"
                      ],
                      "status": "PUBLISHED",
                      "endpoint_uri": null,
                      "validation_errors": []
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "description": "A Meta ou a plataforma recusou a operação. Veja o formato do corpo no exemplo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Recusa da Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Recusa sem detalhe",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/IntegrationTimeout"
          }
        }
      },
      "post": {
        "summary": "Criar flow",
        "description": "Cria um flow. O `flow_json` é a definição das telas em JSON, enviada como string. Com `publish: true` o flow já nasce publicado; sem isso, fica em `DRAFT`.",
        "operationId": "createFlow",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "ID do WABA (obtido via Listar WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFlowRequest"
              },
              "example": {
                "name": "agendamento_consulta",
                "categories": [
                  "APPOINTMENT_BOOKING"
                ],
                "flow_json": "{\"version\": \"7.0\", \"routing_model\": {\"WELCOME\": [\"DONE\"], \"DONE\": []}, \"screens\": [{\"id\": \"WELCOME\", \"title\": \"Agendamento\", \"layout\": {\"type\": \"SingleColumnLayout\", \"children\": [{\"type\": \"TextHeading\", \"text\": \"Escolha um horario\"}, {\"type\": \"Form\", \"name\": \"form\", \"children\": [{\"type\": \"TextInput\", \"name\": \"nome\", \"label\": \"Seu nome\", \"input-type\": \"text\", \"required\": true}, {\"type\": \"DatePicker\", \"name\": \"data\", \"label\": \"Data\"}, {\"type\": \"Footer\", \"label\": \"Continuar\", \"on-click-action\": {\"name\": \"navigate\", \"next\": {\"type\": \"screen\", \"name\": \"DONE\"}, \"payload\": {}}}]}]}}, {\"id\": \"DONE\", \"title\": \"Pronto\", \"terminal\": true, \"success\": true, \"layout\": {\"type\": \"SingleColumnLayout\", \"children\": [{\"type\": \"TextBody\", \"text\": \"Agendamento confirmado.\"}, {\"type\": \"Footer\", \"label\": \"Fechar\", \"on-click-action\": {\"name\": \"complete\", \"payload\": {}}}]}}]}",
                "publish": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flow criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                },
                "example": {
                  "id": "1122334455667788",
                  "name": "agendamento_consulta",
                  "categories": [
                    "APPOINTMENT_BOOKING"
                  ],
                  "status": "DRAFT",
                  "endpoint_uri": null,
                  "validation_errors": []
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/FlowBadRequest"
          },
          "422": {
            "description": "A Meta ou a plataforma recusou a operação: `flow_json` malformado, categoria inexistente ou outra regra da Meta. Veja o formato do corpo no exemplo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Recusa da Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Recusa sem detalhe",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/OutcomeUnknown"
          }
        }
      }
    },
    "/whatsapp/businesses/{wabaId}/flows/sync": {
      "post": {
        "summary": "Sincronizar flows",
        "description": "Força a sincronização dos flows com a Meta, atualizando status e pendências de validação.",
        "operationId": "syncFlows",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "ID do WABA (obtido via Listar WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação realizada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlowListResponse"
                },
                "example": {
                  "data": [
                    {
                      "id": "1122334455667788",
                      "name": "agendamento_consulta",
                      "categories": [
                        "APPOINTMENT_BOOKING"
                      ],
                      "status": "PUBLISHED",
                      "endpoint_uri": null,
                      "validation_errors": []
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "description": "A Meta ou a plataforma recusou a operação. Veja o formato do corpo no exemplo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Recusa da Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Recusa sem detalhe",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/OutcomeUnknown"
          }
        }
      }
    },
    "/whatsapp/businesses/{wabaId}/flows/{flowId}": {
      "get": {
        "summary": "Detalhar flow",
        "description": "Retorna um flow específico, incluindo o `flow_json` e as pendências de validação da Meta.",
        "operationId": "getFlow",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "ID do WABA (obtido via Listar WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "flowId",
            "in": "path",
            "required": true,
            "description": "ID do flow (obtido via Listar flows)",
            "schema": {
              "type": "string",
              "example": "1122334455667788"
            }
          },
          {
            "name": "sync",
            "in": "query",
            "required": false,
            "description": "Quando `true`, busca o estado do flow direto na Meta antes de responder",
            "schema": {
              "type": "boolean",
              "example": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operação realizada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                },
                "example": {
                  "id": "1122334455667788",
                  "name": "agendamento_consulta",
                  "categories": [
                    "APPOINTMENT_BOOKING"
                  ],
                  "status": "PUBLISHED",
                  "endpoint_uri": null,
                  "validation_errors": [],
                  "flow_json": "{\"version\": \"7.0\", \"routing_model\": {\"WELCOME\": [\"DONE\"], \"DONE\": []}, \"screens\": [{\"id\": \"WELCOME\", \"title\": \"Agendamento\", \"layout\": {\"type\": \"SingleColumnLayout\", \"children\": [{\"type\": \"TextHeading\", \"text\": \"Escolha um horario\"}, {\"type\": \"Form\", \"name\": \"form\", \"children\": [{\"type\": \"TextInput\", \"name\": \"nome\", \"label\": \"Seu nome\", \"input-type\": \"text\", \"required\": true}, {\"type\": \"DatePicker\", \"name\": \"data\", \"label\": \"Data\"}, {\"type\": \"Footer\", \"label\": \"Continuar\", \"on-click-action\": {\"name\": \"navigate\", \"next\": {\"type\": \"screen\", \"name\": \"DONE\"}, \"payload\": {}}}]}]}}, {\"id\": \"DONE\", \"title\": \"Pronto\", \"terminal\": true, \"success\": true, \"layout\": {\"type\": \"SingleColumnLayout\", \"children\": [{\"type\": \"TextBody\", \"text\": \"Agendamento confirmado.\"}, {\"type\": \"Footer\", \"label\": \"Fechar\", \"on-click-action\": {\"name\": \"complete\", \"payload\": {}}}]}}]}"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "description": "Flow inexistente ou de outro workspace, ou recusa da Meta ao consultar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Recusa da Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Recusa sem detalhe",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/IntegrationTimeout"
          }
        }
      },
      "put": {
        "summary": "Atualizar flow",
        "description": "Atualiza um flow existente. Todos os campos são opcionais — apenas os enviados são alterados. Um flow `PUBLISHED` não aceita alteração do `flow_json`.",
        "operationId": "updateFlow",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "ID do WABA (obtido via Listar WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "flowId",
            "in": "path",
            "required": true,
            "description": "ID do flow (obtido via Listar flows)",
            "schema": {
              "type": "string",
              "example": "1122334455667788"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFlowRequest"
              },
              "example": {
                "name": "agendamento_consulta_v2"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flow atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                },
                "example": {
                  "id": "1122334455667788",
                  "name": "agendamento_consulta_v2",
                  "categories": [
                    "APPOINTMENT_BOOKING"
                  ],
                  "status": "PUBLISHED",
                  "endpoint_uri": null,
                  "validation_errors": []
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/FlowBadRequest"
          },
          "422": {
            "description": "A Meta ou a plataforma recusou a operação: flow inexistente ou de outro workspace, `flow_json` malformado, categoria inexistente, ou flow publicado que não aceita alteração do `flow_json`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Recusa da Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Recusa sem detalhe",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/OutcomeUnknown"
          }
        }
      },
      "delete": {
        "summary": "Remover flow",
        "description": "Remove permanentemente um flow. Só é possível remover flows em `DRAFT`.",
        "operationId": "deleteFlow",
        "tags": [
          "Flows (WhatsApp)"
        ],
        "parameters": [
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "description": "ID do WABA (obtido via Listar WABAs)",
            "schema": {
              "type": "string",
              "example": "428083093730937"
            }
          },
          {
            "name": "flowId",
            "in": "path",
            "required": true,
            "description": "ID do flow (obtido via Listar flows)",
            "schema": {
              "type": "string",
              "example": "1122334455667788"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Flow removido. O corpo é o booleano `true`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean",
                  "description": "`true` quando a remoção foi aceita"
                },
                "example": true
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "description": "Flow inexistente ou de outro workspace, ou flow fora de `DRAFT`, que não pode ser removido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableEntity"
                },
                "examples": {
                  "meta_rejection": {
                    "summary": "Recusa da Meta",
                    "value": {
                      "error": {
                        "timestamp": "2026-11-09T12:00:00Z",
                        "status": 400,
                        "errors": [
                          {
                            "code": "100",
                            "name": "META_WHATSAPP_ERROR",
                            "message": "Invalid parameter",
                            "description": ""
                          }
                        ]
                      }
                    }
                  },
                  "no_details": {
                    "summary": "Recusa sem detalhe",
                    "value": {
                      "error": "The operation could not be completed right now. Try again in a few moments."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/IntegrationUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/OutcomeUnknown"
          }
        }
      }
    },
