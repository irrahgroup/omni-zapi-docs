    }
  },
  "components": {
    "schemas": {
      "CreateFlowRequest": {
        "type": "object",
        "required": [
          "name",
          "categories",
          "flow_json"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do flow",
            "example": "agendamento_consulta"
          },
          "categories": {
            "type": "array",
            "description": "Categorias do flow (a Meta usa na revisão)",
            "items": {
              "type": "string",
              "enum": [
                "SIGN_UP",
                "SIGN_IN",
                "APPOINTMENT_BOOKING",
                "LEAD_GENERATION",
                "CONTACT_US",
                "CUSTOMER_SUPPORT",
                "SURVEY",
                "OTHER"
              ]
            },
            "example": [
              "APPOINTMENT_BOOKING"
            ]
          },
          "flow_json": {
            "type": "string",
            "description": "Definição das telas em JSON, enviada como **string**"
          },
          "endpoint_uri": {
            "type": "string",
            "description": "URL do seu endpoint, obrigatória apenas para flows com `data_exchange`",
            "example": "https://app.suaempresa.com/flows/callback"
          },
          "publish": {
            "type": "boolean",
            "description": "Quando `true`, publica o flow já na criação",
            "default": false
          }
        }
      },
      "UpdateFlowRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do flow"
          },
          "categories": {
            "type": "array",
            "description": "Categorias do flow (a Meta usa na revisão)",
            "items": {
              "type": "string",
              "enum": [
                "SIGN_UP",
                "SIGN_IN",
                "APPOINTMENT_BOOKING",
                "LEAD_GENERATION",
                "CONTACT_US",
                "CUSTOMER_SUPPORT",
                "SURVEY",
                "OTHER"
              ]
            }
          },
          "flow_json": {
            "type": "string",
            "description": "Definição das telas em JSON, enviada como **string**"
          },
          "endpoint_uri": {
            "type": "string",
            "description": "URL do seu endpoint, obrigatória apenas para flows com `data_exchange`"
          }
        }
      },
      "Flow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID do flow"
          },
          "name": {
            "type": "string",
            "description": "Nome do flow"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SIGN_UP",
                "SIGN_IN",
                "APPOINTMENT_BOOKING",
                "LEAD_GENERATION",
                "CONTACT_US",
                "CUSTOMER_SUPPORT",
                "SURVEY",
                "OTHER"
              ]
            },
            "description": "Categorias do flow (a Meta usa na revisão)"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "DEPRECATED",
              "BLOCKED",
              "THROTTLED"
            ],
            "description": "Status de publicação"
          },
          "endpoint_uri": {
            "type": "string",
            "nullable": true,
            "description": "URL do seu endpoint, obrigatória apenas para flows com `data_exchange`"
          },
          "flow_json": {
            "type": "string",
            "description": "Definição das telas em JSON, enviada como **string**"
          },
          "validation_errors": {
            "type": "array",
            "description": "Pendências de validação devolvidas pela Meta",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Chave da pendência"
                },
                "value": {
                  "type": "string",
                  "description": "Detalhe da pendência"
                }
              }
            }
          }
        }
      },
      "FlowListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "description": "Lista de flows",
            "items": {
              "$ref": "#/components/schemas/Flow"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código ou mensagem do erro"
          },
          "message": {
            "type": "string",
            "description": "Descrição do erro"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código do erro"
          },
          "message": {
            "type": "string",
            "description": "Mensagem para quem integra"
          }
        }
      },
      "UnprocessableEntity": {
        "type": "object",
        "properties": {
          "error": {
            "description": "Detalhe da recusa (objeto) ou, quando não há detalhe, a mensagem em texto.",
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "timestamp": {
                    "type": "string",
                    "description": "Momento da recusa"
                  },
                  "status": {
                    "type": "integer",
                    "description": "Status HTTP informado no detalhe da recusa"
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "description": "Código de erro da Meta"
                        },
                        "name": {
                          "type": "string",
                          "description": "Tipo do erro (ex: META_WHATSAPP_ERROR)"
                        },
                        "subCode": {
                          "type": "string",
                          "description": "Subcódigo de erro da Meta"
                        },
                        "message": {
                          "type": "string",
                          "description": "Mensagem de erro"
                        },
                        "description": {
                          "type": "string",
                          "description": "Explicação da recusa"
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key gerada no painel de Segurança do Z-API Omni. O prefixo `Bearer` é opcional."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Autenticação recusada. O header `Authorization` está ausente, a chave está malformada ou não existe (`Authorization invalid`), ou o IP de origem está fora da lista de IPs permitidos da Secret Key (`<ip> not allowed`). O prefixo `Bearer` é opcional.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "authorization_invalid": {
                "summary": "Chave ausente, malformada ou inexistente",
                "value": {
                  "error": "Authorization invalid"
                }
              },
              "ip_not_allowed": {
                "summary": "IP fora da lista de IPs permitidos da Secret Key",
                "value": {
                  "error": "203.0.113.10 not allowed"
                }
              },
              "business_id_required": {
                "summary": "WABA não informado",
                "value": {
                  "error": "Business id is required"
                }
              }
            }
          }
        }
      },
      "FlowBadRequest": {
        "description": "Requisição recusada antes de chegar à Meta: autenticação recusada (header `Authorization` ausente, chave malformada ou inexistente, ou IP fora da lista de IPs permitidos da Secret Key) ou corpo ausente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "authorization_invalid": {
                "summary": "Chave ausente, malformada ou inexistente",
                "value": {
                  "error": "Authorization invalid"
                }
              },
              "ip_not_allowed": {
                "summary": "IP fora da lista de IPs permitidos da Secret Key",
                "value": {
                  "error": "203.0.113.10 not allowed"
                }
              },
              "request_body_missing": {
                "summary": "Corpo da requisição ausente",
                "value": {
                  "error": "Required request body is missing"
                }
              },
              "business_id_required": {
                "summary": "WABA não informado",
                "value": {
                  "error": "Business id is required"
                }
              }
            }
          }
        }
      },
      "IntegrationUnavailable": {
        "description": "Falha temporária de um serviço interno. Tente novamente em instantes.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "error": "integration_unavailable",
              "message": "The operation could not be completed right now. Try again in a few moments."
            }
          }
        }
      },
      "IntegrationTimeout": {
        "description": "O serviço não respondeu a tempo. Repetir é seguro.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "error": "integration_timeout",
              "message": "The operation took too long to complete. Try again in a few moments."
            }
          }
        }
      },
      "OutcomeUnknown": {
        "description": "O serviço não respondeu a tempo e a operação pode ter sido concluída. Confira o resultado antes de repetir.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "error": "outcome_unknown",
              "message": "The operation did not finish in time and may still be completed. Check the result before trying again."
            }
          }
        }
      }
    }
  }
}
