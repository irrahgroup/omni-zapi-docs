{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Parceiro: Cancelar Assinatura",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/cancel": {
      "delete": {
        "summary": "Cancelar assinatura (Parceiro)",
        "description": "Solicita o cancelamento da assinatura do canal. O canal entra em `CANCELLATION_PROCESS` e permanece ativo até o fim do período pago. Requer role ENTERPRISE.",
        "operationId": "partnerCancelSubscription",
        "tags": [
          "Parceiros"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal (obtido via Criar canal)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          },
          {
            "name": "cancel",
            "in": "query",
            "required": true,
            "description": "Deve ser `true` para confirmar o cancelamento",
            "schema": {
              "type": "boolean",
              "example": true
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRequest"
              },
              "examples": {
                "withReason": {
                  "summary": "Com motivo de cancelamento",
                  "value": {
                    "cancelReason": "Cliente encerrou a empresa"
                  }
                }
              }
            }
          },
          "description": "Obrigatório. Para cancelar sem motivo, envie `{}`."
        },
        "responses": {
          "204": {
            "description": "Cancelamento solicitado com sucesso. Nenhum conteúdo retornado."
          },
          "400": {
            "description": "Corpo ausente ou parâmetro `cancel` ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "missingBody": {
                    "summary": "Sem corpo",
                    "value": {
                      "error": "Required request body is missing"
                    }
                  },
                  "missingCancel": {
                    "summary": "Sem o parâmetro `cancel`",
                    "value": {
                      "error": "Required parameter 'cancel' is missing"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Canal inexistente ou de outro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "403": {
            "description": "Conta sem o papel ENTERPRISE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "planRequired": {
                    "value": {
                      "error": "plan_required",
                      "message": "Channel subscription requires ENTERPRISE role: managing channel subscriptions through the API is limited to partner accounts with the ENTERPRISE role. Ask support to enable the role, or manage the subscription in the panel at https://app.omni.z-api.io. See https://developer.omni.z-api.io/en/channels/introduction"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Secret Key recusada. Veja os motivos em Autenticação.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "example": "Bearer"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Authorization invalid",
              "message": "Authorization invalid: this Secret Key does not exist or is no longer valid. Copy the current Secret Key under Security in the panel and send it as \"Authorization: Bearer <secret-key>\". See https://developer.omni.z-api.io/en/authentication"
            }
          }
        }
      }
    },
    "schemas": {
      "CancelRequest": {
        "type": "object",
        "properties": {
          "cancelReason": {
            "type": "string",
            "description": "Motivo do cancelamento (opcional, mas recomendado para auditoria)",
            "example": "Cliente encerrou a empresa"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key gerada no painel de Segurança do Omni Z-API"
      }
    }
  }
}
