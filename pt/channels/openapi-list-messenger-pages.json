{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Listar páginas do Messenger",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "publicKey": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/list-messenger-pages": {
      "post": {
        "summary": "Listar páginas do Messenger",
        "description": "Devolve as páginas do Facebook que o usuário autorizou no OAuth, para ele escolher qual vincular ao canal `META_MESSENGER`. Autenticado com a **Public Key**, não com a Secret Key. Normalmente o SDK chama esta rota pelo método `getListMessengerPages`.",
        "operationId": "listMessengerPages",
        "tags": [
          "Canais"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal (obtido em Criar canal ou Listar canais)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListMessengerPagesRequest"
              },
              "example": {
                "code": "AQD8h2...",
                "redirectUri": "https://app.omni.z-api.io/oauth/proxy-messenger"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Páginas autorizadas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MessengerPage"
                  }
                },
                "example": [
                  {
                    "pageId": "102938475601234",
                    "name": "Minha Loja",
                    "accessToken": "EAAG...",
                    "category": "Shopping"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Public Key ausente, malformada ou inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Public Key inválida",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Canal inexistente ou de outro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "instanceNotFound": {
                    "summary": "Canal não encontrado",
                    "value": {
                      "error": "Instance not found"
                    }
                  },
                  "appConfigurationNotFound": {
                    "summary": "App não configurado",
                    "value": {
                      "error": "app configuration not found"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "O provedor recusou a listagem. O caso mais comum: o canal Messenger ainda está ativo no provedor. Desative-o com `POST /v1/channels/{channelId}/deactivate-messenger`, usando a Secret Key, e liste as páginas de novo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderError"
                },
                "example": {
                  "error": {
                    "errors": [
                      {
                        "description": "The Messenger channel is still active on the provider. Deactivate it with POST /channels/{id}/deactivate-messenger using the Secret Key, then list the pages again."
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Motivo do erro"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código estável do erro"
          },
          "message": {
            "type": "string",
            "description": "Texto do erro, em inglês"
          }
        }
      },
      "ListMessengerPagesRequest": {
        "type": "object",
        "required": [
          "code",
          "redirectUri"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "`code` devolvido pelo OAuth do Facebook"
          },
          "redirectUri": {
            "type": "string",
            "description": "A mesma `redirectUri` usada no OAuth"
          }
        }
      },
      "MessengerPage": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "description": "ID da página"
          },
          "name": {
            "type": "string",
            "description": "Nome da página"
          },
          "accessToken": {
            "type": "string",
            "description": "Token de acesso da página, usado em Ativar Messenger"
          },
          "category": {
            "type": "string",
            "description": "Categoria da página no Facebook"
          }
        }
      },
      "ProviderError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Nome do erro"
                    },
                    "description": {
                      "type": "string",
                      "description": "Texto do erro"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "publicKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Public Key gerada em Segurança, no painel do Z-API Omni, enviada no header `Authorization`."
      }
    }
  }
}
