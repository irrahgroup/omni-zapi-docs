{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Origens do SDK",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "publicKey": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/sdk-info": {
      "get": {
        "summary": "Origens do SDK",
        "description": "Devolve o que o SDK de conexão precisa para abrir o fluxo do canal: o tipo do canal, o app da Meta usado e as origens liberadas. Autenticado com a **Public Key** no header `Authorization`, para poder ser chamado do frontend.",
        "operationId": "getSdkInfo",
        "tags": [
          "Canais"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal (obtido em Criar canal ou Listar canais)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do SDK para o canal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SdkInfo"
                },
                "example": {
                  "middleware": "META_WHATSAPP",
                  "appId": "1234567890123456",
                  "appConfig": "987654321098765",
                  "allowOrigins": [
                    "https://app.suaempresa.com",
                    "http://localhost:3000",
                    "https://app.hubmessage.io",
                    "https://app.omni.z-api.io"
                  ],
                  "appCustom": false,
                  "appInstagramId": null
                }
              }
            }
          },
          "400": {
            "description": "Public Key ausente, malformada ou inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Public Key inválida",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Canal inexistente ou de outro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "instanceNotFound": {
                    "summary": "Canal não encontrado",
                    "value": {
                      "error": "Instance not found"
                    }
                  },
                  "appConfigurationNotFound": {
                    "summary": "App não configurado",
                    "value": {
                      "error": "app configuration not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Motivo do erro"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código estável do erro"
          },
          "message": {
            "type": "string",
            "description": "Texto do erro, em inglês"
          }
        }
      },
      "SdkInfo": {
        "type": "object",
        "properties": {
          "middleware": {
            "type": "string",
            "description": "Tipo do canal",
            "enum": [
              "META_WHATSAPP",
              "Z_API_WHATSAPP",
              "META_INSTAGRAM",
              "META_MESSENGER",
              "BOT_TELEGRAM"
            ]
          },
          "appId": {
            "type": "string",
            "description": "ID do app da Meta que o SDK usa"
          },
          "appConfig": {
            "type": "string",
            "description": "Configuração do app da Meta que o SDK usa"
          },
          "allowOrigins": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Origens liberadas para o SDK: primeiro as do workspace, depois as do painel (`https://app.hubmessage.io` e `https://app.omni.z-api.io`)"
          },
          "appCustom": {
            "type": "boolean",
            "description": "`true` quando o workspace usa app próprio"
          },
          "appInstagramId": {
            "type": [
              "string",
              "null"
            ],
            "description": "ID do app do Instagram"
          }
        }
      }
    },
    "securitySchemes": {
      "publicKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Public Key gerada em Segurança, no painel do Z-API Omni, enviada no header `Authorization`."
      }
    }
  }
}
