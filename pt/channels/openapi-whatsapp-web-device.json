{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Consultar aparelho do WhatsApp Web",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/zapi/device": {
      "get": {
        "summary": "Consultar aparelho do WhatsApp Web",
        "description": "Consulta qual número e qual aparelho estão vinculados a um canal `Z_API_WHATSAPP` (WhatsApp Web). Chame sempre do backend. Veja [Status e aparelho do WhatsApp Web](/channels/whatsapp-web-status).",
        "operationId": "getWhatsAppWebDevice",
        "tags": [
          "Canais"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal `Z_API_WHATSAPP`",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Aparelho conectado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhatsAppWebDeviceResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Canal inexistente ou de outro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "422": {
            "description": "O provedor recusou a consulta. O campo `error` traz o envelope do provedor, com o nome do erro em `error.errors[0].name`, ou, sem envelope, um texto genérico.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ProviderError"
                    },
                    {
                      "type": "object",
                      "required": [
                        "error"
                      ],
                      "properties": {
                        "error": {
                          "type": "string",
                          "description": "Texto genérico, quando a recusa do provedor vem sem envelope",
                          "example": "The operation could not be completed right now. Try again in a few moments."
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "502": {
            "description": "Serviço interno indisponível. Tente de novo em alguns instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Secret Key recusada. Veja os motivos em Autenticação.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "example": "Bearer"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Authorization invalid",
              "message": "Authorization invalid: this Secret Key does not exist or is no longer valid. Copy the current Secret Key under Security in the panel and send it as \"Authorization: Bearer <secret-key>\". See https://developer.omni.z-api.io/en/authentication"
            }
          }
        }
      },
      "Forbidden": {
        "description": "IP fora da lista do workspace (ver [Restrição de IP](/security/ip-restriction))",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "ip_not_allowed",
              "message": "203.0.113.10 not allowed: this workspace only accepts API calls from the IPs on its allow list. The workspace Owner can add this IP under Administration > Security > IP Restriction in the panel (changes take up to 10 minutes to apply), or call from an allowed IP. See https://developer.omni.z-api.io/en/security/ip-restriction"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ProviderError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "description": "Envelope de erro do provedor",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "WhatsAppWebDeviceResponse": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "Número conectado"
          },
          "imgUrl": {
            "type": "string",
            "description": "URL da foto do perfil"
          },
          "name": {
            "type": "string",
            "description": "Nome do perfil"
          },
          "device": {
            "type": "object",
            "properties": {
              "sessionName": {
                "type": "string",
                "description": "Nome da sessão"
              },
              "deviceModel": {
                "type": "string",
                "description": "Modelo do aparelho"
              }
            }
          },
          "originalDevice": {
            "description": "Aparelho original"
          },
          "sessionId": {
            "type": "string",
            "description": "ID da sessão"
          },
          "isBusiness": {
            "type": "boolean",
            "description": "Se a conta é do WhatsApp Business"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key gerada no painel de Segurança do Omni Z-API"
      }
    }
  }
}
