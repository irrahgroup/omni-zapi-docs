{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Ativar canal Instagram",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/activate-instagram": {
      "post": {
        "summary": "Ativar canal Instagram",
        "description": "Ativa um canal **META_INSTAGRAM** com o `code` e o `redirectUri` devolvidos pelo SDK `@omnizapi/connect`. Chame sempre do backend. Configure o timeout do seu cliente HTTP acima de 60 segundos: a API só começa um novo passo da ativação dentro de 50 segundos, mas um passo que já começou vai até o fim, e o gateway encerra a requisição em 60 segundos. Veja [Ativar canal](/channels/activate-channel).",
        "operationId": "activateInstagramChannel",
        "tags": [
          "Canais"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal `META_INSTAGRAM`",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivateInstagramRequest"
              },
              "example": {
                "code": "CODE_DO_SDK",
                "redirectUri": "REDIRECT_URI_DO_SDK"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canal ativado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivateInstagramResponse"
                },
                "example": {
                  "id": "17841400000000000",
                  "connected": true,
                  "username": "minhaloja",
                  "name": "Minha Loja",
                  "displayName": "Minha Loja"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Canal inexistente ou de outro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "422": {
            "description": "O provedor recusou a ativação, ou o tipo do canal não é o da rota. Sem `code` ou sem `redirectUri`, a API responde `422`. Se o canal já está ativo no provedor, o `error` é `INSTAGRAM_META_IS_ALREADY_ACTIVATED`. Em geral, o campo `error` traz o envelope do provedor, com o nome do erro em `error.errors[0].name`; quando o provedor recusa sem esse envelope, vem como texto genérico.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ProviderError"
                    },
                    {
                      "type": "object",
                      "required": [
                        "error"
                      ],
                      "properties": {
                        "error": {
                          "type": "string",
                          "description": "Texto genérico, quando a recusa do provedor vem sem envelope",
                          "example": "The operation could not be completed right now. Try again in a few moments."
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "502": {
            "description": "Serviço interno indisponível. Tente de novo em alguns instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          },
          "504": {
            "description": "A ativação demorou demais (`integration_timeout`): pode repetir a chamada. Ou a ativação não terminou no prazo e ainda pode ser concluída (`outcome_unknown`): confira o resultado antes de repetir.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "timeout": {
                    "summary": "A ativação demorou demais",
                    "value": {
                      "error": "integration_timeout"
                    }
                  },
                  "outcomeUnknown": {
                    "summary": "Resultado desconhecido",
                    "value": {
                      "error": "outcome_unknown"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Secret Key recusada. Veja os motivos em Autenticação.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "example": "Bearer"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Authorization invalid",
              "message": "Authorization invalid: this Secret Key does not exist or is no longer valid. Copy the current Secret Key under Security in the panel and send it as \"Authorization: Bearer <secret-key>\". See https://developer.omni.z-api.io/en/authentication"
            }
          }
        }
      },
      "Forbidden": {
        "description": "IP fora da lista do workspace (ver [Restrição de IP](/security/ip-restriction))",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "ip_not_allowed",
              "message": "203.0.113.10 not allowed: this workspace only accepts API calls from the IPs on its allow list. The workspace Owner can add this IP under Administration > Security > IP Restriction in the panel (changes take up to 10 minutes to apply), or call from an allowed IP. See https://developer.omni.z-api.io/en/security/ip-restriction"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ProviderError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "description": "Envelope de erro do provedor",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ActivateInstagramRequest": {
        "type": "object",
        "required": [
          "code",
          "redirectUri"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "`code` devolvido pelo SDK"
          },
          "redirectUri": {
            "type": "string",
            "description": "`redirectUri` devolvido pelo SDK"
          }
        }
      },
      "ActivateInstagramResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "connected": {
            "type": "boolean"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key gerada no painel de Segurança do Omni Z-API"
      }
    }
  }
}
