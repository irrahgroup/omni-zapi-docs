{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Conectar Canal",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/connect": {
      "post": {
        "summary": "Conectar canal Meta WhatsApp",
        "description": "Finaliza a conexão de um canal **META_WHATSAPP** com os dados retornados pelo SDK `@omnizapi/connect`. Exclusivo para canais da API Oficial do WhatsApp (Meta). Para canais Instagram, Messenger e Telegram, use as rotas `activate-*` ([Ativar canal](/channels/activate-channel)).",
        "operationId": "connectMetaChannel",
        "tags": [
          "Canais"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal (obtido via Criar canal)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectChannelRequest"
              },
              "example": {
                "wabaId": "428083093730937",
                "phoneId": "123456789012345",
                "code": "ABC123DEF456",
                "coexistence": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canal conectado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectChannelResponse"
                },
                "example": {
                  "phoneId": "123456789012345",
                  "connected": true,
                  "success": true,
                  "isCoexistence": false,
                  "phoneConnected": "5511999999999",
                  "businessName": "Minha Loja"
                }
              }
            }
          },
          "400": {
            "description": "`wabaId` ausente. Esta rota vale só para canais `META_WHATSAPP`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "wabaId is required"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Canal inexistente ou de outro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "409": {
            "description": "Canal já conectado ao mesmo `phoneId`, e a Meta confirma que o número funciona. Nada muda no canal e o `code` não é usado. Para renovar a conexão do mesmo número, desconecte antes. Reconheça pelo campo `error`, que é estável; `message` é sempre em inglês.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelAlreadyConnectedError"
                },
                "example": {
                  "error": "channel_already_connected",
                  "message": "Channel already connected"
                }
              }
            }
          },
          "422": {
            "description": "Recusa do provedor. Em geral, o campo `error` traz o envelope do provedor, com o nome do erro em `errors[0].name`. Quando o provedor recusa sem esse envelope, o `error` vem como texto genérico.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ProviderError"
                    },
                    {
                      "type": "object",
                      "required": [
                        "error"
                      ],
                      "properties": {
                        "error": {
                          "type": "string",
                          "description": "Texto genérico, quando a recusa do provedor vem sem envelope",
                          "example": "The operation could not be completed right now. Try again in a few moments."
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "502": {
            "description": "Serviço interno indisponível. Tente de novo em alguns instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Secret Key recusada. Veja os motivos em Autenticação.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "example": "Bearer"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Authorization invalid",
              "message": "Authorization invalid: this Secret Key does not exist or is no longer valid. Copy the current Secret Key under Security in the panel and send it as \"Authorization: Bearer <secret-key>\". See https://developer.omni.z-api.io/en/authentication"
            }
          }
        }
      }
    },
    "schemas": {
      "ConnectChannelRequest": {
        "type": "object",
        "required": [
          "wabaId"
        ],
        "properties": {
          "wabaId": {
            "type": "string",
            "description": "ID do WhatsApp Business Account"
          },
          "phoneId": {
            "type": "string",
            "description": "ID do número de telefone"
          },
          "code": {
            "type": "string",
            "description": "Código de autorização gerado pelo WhatsApp"
          },
          "coexistence": {
            "type": "boolean",
            "description": "Se o número está em modo de coexistência"
          }
        }
      },
      "ChannelAlreadyConnectedError": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "channel_already_connected"
            ],
            "description": "Código estável da recusa"
          },
          "message": {
            "type": "string",
            "description": "Texto fixo, sempre em inglês"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ConnectChannelResponse": {
        "type": "object",
        "properties": {
          "phoneId": {
            "type": "string",
            "description": "ID do número de telefone"
          },
          "connected": {
            "type": "boolean",
            "description": "Se o canal ficou conectado"
          },
          "success": {
            "type": "boolean",
            "description": "Se a operação foi realizada com sucesso"
          },
          "isCoexistence": {
            "type": "boolean",
            "description": "Se o número está em modo de coexistência"
          },
          "phoneConnected": {
            "type": "string",
            "description": "Número conectado"
          },
          "businessName": {
            "type": "string",
            "description": "Nome da conta comercial"
          }
        }
      },
      "ProviderError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "description": "Envelope de erro do provedor",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key gerada no painel de Segurança do Omni Z-API"
      }
    }
  }
}
