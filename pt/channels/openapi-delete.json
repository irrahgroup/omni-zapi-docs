{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Excluir canal",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}": {
      "delete": {
        "summary": "Remover canal",
        "description": "Exclui um canal. A exclusão só é permitida com o canal desconectado e sem assinatura ativa. Requer role ENTERPRISE.",
        "operationId": "deleteChannel",
        "tags": [
          "Canais"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal (obtido em Criar canal ou Listar canais)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteRequest"
              },
              "example": {
                "cancelReason": "Cliente encerrou a empresa"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Canal excluído. Nenhum conteúdo retornado."
          },
          "400": {
            "description": "Secret Key ausente, malformada ou inexistente, IP fora da lista de IPs liberados ou requisição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Secret Key inválida",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP fora da lista",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Canal inexistente ou de outro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "422": {
            "description": "Conta sem role ENTERPRISE, ou regra de negócio violada. Nos erros de negócio, o código vem em `error.type`.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/BusinessError"
                    }
                  ]
                },
                "examples": {
                  "enterpriseRequired": {
                    "summary": "Conta sem role ENTERPRISE",
                    "value": {
                      "error": "Channel deletion requires ENTERPRISE role"
                    }
                  },
                  "channelConnected": {
                    "summary": "Canal ainda conectado",
                    "value": {
                      "error": {
                        "type": "INSTANCE_STILL_CONNECTED"
                      }
                    }
                  },
                  "activeSubscription": {
                    "summary": "Canal com assinatura ativa (PAID ou CANCELLATION_PROCESS)",
                    "value": {
                      "error": {
                        "type": "INSTANCE_HAS_ACTIVE_SUBSCRIPTION"
                      }
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Falha de integração. A operação não foi concluída; tente de novo em alguns instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Motivo do erro"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código estável do erro"
          },
          "message": {
            "type": "string",
            "description": "Texto do erro, em inglês"
          }
        }
      },
      "DeleteRequest": {
        "type": "object",
        "properties": {
          "cancelReason": {
            "type": "string",
            "description": "Motivo da exclusão (opcional, recomendado para auditoria)"
          }
        }
      },
      "BusinessError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Código de negócio do erro"
              },
              "message": {
                "type": "string",
                "description": "Texto descritivo do erro"
              },
              "details": {
                "description": "Detalhes adicionais, quando houver"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key gerada em Segurança, no painel do Z-API Omni. O prefixo `Bearer` é opcional."
      }
    }
  }
}
