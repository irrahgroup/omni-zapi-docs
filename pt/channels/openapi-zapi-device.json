{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Dados do aparelho do WhatsApp Web",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/zapi/device": {
      "get": {
        "summary": "Consultar aparelho",
        "description": "Devolve os dados do número e do aparelho conectados a um canal `Z_API_WHATSAPP`. Não exige ENTERPRISE.",
        "operationId": "zapiDevice",
        "tags": [
          "Canais"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal (obtido em Criar canal ou Listar canais)",
            "schema": {
              "type": "string",
              "example": "019E4C54B1B375A28970B605CA9B03C3"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do aparelho",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZapiDevice"
                },
                "example": {
                  "phone": "5511999999999",
                  "imgUrl": "https://pps.whatsapp.net/v/t61.24694-24/foto.jpg",
                  "name": "Loja",
                  "device": {
                    "sessionName": "Z-API Omni",
                    "deviceModel": "iPhone 15"
                  },
                  "originalDevice": "iphone",
                  "sessionId": 0,
                  "isBusiness": true
                }
              }
            }
          },
          "400": {
            "description": "Secret Key ausente, malformada ou inexistente, IP fora da lista de IPs liberados ou requisição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Secret Key inválida",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP fora da lista",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Canal inexistente ou de outro workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Instance not found"
                }
              }
            }
          },
          "502": {
            "description": "Falha de integração. A operação não foi concluída; tente de novo em alguns instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Motivo do erro"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código estável do erro"
          },
          "message": {
            "type": "string",
            "description": "Texto do erro, em inglês"
          }
        }
      },
      "ZapiDevice": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "Número conectado, com DDI"
          },
          "imgUrl": {
            "type": "string",
            "description": "URL da foto do perfil"
          },
          "name": {
            "type": "string",
            "description": "Nome do perfil no WhatsApp"
          },
          "device": {
            "type": "object",
            "description": "Dados da sessão e do aparelho",
            "properties": {
              "sessionName": {
                "type": "string",
                "description": "Nome da sessão em Aparelhos conectados"
              },
              "deviceModel": {
                "type": "string",
                "description": "Modelo do celular"
              }
            }
          },
          "originalDevice": {
            "type": "string",
            "description": "Informativo"
          },
          "sessionId": {
            "type": "integer",
            "description": "Informativo"
          },
          "isBusiness": {
            "type": "boolean",
            "description": "`true` quando o número é do WhatsApp Business"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key gerada em Segurança, no painel do Z-API Omni. O prefixo `Bearer` é opcional."
      }
    }
  }
}
