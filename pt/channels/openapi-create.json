{
  "openapi": "3.1.0",
  "info": {
    "title": "Z-API Omni - Criar canal",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels": {
      "post": {
        "summary": "Criar canal",
        "description": "Cria um novo canal no workspace da Secret Key. O canal nasce em `TRIAL` por 2 dias; para mantê-lo, assine com Assinar canal. Aceita só a Secret Key. Requer role ENTERPRISE.",
        "operationId": "createChannel",
        "tags": [
          "Canais"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChannelRequest"
              },
              "example": {
                "name": "Meu canal WhatsApp",
                "type": "META_WHATSAPP"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Canal criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateChannelResponse"
                },
                "example": {
                  "id": "019E4C54B1B375A28970B605CA9B03C3",
                  "token": "F1B29C3D4E5A6B7C8D9E0F1A2B3C4D5E"
                }
              }
            }
          },
          "400": {
            "description": "Secret Key ausente, malformada ou inexistente, IP fora da lista de IPs liberados ou requisição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "authorization": {
                    "summary": "Secret Key inválida",
                    "value": {
                      "error": "Authorization invalid"
                    }
                  },
                  "ipNotAllowed": {
                    "summary": "IP fora da lista",
                    "value": {
                      "error": "203.0.113.10 not allowed"
                    }
                  },
                  "typeRequired": {
                    "summary": "Sem type",
                    "value": {
                      "error": "type is required"
                    }
                  },
                  "bodyMissing": {
                    "summary": "type fora da lista ou JSON inválido",
                    "value": {
                      "error": "Required request body is missing"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Nome já usado por outro canal ativo do workspace. A comparação ignora maiúsculas e os espaços das pontas; acento e espaço interno diferenciam. Reconheça pelo campo `error`, que é estável; `message` é sempre em inglês.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "channel_name_in_use",
                  "message": "A channel with this name already exists in this workspace. Pick another one."
                }
              }
            }
          },
          "422": {
            "description": "Tipo de canal não habilitado no workspace, ou conta sem role ENTERPRISE",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErrorWithMessage"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                },
                "examples": {
                  "channelTypeNotEnabled": {
                    "summary": "WhatsApp Web não habilitado",
                    "value": {
                      "error": "channel_type_not_enabled",
                      "message": "Z_API_WHATSAPP channel is not enabled for this workspace. Contact support."
                    }
                  },
                  "enterpriseRequired": {
                    "summary": "Conta sem role ENTERPRISE",
                    "value": {
                      "error": "Channel creation requires ENTERPRISE role"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Falha de integração. A operação não foi concluída; tente de novo em alguns instantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                },
                "example": {
                  "error": "integration_unavailable",
                  "message": "The operation could not be completed right now. Try again in a few moments."
                }
              }
            }
          },
          "504": {
            "description": "A criação não respondeu no prazo. Antes de repetir, confira em Listar canais se o canal foi criado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Motivo do erro"
          }
        }
      },
      "ErrorWithMessage": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código estável do erro"
          },
          "message": {
            "type": "string",
            "description": "Texto do erro, em inglês"
          }
        }
      },
      "CreateChannelRequest": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do canal, único entre os canais ativos do workspace"
          },
          "type": {
            "type": "string",
            "description": "Tipo do canal (plataforma)",
            "enum": [
              "META_WHATSAPP",
              "Z_API_WHATSAPP",
              "META_INSTAGRAM",
              "META_MESSENGER",
              "BOT_TELEGRAM"
            ]
          }
        }
      },
      "CreateChannelResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID do canal criado (channelId)"
          },
          "token": {
            "type": "string",
            "description": "Token do canal, o mesmo devolvido por `GET /v1/channels/{channelId}`. O token identifica o canal nas rotas no formato da Z-API, com o token no caminho. As rotas desta referência usam a Secret Key no header Authorization."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key gerada em Segurança, no painel do Z-API Omni. O prefixo `Bearer` é opcional."
      }
    }
  }
}
