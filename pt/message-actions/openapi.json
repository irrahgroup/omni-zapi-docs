                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "CHAT_NOT_SUPPORTED",
                      "message": "This action is not supported for the chat of this message. Only messages of individual chats, groups and LID chats can be deleted, forwarded, pinned or answered; this one does not belong to one of these chats. Use a message from an individual chat, a group or a LID chat."
                    }
                  },
                  "instanceNotProvisioned": {
                    "summary": "Instância não provisionada",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Assinatura inativa",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "workspaceBlocked": {
                    "summary": "Workspace bloqueado",
                    "value": {
                      "error": "You are blocked, contact support."
                    }
                  },
                  "actionUnavailable": {
                    "summary": "Serviço que executa a ação ainda não atende o canal",
                    "value": {
                      "error": "Unpinning messages is not available for this channel right now. The service that runs this action does not serve this channel yet. Check GET /v1/channels/{channelId}/messages/capabilities and try again later; if it persists, contact support."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/IpNotAllowed"
          },
          "502": {
            "description": "Falha no serviço de mensagens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "failed": {
                    "summary": "Falha no serviço de mensagens",
                    "value": {
                      "error": "Message unpinning failed"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/channels/{channelId}/messages/{messageId}/choice": {
      "post": {
        "summary": "Escolher opção",
        "description": "Registra o clique numa opção de botão, lista ou template.",
        "operationId": "chooseOption",
        "tags": [
          "Ações em mensagem"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "description": "Id da mensagem no Omni (o mesmo que volta no envio e no webhook).",
            "schema": {
              "type": "string",
              "example": "01A1EA9883087E9EB1E0D7432E185E2B"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "optionId"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "BUTTON",
                      "LIST",
                      "TEMPLATE_BUTTON"
                    ]
                  },
                  "optionId": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "type": "BUTTON",
                "optionId": "1"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "OK (sem corpo)"
          },
          "400": {
            "description": "optionId / type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "optionId"
                }
              }
            }
          },
          "404": {
            "description": "Canal ou mensagem não encontrados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "messageNotFound": {
                    "summary": "Mensagem inexistente ou de outro canal",
                    "value": {
                      "code": "NOT_FOUND",
                      "subCode": "MESSAGE_NOT_FOUND",
                      "message": "message not found"
                    }
                  },
                  "instanceNotFound": {
                    "summary": "Canal inexistente",
                    "value": {
                      "error": "instance not found"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Ação recusada. Trate pelo `subCode` (ou pelo `error`, quando não há `subCode`); o `message` é para leitura e pode mudar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "notSupported": {
                    "summary": "Ação sem suporte no tipo do canal (ex.: Meta)",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "CHOICE_NOT_SUPPORTED",
                      "message": "Choosing an option is not supported for META_WHATSAPP channels, because the provider of this channel type cannot answer an interactive message on behalf of the channel. Only WhatsApp Web (Z_API_WHATSAPP) channels can; on this channel, send the answer as a text message instead"
                    }
                  },
                  "channelDisconnected": {
                    "summary": "Canal desconectado",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "CHANNEL_DISCONNECTED",
                      "message": "Channel is disconnected: the option was not chosen because the WhatsApp Web channel is not connected right now. Reconnect the channel by reading a new QR code and choose again. See https://developer.omni.z-api.io/en/connect/whatsapp-web"
                    }
                  },
                  "channelInstanceNotProvisioned": {
                    "summary": "Instância Z-API do canal não provisionada",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "INSTANCE_NOT_PROVISIONED",
                      "message": "The Z-API instance of this channel is not provisioned"
                    }
                  },
                  "messageWithoutProviderId": {
                    "summary": "Mensagem ainda sem id no WhatsApp (ex.: não entregue)",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "MESSAGE_WITHOUT_PROVIDER_ID",
                      "message": "Message has no provider id"
                    }
                  },
                  "chatNotSupported": {
                    "summary": "Conversa que não é telefone, grupo nem @lid",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "CHAT_NOT_SUPPORTED",
                      "message": "This action is not supported for the chat of this message. Only messages of individual chats, groups and LID chats can be deleted, forwarded, pinned or answered; this one does not belong to one of these chats. Use a message from an individual chat, a group or a LID chat."
                    }
                  },
                  "instanceNotProvisioned": {
                    "summary": "Instância não provisionada",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Assinatura inativa",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "workspaceBlocked": {
                    "summary": "Workspace bloqueado",
                    "value": {
                      "error": "You are blocked, contact support."
                    }
                  },
                  "actionUnavailable": {
                    "summary": "Serviço que executa a ação ainda não atende o canal",
                    "value": {
                      "error": "Choosing an option is not available for this channel right now. The service that runs this action does not serve this channel yet. Check GET /v1/channels/{channelId}/messages/capabilities and try again later; if it persists, contact support."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/IpNotAllowed"
          },
          "502": {
            "description": "Falha no serviço de mensagens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "failed": {
                    "summary": "Falha no serviço de mensagens",
                    "value": {
                      "error": "Option choice failed"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "subCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Credencial recusada (API Omni)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Authorization invalid",
              "message": "Authorization invalid: the Authorization header is missing or empty. Send the workspace Secret Key as \"Authorization: Bearer <secret-key>\". See https://developer.omni.z-api.io/en/authentication"
            }
          }
        },
        "headers": {
          "WWW-Authenticate": {
            "description": "Sempre `Bearer`.",
            "schema": {
              "type": "string"
            },
            "example": "Bearer"
          }
        }
      },
      "IpNotAllowed": {
        "description": "IP fora da lista (API Omni)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "ip_not_allowed",
              "message": "203.0.113.10 not allowed: this workspace only accepts API calls from the IPs on its allow list. The workspace Owner can add this IP under Administration > Security > IP Restriction in the panel (changes take up to 10 minutes to apply), or call from an allowed IP. See https://developer.omni.z-api.io/en/security/ip-restriction"
            }
          }
        }
      }
    }
  }
}
