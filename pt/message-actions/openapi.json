{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Ações em mensagem",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages/capabilities": {
      "get": {
        "summary": "Capacidades de ação",
        "description": "Lista as ações em mensagem disponíveis no canal. No canal Meta, a lista vem vazia.",
        "operationId": "messageActionCapabilities",
        "tags": [
          "Ações em mensagem"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Capacidades de ação",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "operations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "examples": {
                  "whatsappWeb": {
                    "value": {
                      "type": "Z_API_WHATSAPP",
                      "operations": [
                        "DELETE_MESSAGE",
                        "FORWARD_MESSAGE",
                        "PIN_MESSAGE",
                        "UNPIN_MESSAGE",
                        "CHOOSE_OPTION"
                      ]
                    }
                  },
                  "meta": {
                    "value": {
                      "type": "META_WHATSAPP",
                      "operations": []
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/IpNotAllowed"
          },
          "404": {
            "description": "Canal não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "instanceNotFound": {
                    "summary": "Canal inexistente",
                    "value": {
                      "error": "instance not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/channels/{channelId}/messages/{messageId}": {
      "delete": {
        "summary": "Apagar mensagem",
        "description": "Apaga a mensagem para todos.",
        "operationId": "deleteMessage",
        "tags": [
          "Ações em mensagem"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "description": "Id da mensagem no Omni (o mesmo que volta no envio e no webhook).",
            "schema": {
              "type": "string",
              "example": "01A1EA9883087E9EB1E0D7432E185E2B"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messageId": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "messageId": "01A1EA9883087E9EB1E0D7432E185E2B"
                }
              }
            }
          },
          "404": {
            "description": "Canal ou mensagem não encontrados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "messageNotFound": {
                    "summary": "Mensagem inexistente ou de outro canal",
                    "value": {
                      "code": "NOT_FOUND",
                      "subCode": "MESSAGE_NOT_FOUND",
                      "message": "message not found"
                    }
                  },
                  "instanceNotFound": {
                    "summary": "Canal inexistente",
                    "value": {
                      "error": "instance not found"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Ação recusada. Trate pelo `subCode` (ou pelo `error`, quando não há `subCode`); o `message` é para leitura e pode mudar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "notSupported": {
                    "summary": "Ação sem suporte no tipo do canal (ex.: Meta)",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "DELETE_NOT_SUPPORTED",
                      "message": "Deleting messages is not supported for META_WHATSAPP channels, because the provider of this channel type cannot delete a message. Only WhatsApp Web (Z_API_WHATSAPP) channels can; on this channel the message stays visible to the contact"
                    }
                  },
                  "channelDisconnected": {
                    "summary": "Canal desconectado",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "CHANNEL_DISCONNECTED",
                      "message": "Channel is disconnected: the message was not deleted because the WhatsApp Web channel is not connected right now. Reconnect the channel by reading a new QR code and delete again. See https://developer.omni.z-api.io/en/connect/whatsapp-web"
                    }
                  },
                  "channelInstanceNotProvisioned": {
                    "summary": "Instância Z-API do canal não provisionada",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "INSTANCE_NOT_PROVISIONED",
                      "message": "The Z-API instance of this channel is not provisioned"
                    }
                  },
                  "messageWithoutProviderId": {
                    "summary": "Mensagem ainda sem id no WhatsApp (ex.: não entregue)",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "MESSAGE_WITHOUT_PROVIDER_ID",
                      "message": "Message has no provider id"
                    }
                  },
                  "chatNotSupported": {
                    "summary": "Conversa que não é telefone, grupo nem @lid",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "CHAT_NOT_SUPPORTED",
                      "message": "This action is not supported for the chat of this message. Only messages of individual chats, groups and LID chats can be deleted, forwarded, pinned or answered; this one does not belong to one of these chats. Use a message from an individual chat, a group or a LID chat."
                    }
                  },
                  "instanceNotProvisioned": {
                    "summary": "Instância não provisionada",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Assinatura inativa",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "workspaceBlocked": {
                    "summary": "Workspace bloqueado",
                    "value": {
                      "error": "You are blocked, contact support."
                    }
                  },
                  "actionUnavailable": {
                    "summary": "Serviço que executa a ação ainda não atende o canal",
                    "value": {
                      "error": "Deleting messages is not available for this channel right now. The service that runs this action does not serve this channel yet. Check GET /v1/channels/{channelId}/messages/capabilities and try again later; if it persists, contact support."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/IpNotAllowed"
          },
          "502": {
            "description": "Falha no serviço de mensagens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "failed": {
                    "summary": "Falha no serviço de mensagens",
                    "value": {
                      "error": "Message deletion failed"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/channels/{channelId}/messages/{messageId}/forward": {
      "post": {
        "summary": "Encaminhar mensagem",
        "description": "Encaminha a mensagem para outro destinatário.",
        "operationId": "forwardMessage",
        "tags": [
          "Ações em mensagem"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "description": "Id da mensagem no Omni (o mesmo que volta no envio e no webhook).",
            "schema": {
              "type": "string",
              "example": "01A1EA9883087E9EB1E0D7432E185E2B"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "recipient"
                ],
                "properties": {
                  "recipient": {
                    "type": "object",
                    "required": [
                      "identifier"
                    ],
                    "properties": {
                      "identifier": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "example": {
                "recipient": {
                  "identifier": "5544936181389"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messageId": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "messageId": "01A1EEE46ACE7CABA47824FD91E490DB"
                }
              }
            }
          },
          "400": {
            "description": "recipient.identifier é obrigatório",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "recipient.identifier"
                }
              }
            }
          },
          "404": {
            "description": "Canal ou mensagem não encontrados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "messageNotFound": {
                    "summary": "Mensagem inexistente ou de outro canal",
                    "value": {
                      "code": "NOT_FOUND",
                      "subCode": "MESSAGE_NOT_FOUND",
                      "message": "message not found"
                    }
                  },
                  "instanceNotFound": {
                    "summary": "Canal inexistente",
                    "value": {
                      "error": "instance not found"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Ação recusada. Trate pelo `subCode` (ou pelo `error`, quando não há `subCode`); o `message` é para leitura e pode mudar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "notSupported": {
                    "summary": "Ação sem suporte no tipo do canal (ex.: Meta)",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "FORWARD_NOT_SUPPORTED",
                      "message": "Forwarding messages is not supported for META_WHATSAPP channels, because the provider of this channel type cannot forward a message. Only WhatsApp Web (Z_API_WHATSAPP) channels can; on this channel, send the content as a new message instead"
                    }
                  },
                  "channelDisconnected": {
                    "summary": "Canal desconectado",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "CHANNEL_DISCONNECTED",
                      "message": "Channel is disconnected: the message was not forwarded because the WhatsApp Web channel is not connected right now. Reconnect the channel by reading a new QR code and forward again. See https://developer.omni.z-api.io/en/connect/whatsapp-web"
                    }
                  },
                  "channelInstanceNotProvisioned": {
                    "summary": "Instância Z-API do canal não provisionada",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "INSTANCE_NOT_PROVISIONED",
                      "message": "The Z-API instance of this channel is not provisioned"
                    }
                  },
                  "messageWithoutProviderId": {
                    "summary": "Mensagem ainda sem id no WhatsApp (ex.: não entregue)",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "MESSAGE_WITHOUT_PROVIDER_ID",
                      "message": "Message has no provider id"
                    }
                  },
                  "chatNotSupported": {
                    "summary": "Conversa que não é telefone, grupo nem @lid",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "CHAT_NOT_SUPPORTED",
                      "message": "This action is not supported for the chat of this message. Only messages of individual chats, groups and LID chats can be deleted, forwarded, pinned or answered; this one does not belong to one of these chats. Use a message from an individual chat, a group or a LID chat."
                    }
                  },
                  "instanceNotProvisioned": {
                    "summary": "Instância não provisionada",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Assinatura inativa",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "workspaceBlocked": {
                    "summary": "Workspace bloqueado",
                    "value": {
                      "error": "You are blocked, contact support."
                    }
                  },
                  "actionUnavailable": {
                    "summary": "Serviço que executa a ação ainda não atende o canal",
                    "value": {
                      "error": "Forwarding messages is not available for this channel right now. The service that runs this action does not serve this channel yet. Check GET /v1/channels/{channelId}/messages/capabilities and try again later; if it persists, contact support."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/IpNotAllowed"
          },
          "502": {
            "description": "Falha no serviço de mensagens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "failed": {
                    "summary": "Falha no serviço de mensagens",
                    "value": {
                      "error": "Message forwarding failed"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/channels/{channelId}/messages/{messageId}/pin": {
      "post": {
        "summary": "Fixar mensagem",
        "description": "Fixa a mensagem na conversa pela duração informada.",
        "operationId": "pinMessage",
        "tags": [
          "Ações em mensagem"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "Channel id",
            "schema": {
              "type": "string",
              "example": "58907809F0964E998D36C87F10EBA60C"
            }
          },
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "description": "Id da mensagem no Omni (o mesmo que volta no envio e no webhook).",
            "schema": {
              "type": "string",
              "example": "01A1EA9883087E9EB1E0D7432E185E2B"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "duration"
                ],
                "properties": {
                  "duration": {
                    "type": "string",
                    "enum": [
                      "24_HOURS",
                      "7_DAYS",
                      "30_DAYS"
                    ]
                  }
                }
              },
              "example": {
                "duration": "24_HOURS"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "OK (sem corpo)"
          },
          "400": {
            "description": "duration fora dos valores aceitos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_request",
                  "field": "duration"
                }
              }
            }
          },
          "404": {
            "description": "Canal ou mensagem não encontrados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
