                  "messageNotFound": {
                    "summary": "Mensagem inexistente ou de outro canal",
                    "value": {
                      "code": "NOT_FOUND",
                      "subCode": "MESSAGE_NOT_FOUND",
                      "message": "message not found"
                    }
                  },
                  "instanceNotFound": {
                    "summary": "Canal inexistente",
                    "value": {
                      "error": "instance not found"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Ação recusada. Trate pelo `subCode` (ou pelo `error`, quando não há `subCode`); o `message` é para leitura e pode mudar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "notSupported": {
                    "summary": "Ação sem suporte no tipo do canal (ex.: Meta)",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "PIN_NOT_SUPPORTED",
                      "message": "Pinning messages is not supported for META_WHATSAPP channels, because the provider of this channel type cannot pin a message. Only WhatsApp Web (Z_API_WHATSAPP) channels can; on this channel, reply quoting the message to highlight it instead"
                    }
                  },
                  "channelDisconnected": {
                    "summary": "Canal desconectado",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "CHANNEL_DISCONNECTED",
                      "message": "Channel is disconnected: the message was not pinned because the WhatsApp Web channel is not connected right now. Reconnect the channel by reading a new QR code and pin again. See https://developer.omni.z-api.io/en/connect/whatsapp-web"
                    }
                  },
                  "channelInstanceNotProvisioned": {
                    "summary": "Instância Z-API do canal não provisionada",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "INSTANCE_NOT_PROVISIONED",
                      "message": "The Z-API instance of this channel is not provisioned"
                    }
                  },
                  "messageWithoutProviderId": {
                    "summary": "Mensagem ainda sem id no WhatsApp (ex.: não entregue)",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "MESSAGE_WITHOUT_PROVIDER_ID",
                      "message": "Message has no provider id"
                    }
                  },
                  "chatNotSupported": {
                    "summary": "Conversa que não é telefone, grupo nem @lid",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "CHAT_NOT_SUPPORTED",
                      "message": "This action is not supported for the chat of this message. Only messages of individual chats, groups and LID chats can be deleted, forwarded, pinned or answered; this one does not belong to one of these chats. Use a message from an individual chat, a group or a LID chat."
                    }
                  },
                  "instanceNotProvisioned": {
                    "summary": "Instância não provisionada",
                    "value": {
                      "error": "instance is not provisioned"
                    }
                  },
                  "subscriptionInactive": {
                    "summary": "Assinatura inativa",
                    "value": {
                      "error": "instance subscription is not active"
                    }
                  },
                  "workspaceBlocked": {
                    "summary": "Workspace bloqueado",
                    "value": {
                      "error": "You are blocked, contact support."
                    }
                  },
                  "actionUnavailable": {
                    "summary": "Serviço que executa a ação ainda não atende o canal",
                    "value": {
                      "error": "Pinning messages is not available for this channel right now. The service that runs this action does not serve this channel yet. Check GET /v1/channels/{channelId}/messages/capabilities and try again later; if it persists, contact support."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/IpNotAllowed"
          },
          "502": {
            "description": "Falha no serviço de mensagens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "failed": {
                    "summary": "Falha no serviço de mensagens",
                    "value": {
                      "error": "Message pinning failed"
                    }
                  }
                }
              }
            }
          }
        }
      },
