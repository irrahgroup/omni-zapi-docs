{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Editar mensagem",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages/{messageId}": {
      "put": {
        "summary": "Editar mensagem",
        "description": "Troca o texto de uma mensagem de texto que o seu canal já enviou, nos canais que permitem edição (WhatsApp Web e Telegram). O destinatário vê o texto novo no lugar do antigo, com a marca de editada do aplicativo. Nenhuma mensagem nova é enviada. Veja [Editar mensagem](/messages/edit-message).",
        "operationId": "editMessage",
        "tags": [
          "Mensagens"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "O canal que enviou a mensagem",
            "schema": {
              "type": "string",
              "example": "SEU_CHANNEL_ID"
            }
          },
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "description": "O `messageId` que o envio devolveu. O `contents[].identifier` recebido no webhook também é aceito",
            "schema": {
              "type": "string",
              "example": "01A0C92D0C957FE98B73C8BA0CACF741"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditMessageRequest"
              },
              "example": {
                "content": {
                  "type": "TEXT",
                  "body": {
                    "message": "Texto corrigido"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Edição aceita e encaminhada ao canal. Não garante que o aplicativo do contato já mostra o texto novo: se o canal recusar depois, o texto do contato não muda e a API não envia aviso dessa recusa.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "messageId": "01A0C92D0C957FE98B73C8BA0CACF741"
                }
              }
            }
          },
          "400": {
            "description": "Corpo ausente ou vazio, `content.type` diferente de `TEXT` ou `content.body.message` vazio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendError"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "O `messageId` não existe ou não é deste canal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendError"
                }
              }
            }
          },
          "422": {
            "description": "Recusa da edição. Trate pelo `subCode`: `EDIT_NOT_SUPPORTED` (o canal não permite edição), `CHANNEL_DISCONNECTED` (o canal está desconectado), `MESSAGE_NOT_EDITABLE` (a mensagem não é texto, inclusive legenda de mídia, não foi enviada pelo seu canal, ainda não foi aceita pelo canal ou falhou no envio) e `EDIT_WINDOW_EXPIRED` (passou o prazo em que o canal aceita edição).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendError"
                },
                "examples": {
                  "notSupported": {
                    "summary": "Canal sem edição",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "EDIT_NOT_SUPPORTED"
                    }
                  },
                  "channelDisconnected": {
                    "summary": "Canal desconectado",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "CHANNEL_DISCONNECTED"
                    }
                  },
                  "notEditable": {
                    "summary": "Mensagem não editável",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "MESSAGE_NOT_EDITABLE"
                    }
                  },
                  "windowExpired": {
                    "summary": "Prazo de edição vencido",
                    "value": {
                      "code": "BUSINESS_RULE_VIOLATION",
                      "subCode": "EDIT_WINDOW_EXPIRED"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Token inválido ou ausente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": 401,
              "message": "Unauthorized"
            }
          }
        }
      },
      "Forbidden": {
        "description": "IP fora da lista do workspace (ver [Restrição de IP](/security/ip-restriction))",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "ip_not_allowed",
              "message": "203.0.113.10 not allowed: this workspace only accepts API calls from the IPs on its allow list. The workspace Owner can add this IP under Administration > Security > IP Restriction in the panel (changes take up to 10 minutes to apply), or call from an allowed IP. See https://developer.omni.z-api.io/en/security/ip-restriction"
            }
          }
        }
      }
    },
    "schemas": {
      "SendError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Data e hora da recusa, em UTC"
          },
          "code": {
            "type": "string",
            "description": "Categoria do erro",
            "example": "BUSINESS_RULE_VIOLATION"
          },
          "subCode": {
            "type": "string",
            "description": "Código do caso. Só vem quando o caso tem um código próprio",
            "example": "CHANNEL_DISCONNECTED"
          },
          "message": {
            "type": "string",
            "description": "Descrição do erro. O texto pode mudar: trate o erro por `code` e `subCode`",
            "example": "Channel is disconnected"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "`messageId` da mensagem editada"
          }
        }
      },
      "EditMessageRequest": {
        "type": "object",
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "type",
              "body"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Tipo do conteúdo. Só texto pode ser editado",
                "enum": [
                  "TEXT"
                ]
              },
              "body": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Texto novo da mensagem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key gerada no painel de Segurança do Omni Z-API"
      }
    }
  }
}
