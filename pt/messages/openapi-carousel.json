{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Enviar carrossel",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages": {
      "post": {
        "summary": "Enviar carrossel",
        "description": "Envie cartões com mídia e botões, lado a lado.",
        "operationId": "sendCarouselMessage",
        "tags": [
          "Mensagens"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal",
            "schema": {
              "type": "string",
              "example": "SEU_CHANNEL_ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendInteractiveCarouselRequest"
              },
              "example": {
                "recipient": {
                  "identifier": "5511999999999"
                },
                "content": {
                  "type": "INTERACTIVE_CAROUSEL",
                  "body": {
                    "message": "Separamos duas ofertas para você."
                  },
                  "attachments": [
                    {
                      "url": "https://exemplo.com/tenis.jpg",
                      "mimeType": "image/jpeg",
                      "message": "Tênis de corrida, de R$ 399 por R$ 299",
                      "list": [
                        {
                          "id": "ver-tenis",
                          "title": "Ver na loja",
                          "name": "URL",
                          "url": "https://exemplo.com/tenis"
                        },
                        {
                          "id": "quero-tenis",
                          "title": "Quero este",
                          "name": "REPLY"
                        }
                      ]
                    },
                    {
                      "url": "https://exemplo.com/mochila.jpg",
                      "mimeType": "image/jpeg",
                      "message": "Mochila impermeável, de R$ 249 por R$ 189",
                      "list": [
                        {
                          "id": "ver-mochila",
                          "title": "Ver na loja",
                          "name": "URL",
                          "url": "https://exemplo.com/mochila"
                        },
                        {
                          "id": "quero-mochila",
                          "title": "Quero esta",
                          "name": "REPLY"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MessageSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/SendRefused"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MessageSuccess": {
        "description": "Mensagem enviada com sucesso",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "example": {
              "messageId": "01A0C92D0C957FE98B73C8BA0CACF741"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Token inválido ou ausente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": 401,
              "message": "Unauthorized"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Corpo sem o campo obrigatório do tipo",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "example": {
              "timestamp": "2026-10-22T14:00:00.123Z",
              "code": "VALIDATION_ERROR",
              "message": "Field 'content.body': is required for message type INTERACTIVE_CAROUSEL"
            }
          }
        }
      },
      "SendRefused": {
        "description": "Canal desconectado, ou tipo que o canal não aceita. A mensagem não foi enviada.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "examples": {
              "channelDisconnected": {
                "summary": "CHANNEL_DISCONNECTED",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "BUSINESS_RULE_VIOLATION",
                  "subCode": "CHANNEL_DISCONNECTED",
                  "message": "Channel is disconnected"
                }
              },
              "unsupportedChannel": {
                "summary": "UNSUPPORTED_CHANNEL_TYPE",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "BUSINESS_RULE_VIOLATION",
                  "message": "[UNSUPPORTED_CHANNEL_TYPE] O canal TELEGRAM nao suporta mensagens do tipo INTERACTIVE_CAROUSEL"
                }
              },
              "unsupportedButton": {
                "summary": "UNSUPPORTED_CAROUSEL_BUTTON",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "BUSINESS_RULE_VIOLATION",
                  "message": "[UNSUPPORTED_CAROUSEL_BUTTON] O botao 1 do cartao 2 do carrossel tem tipo CALL; o carrossel aceita URL ou REPLY"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "SendInteractiveCarouselRequest": {
        "type": "object",
        "required": [
          "recipient",
          "content"
        ],
        "properties": {
          "recipient": {
            "type": "object",
            "required": [
              "identifier"
            ],
            "properties": {
              "identifier": {
                "type": "string",
                "description": "Telefone do destinatário (DDI + DDD + número)",
                "example": "5511999999999"
              }
            }
          },
          "content": {
            "type": "object",
            "required": [
              "type",
              "body",
              "attachments"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Tipo da mensagem",
                "enum": [
                  "INTERACTIVE_CAROUSEL"
                ]
              },
              "body": {
                "type": "object",
                "description": "Texto que vem antes dos cartões",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Texto da mensagem. A Meta exige"
                  }
                }
              },
              "attachments": {
                "type": "array",
                "description": "Os cartões, na ordem em que aparecem",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "description": "URL da mídia do cartão"
                    },
                    "mimeType": {
                      "type": "string",
                      "description": "Tipo da mídia, como `image/jpeg` ou `video/mp4`"
                    },
                    "message": {
                      "type": "string",
                      "description": "Texto do cartão"
                    },
                    "list": {
                      "type": "array",
                      "description": "Botões do cartão",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Identificador do botão"
                          },
                          "title": {
                            "type": "string",
                            "description": "Texto do botão"
                          },
                          "name": {
                            "type": "string",
                            "description": "Tipo do botão: `URL` abre um link e `REPLY` volta como resposta do cliente. Maiúsculas e minúsculas não importam"
                          },
                          "url": {
                            "type": "string",
                            "description": "Destino do botão `URL`. Nos botões `REPLY`, é ignorado"
                          }
                        },
                        "required": [
                          "name"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "ID da mensagem enviada — hexadecimal de 32 caracteres maiúsculos"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SendError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Data e hora da recusa, em UTC"
          },
          "code": {
            "type": "string",
            "description": "Categoria do erro",
            "example": "BUSINESS_RULE_VIOLATION"
          },
          "subCode": {
            "type": "string",
            "description": "Código do caso. Só vem quando o caso tem um código próprio",
            "example": "CHANNEL_DISCONNECTED"
          },
          "message": {
            "type": "string",
            "description": "Descrição do erro. O texto pode mudar: trate o erro por `code` e `subCode`",
            "example": "Channel is disconnected"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key gerada no painel de Segurança do Omni Z-API"
      }
    }
  }
}
