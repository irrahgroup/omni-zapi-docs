{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Enviar multi-produto",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages": {
      "post": {
        "summary": "Enviar multi-produto",
        "description": "Monte uma vitrine com seções e até 30 produtos.",
        "operationId": "sendMultiProductMessage",
        "tags": [
          "Mensagens"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal",
            "schema": {
              "type": "string",
              "example": "SEU_CHANNEL_ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendInteractiveMultiProductRequest"
              },
              "example": {
                "recipient": {
                  "identifier": "5511999999999"
                },
                "content": {
                  "type": "INTERACTIVE_MULTI_PRODUCT",
                  "header": {
                    "message": "Seleção da semana"
                  },
                  "body": {
                    "message": "Separamos alguns produtos para você."
                  },
                  "footer": {
                    "message": "Entrega em todo o Brasil"
                  },
                  "action": {
                    "catalogId": "1234567890"
                  },
                  "attachments": [
                    {
                      "title": "Camisetas",
                      "list": [
                        {
                          "id": "SKU-1042"
                        },
                        {
                          "id": "SKU-1043"
                        }
                      ]
                    },
                    {
                      "title": "Bermudas",
                      "list": [
                        {
                          "id": "SKU-2001"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MessageSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ChannelDisconnected"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MessageSuccess": {
        "description": "Mensagem enviada com sucesso",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "example": {
              "messageId": "01A0C92D0C957FE98B73C8BA0CACF741"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Token inválido ou ausente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": 401,
              "message": "Unauthorized"
            }
          }
        }
      },
      "ChannelDisconnected": {
        "description": "Canal desconectado. A mensagem não foi enviada: conecte o canal de novo e repita o envio.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "example": {
              "timestamp": "2026-10-22T14:00:00.123Z",
              "code": "BUSINESS_RULE_VIOLATION",
              "subCode": "CHANNEL_DISCONNECTED",
              "message": "Channel is disconnected"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Corpo sem o campo obrigatório do tipo",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "example": {
              "timestamp": "2026-10-22T14:00:00.123Z",
              "code": "VALIDATION_ERROR",
              "message": "Field 'content.body': is required for message type INTERACTIVE_MULTI_PRODUCT"
            }
          }
        }
      }
    },
    "schemas": {
      "SendInteractiveMultiProductRequest": {
        "type": "object",
        "required": [
          "recipient",
          "content"
        ],
        "properties": {
          "recipient": {
            "type": "object",
            "required": [
              "identifier"
            ],
            "properties": {
              "identifier": {
                "type": "string",
                "description": "Telefone do destinatário (DDI + DDD + número)",
                "example": "5511999999999"
              }
            }
          },
          "content": {
            "type": "object",
            "required": [
              "type",
              "body"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Tipo da mensagem",
                "enum": [
                  "INTERACTIVE_MULTI_PRODUCT"
                ]
              },
              "header": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Cabeçalho, só texto. A Meta exige"
                  }
                }
              },
              "body": {
                "type": "object",
                "description": "Corpo da mensagem",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Texto da mensagem"
                  }
                }
              },
              "footer": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Rodapé"
                  }
                }
              },
              "action": {
                "type": "object",
                "properties": {
                  "catalogId": {
                    "type": "string",
                    "description": "Id do catálogo no Commerce Manager. A Meta exige"
                  }
                }
              },
              "attachments": {
                "type": "array",
                "description": "As seções da vitrine",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "description": "Título da seção"
                    },
                    "list": {
                      "type": "array",
                      "description": "Produtos da seção. Mande sempre, mesmo com um produto só",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "SKU (`retailer_id`) do produto"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "ID da mensagem enviada — hexadecimal de 32 caracteres maiúsculos"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SendError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Data e hora da recusa, em UTC"
          },
          "code": {
            "type": "string",
            "description": "Categoria do erro",
            "example": "BUSINESS_RULE_VIOLATION"
          },
          "subCode": {
            "type": "string",
            "description": "Código do caso. Só vem quando o caso tem um código próprio",
            "example": "CHANNEL_DISCONNECTED"
          },
          "message": {
            "type": "string",
            "description": "Descrição do erro. O texto pode mudar: trate o erro por `code` e `subCode`",
            "example": "Channel is disconnected"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key gerada no painel de Segurança do Omni Z-API"
      }
    }
  }
}
