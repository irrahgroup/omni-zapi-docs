{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Enviar vários contatos",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels/{channelId}/messages": {
      "post": {
        "summary": "Enviar vários contatos",
        "description": "Envie vários contatos numa mensagem.",
        "operationId": "sendContactArrayMessage",
        "tags": [
          "Mensagens"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "description": "ID do canal",
            "schema": {
              "type": "string",
              "example": "SEU_CHANNEL_ID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendContactArrayRequest"
              },
              "example": {
                "recipient": {
                  "identifier": "5511999999999"
                },
                "content": {
                  "type": "CONTACT_ARRAY",
                  "attachments": [
                    {
                      "name": "Gutemberg Fernandes",
                      "phones": [
                        "5511888888888"
                      ]
                    },
                    {
                      "name": "Ana Souza",
                      "phones": [
                        "5511777777777",
                        "5511666666666"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/MessageSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/SendRefused"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MessageSuccess": {
        "description": "Mensagem enviada com sucesso",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "example": {
              "messageId": "01A0C92D0C957FE98B73C8BA0CACF741"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Token inválido ou ausente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": 401,
              "message": "Unauthorized"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Corpo sem o campo obrigatório do tipo",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "example": {
              "timestamp": "2026-10-22T14:00:00.123Z",
              "code": "VALIDATION_ERROR",
              "message": "Field 'content.attachments': is required for message type CONTACT_ARRAY"
            }
          }
        }
      },
      "SendRefused": {
        "description": "Canal desconectado, ou tipo que o canal não aceita. A mensagem não foi enviada.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SendError"
            },
            "examples": {
              "channelDisconnected": {
                "summary": "CHANNEL_DISCONNECTED",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "BUSINESS_RULE_VIOLATION",
                  "subCode": "CHANNEL_DISCONNECTED",
                  "message": "Channel is disconnected"
                }
              },
              "unsupportedChannel": {
                "summary": "UNSUPPORTED_CHANNEL_TYPE",
                "value": {
                  "timestamp": "2026-10-22T14:00:00.123Z",
                  "code": "BUSINESS_RULE_VIOLATION",
                  "message": "[UNSUPPORTED_CHANNEL_TYPE] O canal META_INSTAGRAM nao suporta mensagens do tipo CONTACT_ARRAY"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "SendContactArrayRequest": {
        "type": "object",
        "required": [
          "recipient",
          "content"
        ],
        "properties": {
          "recipient": {
            "type": "object",
            "required": [
              "identifier"
            ],
            "properties": {
              "identifier": {
                "type": "string",
                "description": "Telefone do destinatário (DDI + DDD + número)",
                "example": "5511999999999"
              }
            }
          },
          "content": {
            "type": "object",
            "required": [
              "type",
              "attachments"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Tipo da mensagem",
                "enum": [
                  "CONTACT_ARRAY"
                ]
              },
              "attachments": {
                "type": "array",
                "description": "Lista de contatos",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Nome do contato. É repassado ao canal, que monta o nome do jeito dele"
                    },
                    "phones": {
                      "type": "array",
                      "description": "Telefones do contato",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "ID da mensagem enviada — hexadecimal de 32 caracteres maiúsculos"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SendError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Data e hora da recusa, em UTC"
          },
          "code": {
            "type": "string",
            "description": "Categoria do erro",
            "example": "BUSINESS_RULE_VIOLATION"
          },
          "subCode": {
            "type": "string",
            "description": "Código do caso. Só vem quando o caso tem um código próprio",
            "example": "CHANNEL_DISCONNECTED"
          },
          "message": {
            "type": "string",
            "description": "Descrição do erro. O texto pode mudar: trate o erro por `code` e `subCode`",
            "example": "Channel is disconnected"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key gerada no painel de Segurança do Omni Z-API"
      }
    }
  }
}
